    end, self)
end

function npcd_dashboard_tab:__CreateStatGroup(stats, stat_group)
    for stat_name, stat_value in pairs(stats) do
        if npcd.FEAT_STAT[stat_name] then
            local stat = xml:InitStatic("npc_panel:specs:stat_group:stat", stat_group)
            stat:SetWndPos(vector2():set(stat:GetWndPos().x  + (i * stat:GetWidth()), stat:GetWndPos().y))
            if i > 0 then
                local vline = xml:InitStatic("npc_panel:specs:stat_group:stat:vline", stat)
                vline:SetWndPos(vector2():set(vline:GetWndPos().x, vline:GetWndPos().y))
            end

            local icon = xml:InitStatic("npc_panel:specs:stat_group:stat:icon", stat)
            icon:SetWndPos(vector2():set(icon:GetWndPos().x, icon:GetWndPos().y))
            icon:InitTexture(npcd.FEAT_STAT[stat_name].icon_dm)

            local label = xml:InitTextWnd("npc_panel:specs:stat_group:stat:value", stat)
            label:SetWndPos(vector2():set(label:GetWndPos().x, label:GetWndPos().y))
            local suffix = self:__GetStatSuffix(stat_name)
            label:SetText(tostring(stat_value) .. suffix)

            i = i + 1
        end
    end
end

function npcd_dashboard_tab:InitNPCPanel(npc_id)
    Printer:Debug(LOG.START, CAT.UI, "Initializing NPC Panel Info - NPC ID: " .. npc_id)
    self.npc_panel.npc_id = npc_id
    self.npc_panel.dialog:Show(true)
    self.npc_panel.info.terminal:SwitchOn()
    npcd_ui_fx.resume_fx(self.npc_panel.info.content.fx.flickering_manager.id)
    self.npc_panel.specs.terminal:SwitchOn()
    self.npc_panel.init = true
    self.npc_panel.info.rank:Show(true)
    local default_tab = TERMINAL_TABS_UTIL.get_default_tab()
    self.npc_panel.specs.terminal:SetActiveTab(default_tab.index)
end

function npcd_dashboard_tab:UpdateNPCPanel(npc_id)
    Printer:Debug(LOG.RUN, CAT.UI, "Updating NPC Panel Info - NPC ID: " .. npc_id)
    self.npc_panel.npc_id = npc_id
    self:UpdateInfoTerminalDisplay(npc_id)
    local default_tab = TERMINAL_TABS_UTIL.get_default_tab()
    self:UpdateSpecsTerminalDisplay(default_tab.name, npc_id)
    self.npc_panel.specs.terminal:SetActiveTab(default_tab.index)
end

function npcd_dashboard_tab:ClearNPCPanel()
    Printer:Debug(LOG.REMOVE, CAT.UI, "Clearing NPC Panel Info")
    self.npc_panel.init = false
    self.npc_panel.npc_id = nil
    self.npc_panel.info.terminal:SwitchOff()
    npcd_ui_fx.stop_fx(self.npc_panel.info.content.fx.flickering_manager.id)
    self:ClearInfoTerminalDisplay()
    self.npc_panel.specs.terminal:SwitchOff()
    self:__ClearSpecsTerminalDisplay()
    self.npc_panel.info.rank:Show(false)
end

function npcd_dashboard_tab:RemoveNPCPanel()
    Printer:Debug(LOG.REMOVE, CAT.UI, "Removing NPC Panel Info")
    self.npc_panel.dialog:Show(false)
    return self:ClearNPCPanel()
end

--------------------------------
--- Details Window
--- ----------------------------

function npcd_dashboard_tab:StartShowingFxDetailsWindow()
    Printer:Debug(LOG.START, CAT.UI, "Starting Details Window Showing FX")
    if UI_DETAILS.dialog:IsShown() then
        Printer:Debug(LOG.WARN, CAT.UI, "Details Window is already shown, skipping FX")
        return
    end
    UI_DETAILS.details_wnd:Show(true)
    UI_DETAILS.background:Show(false)
    UI_DETAILS.scroll:Show(false)
    UI_DETAILS.close_button:Show(false)
    npcd_ui_fx.resume_fx(UI_DETAILS.fx.showing.id)
end

function details_window_showing_complete()
    Printer:Debug(LOG.COMPLETE, CAT.UI, "Details Window Showing FX Complete")
    if npcd_pda_dashboard.UI_DETAILS then  
        npcd_pda_dashboard.UI_DETAILS.scroll:Show(true)
        npcd_pda_dashboard.UI_DETAILS.close_button:Show(true)
    end

    local ui = get_ui()
    if ui then
        -- hide specs terminal content
        ui.npc_panel.specs.content.scroll:Show(false)
    end
end

function npcd_dashboard_tab:InitDetailsWindow()
    -- Details Window
    UI_DETAILS.dialog = xml:InitStatic("details_wnd", self)
    UI_DETAILS.details_wnd = xml:InitStatic("details_wnd:details_frame", UI_DETAILS.dialog)
    UI_DETAILS.background = xml:InitFrame("details_wnd:background", UI_DETAILS.details_wnd)
    UI_DETAILS.scroll = xml:InitScrollView("details_wnd:scroll", UI_DETAILS.details_wnd)
    UI_DETAILS.close_button = xml:Init3tButton("details_wnd:close_button", UI_DETAILS.details_wnd)
    UI_DETAILS.close_button:TextControl():SetFont(GetFontMedium())
    UI_DETAILS.close_button:TextControl():SetText(gc("ui_npcd_details_close_button"))
    self:Register(UI_DETAILS.close_button, "details_window_close_button")
    self:AddCallback("details_window_close_button", ui_events.BUTTON_CLICKED, function ()
        self:On_Details_Window_Close_Button_Clicked()
    end, self)
    UI_DETAILS.dialog:Show(false)
    -- FX: Showing on details window
    local showing = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.SHOWING)
    showing.dialog = UI_DETAILS.background
    showing.speed = 0
    showing.starting_position = 2 -- from bottom
    showing.show_on_position = 300
    -- showing.show_on_position = 120
    showing.on_showing_complete = {"npcd_pda_dashboard", "details_window_showing_complete"}
    npcd_ui_fx.add_fx(showing, "details_window_showing")
    UI_DETAILS.fx = {}
    UI_DETAILS.fx.showing = showing

    -- Hint Details Window
	UI_DETAILS.hint_wnd = xml:InitFrame("hint_wnd:background",UI_DETAILS.dialog)
	UI_DETAILS.hint_wnd:SetAutoDelete(false)
    UI_DETAILS.hint_header = xml:InitStatic("hint_wnd:header",UI_DETAILS.hint_wnd)
    UI_DETAILS.hint_title = xml:InitTextWnd("hint_wnd:header:title",UI_DETAILS.hint_header)
    UI_DETAILS.hint_icon_frame = xml:InitStatic("hint_wnd:header:icon_frame",UI_DETAILS.hint_header)
    UI_DETAILS.hint_icon = xml:InitStatic("hint_wnd:header:icon",UI_DETAILS.hint_header)
    UI_DETAILS.hint_name = xml:InitTextWnd("hint_wnd:header:name",UI_DETAILS.hint_header)
	UI_DETAILS.hint_wnd_text = xml:InitTextWnd("hint_wnd:text",UI_DETAILS.hint_wnd)
    UI_DETAILS.hint_wnd_footer = xml:InitTextWnd("hint_wnd:footer",UI_DETAILS.hint_wnd)
	UI_DETAILS.hint_wnd:Show(false)

end

function npcd_dashboard_tab:On_Details_Window_Close_Button_Clicked()
    Printer:Debug(LOG.START, CAT.UI, "Details Window Close Button Clicked")
    UI_DETAILS.dialog:Show(false)
    self.show_hint = true
    UI_DETAILS.rank = nil
    self.npc_panel.specs.content.scroll:Show(true)
end

function npcd_dashboard_tab:CreateDetailsAttribute(icon_texture, name_text, value_text)
    local attr = xml:InitStatic("details_wnd:attribute", nil)
    
    local name = xml:InitTextWnd("details_wnd:attribute:name", attr)
    name:SetText(name_text)

    local icon = xml:InitStatic("details_wnd:attribute:icon", attr)
    icon:InitTexture(icon_texture)
    
    local value = xml:InitTextWnd("details_wnd:attribute:value", attr)
    value:SetText(value_text)

    return attr
end

function npcd_dashboard_tab:CreateDetailsStat(icon_texture, name_text, value_text)
    local attr = xml:InitStatic("details_wnd:stat", nil)
    
    local icon = xml:InitStatic("details_wnd:stat:icon", attr)
    icon:InitTexture(icon_texture)
    
    local name = xml:InitTextWnd("details_wnd:stat:name", attr)
    name:SetText(name_text)
    
    local value = xml:InitTextWnd("details_wnd:stat:value", attr)
    value:SetText(value_text)
    attr.value = value
    return attr
end

function npcd_dashboard_tab:CreateDetailsFeat(icon_texture, name_text)
    local feat = xml:InitStatic("details_wnd:stat", nil)
    
    local icon = xml:InitStatic("details_wnd:stat:icon", feat)
    icon:InitTexture(icon_texture)
    feat.icon = icon

    local name = xml:InitTextWnd("details_wnd:stat:name", feat)
    name:SetText(name_text)

    return feat
end

local color_grey = GetARGB(255, 100, 100, 100)
local color_red = GetARGB(255, 255, 0, 0)
local color_black = GetARGB(255, 0, 0, 0)

function npcd_dashboard_tab:UpdateFeatStats(feat_uid)
    Printer:Debug(LOG.START, CAT.UI, "Updating Details Window Feat Stats - Rank: " .. tostring(UI_DETAILS.rank or 1))
    local feat = npcd.get_ability_feat(feat_uid)
    if feat then
        for stat_name, stat_el in pairs(UI_DETAILS.stats or {}) do
            local ranked_stats = feat.stats[UI_DETAILS.rank]
            stat_el.value:SetText(tostring(ranked_stats[stat_name] or "0"))
        end
        UI_DETAILS.rank_ui:SetText(gc("ui_npcd_details_ability_rank") .. " [" .. tostring(UI_DETAILS.rank) .. "]")
        local perk_rank = npcdu.get_perk_rank(self.npc_panel and self.npc_panel.npc_id or 0, feat.perk_id) or 1
        Printer:Debug(LOG.INFO, CAT.UI, "Details Window Feat Stats - Perk Rank: " .. tostring(perk_rank))
        if UI_DETAILS.rank == perk_rank then
            UI_DETAILS.rank_ui:SetTextColor(color_black)
        else
            UI_DETAILS.rank_ui:SetTextColor(color_grey)
        end
    end
end

function npcd_dashboard_tab:UpdateDetailsWindow(id, hint_type)
    Printer:Debug(LOG.START, CAT.UI, "Showing Details Window - Type: " .. hint_type .. " ID: " .. id)
    self:StartShowingFxDetailsWindow()
    self.show_hint = false
     
    UI_DETAILS.hints = {}
    if hint_type == HINT_TYPE.FEAT then
        local feat = npcd.get_ability_feat(id)
        
        if feat then
            -- update the scroll content
            UI_DETAILS.scroll:Clear()

            -- update header
            local header = xml:InitStatic("details_wnd:header", nil)
            local title = xml:InitTextWnd("details_wnd:header:title", header)
            title:SetText(gc("ui_npcd_details_ability_header"))           
            local icon_frame = xml:InitStatic("details_wnd:header:icon_frame", header)
            local icon = xml:InitStatic("details_wnd:header:icon_frame:icon", icon_frame)
            icon:InitTexture(feat.icon)
            local name = xml:InitTextWnd("details_wnd:header:name", header)
            name:SetText(gc(feat.name))
            local resource = xml:InitTextWnd("details_wnd:header:resource_label", header)
            resource:SetText(gc("ui_npcd_details_ability_resource") .. "  ---  ")
            local type = xml:InitTextWnd("details_wnd:header:resource_type", header)
            type:SetText( gc("ui_npcd_details_ability_cost_unit_stamina"))
            UI_DETAILS.scroll:AddWindow(header, true)
    
            -- update attributes
            local feat_type = self:CreateDetailsAttribute(
                npcd.FEAT_TYPE_UI[feat.type].icon,
                gc("ui_mcm_st_npcd_feat_type"),
                gc("ui_mcm_lst_" .. feat.type)
            )
            UI_DETAILS.scroll:AddWindow(feat_type, true)

            local feat_mode = self:CreateDetailsAttribute(
                npcd.FEAT_MODE_UI[feat.mode].icon,
                gc("ui_mcm_st_npcd_feat_mode"),
                gc("ui_mcm_lst_" .. feat.mode)
            )
            UI_DETAILS.scroll:AddWindow(feat_mode, true)

            local feat_category = self:CreateDetailsAttribute(
                npcd.FEAT_CATEGORY_UI[feat.category].icon,
                gc("ui_mcm_st_npcd_feat_category"),
                gc("ui_mcm_lst_" .. feat.category)
            )
            UI_DETAILS.scroll:AddWindow(feat_category, true)

            local feat_target = self:CreateDetailsAttribute(
                npcd.FEAT_TARGET_UI[feat.target].icon,
                gc("ui_mcm_st_npcd_feat_target"),
                gc(npcd.FEAT_TARGET_UI[feat.target].desc)
            )
            UI_DETAILS.scroll:AddWindow(feat_target, true)

            -- update description
            UI_DETAILS.description = xml:InitTextWnd("details_wnd:description", nil)
            UI_DETAILS.description:SetText(gc(feat.description))
            UI_DETAILS.description:AdjustHeightToText()
            UI_DETAILS.scroll:AddWindow(UI_DETAILS.description, true)

            -- stats section
            if feat.stats and npcdu.tablelength(feat.stats[1]) > 0 then
                -- Printer:DebugTable("FEAT STATS", feat.stats)
                local ranked_stats = feat.stats[UI_DETAILS.rank or 1]
                local stats_header = xml:InitStatic("details_wnd:section", nil)
                local title = xml:InitTextWnd("details_wnd:section:title", stats_header)
                title:SetText(gc("ui_npcd_details_ability_stats"))
                title:SetFont(GetFontMedium())
                UI_DETAILS.scroll:AddWindow(stats_header, true)
                UI_DETAILS.stats = {}
                for stat_name, stat_value in pairs(ranked_stats or {}) do
                    if npcd.FEAT_STAT[stat_name] then
                        local suffix = self:__GetStatSuffix(stat_name)
                        local stat_attr = self:CreateDetailsStat(
                            npcd.FEAT_STAT[stat_name].icon,
                            gc(npcd.FEAT_STAT[stat_name].name),
                            tostring(stat_value) .. suffix
                        )
                        UI_DETAILS.scroll:AddWindow(stat_attr, true)
                        UI_DETAILS.stats[stat_name] = stat_attr
                    end
                end
                -- stat paging
                local stat_page = xml:InitStatic("details_wnd:stat_page", nil)
                local perk_rank = npcdu.get_perk_rank(self.npc_panel and self.npc_panel.npc_id or 0, feat.perk_id) or 1
                UI_DETAILS.rank = perk_rank
                UI_DETAILS.rank_ui = xml:InitTextWnd("details_wnd:stat_page:rank", stat_page)
                UI_DETAILS.rank_ui:SetText(gc("ui_npcd_details_ability_rank") .. " [" .. tostring(UI_DETAILS.rank) .. "]")
                UI_DETAILS.rank_ui:SetTextColor(color_black)

                local prev_button = xml:Init3tButton("details_wnd:stat_page:prev_button", stat_page)
                local next_button = xml:Init3tButton("details_wnd:stat_page:next_button", stat_page)
                local cb_id = math.random(1000,9999)
                self:Register(prev_button, "details_window_stat_prev_button".. cb_id)
                self:Register(next_button, "details_window_stat_next_button".. cb_id)
                self:AddCallback("details_window_stat_prev_button".. cb_id, ui_events.BUTTON_CLICKED, function ()
                    Printer:Debug(LOG.INFO, CAT.UI, "Details Window Stat Prev Button Clicked")
                    if UI_DETAILS.rank > perk_rank then
                        UI_DETAILS.rank = UI_DETAILS.rank - 1
                        self:UpdateFeatStats(id)
                    end
                    prev_button:Enable(UI_DETAILS.rank > perk_rank)
                    next_button:Enable(UI_DETAILS.rank < #feat.stats)
                end, self)
                self:AddCallback("details_window_stat_next_button".. cb_id, ui_events.BUTTON_CLICKED, function ()
                    Printer:Debug(LOG.INFO, CAT.UI, "Details Window Stat Next Button Clicked")
                    if UI_DETAILS.rank < #feat.stats then
                        UI_DETAILS.rank = UI_DETAILS.rank + 1
                        self:UpdateFeatStats(id)
                    end
                    prev_button:Enable(UI_DETAILS.rank > perk_rank)
                    next_button:Enable(UI_DETAILS.rank < #feat.stats)
                end, self)
                prev_button:Enable(UI_DETAILS.rank > perk_rank)
                next_button:Enable(UI_DETAILS.rank < #feat.stats)
                UI_DETAILS.scroll:AddWindow(stat_page, true)
                -- Printer:DebugTable("FEAT", feat)

                -- capstone section
                if feat.capstone then
                    local capstone_header = xml:InitStatic("details_wnd:section", nil)
                    local capstone_title = xml:InitTextWnd("details_wnd:section:title", capstone_header)
                    capstone_title:SetText(gc("ui_npcd_details_ability_capstone"))
                    capstone_title:SetFont(GetFontMedium())
                    UI_DETAILS.scroll:AddWindow(capstone_header, true)
                    -- update capstone description
                    local capstone = xml:InitTextWnd("details_wnd:description", nil)
                    capstone:SetText(gc(feat.capstone))
                    capstone:AdjustHeightToText()
                    UI_DETAILS.scroll:AddWindow(capstone, true)
                end
            end

            -- source section
            local source_header = xml:InitStatic("details_wnd:section", nil)
            local source_title = xml:InitTextWnd("details_wnd:section:title", source_header)
            source_title:SetText(gc("ui_npcd_details_ability_source"))
            source_title:SetFont(GetFontMedium())
            UI_DETAILS.scroll:AddWindow(source_header, true)

            local perk = npcd.get_perk(feat.perk_id)
            local source_ele = xml:InitStatic("details_wnd:source", nil)
            local icon_frame = xml:InitStatic("details_wnd:source:icon_frame", source_ele)
            local source_icon = xml:InitStatic("details_wnd:source:icon_frame:icon", icon_frame)
            source_icon:InitTexture(perk.icon)
            local hint = { type = HINT_TYPE.PERK, id = perk.id, ele = source_icon }
            table.insert(UI_DETAILS.hints, hint)

            local name = xml:InitTextWnd("details_wnd:source:name", source_ele)
            name:SetText(gc(perk.name))

            local perk_type = xml:InitStatic("details_wnd:source:category", source_ele)
            perk_type:InitTexture(npcd.PERK_TYPE_UI[perk.type].icon)

            UI_DETAILS.scroll:AddWindow(source_ele, true)

            -- close button
            UI_DETAILS.close_button:SetWndPos(vector2():set(UI_DETAILS.close_button:GetWndPos().x, UI_DETAILS.scroll:GetWndPos().y + UI_DETAILS.scroll:GetHeight() + 10))

        end
    end

    if hint_type == HINT_TYPE.PERK then

        local perk = npcd.get_perk(id)

        if perk then
            UI_DETAILS.scroll:Clear()

            -- update header
            local header = xml:InitStatic("details_wnd:header", nil)
            local title = xml:InitTextWnd("details_wnd:header:title", header)
            title:SetText(gc("ui_npcd_details_perk_header"))
            local icon_frame = xml:InitStatic("details_wnd:header:icon_frame", header)
            local icon = xml:InitStatic("details_wnd:header:icon_frame:icon", icon_frame)
            icon:InitTexture(perk.icon)
            local name = xml:InitTextWnd("details_wnd:header:name", header)
            name:SetText(gc(perk.name))
            UI_DETAILS.scroll:AddWindow(header, true)

            -- update attributes
            local perk_type = self:CreateDetailsAttribute(
                npcd.PERK_TYPE_UI[perk.type].icon,
                gc("ui_mcm_st_npcd_perk_type"),
                gc("ui_mcm_lst_" .. perk.type)
            )
            UI_DETAILS.scroll:AddWindow(perk_type, true)
            
            local perk_category = self:CreateDetailsAttribute(
                "ui_npcd_hud_default_icon",
                gc("ui_mcm_st_npcd_perk_category"),
                gc("ui_mcm_lst_" .. perk.category)
            )
            UI_DETAILS.scroll:AddWindow(perk_category, true)

            local perk_chance = self:CreateDetailsAttribute(
                "ui_npcd_hud_stat_chance",
                gc("ui_mcm_st_npcd_perk_chance"),
                tostring(perk.roll_chance) .. " %"
            )
            UI_DETAILS.scroll:AddWindow(perk_chance, true)

            -- update description
            UI_DETAILS.description = xml:InitTextWnd("details_wnd:description", nil)
            UI_DETAILS.description:SetText(gc(perk.description))
            UI_DETAILS.description:AdjustHeightToText()
            UI_DETAILS.scroll:AddWindow(UI_DETAILS.description, true)

            -- feats section
            local feats_header = xml:InitStatic("details_wnd:section", nil)
            local title = xml:InitTextWnd("details_wnd:section:title", feats_header)
            title:SetText(gc("pda_btn_npcd_menu_feats"))
            title:SetFont(GetFontMedium())
            UI_DETAILS.scroll:AddWindow(feats_header, true)

            for _, feat in pairs(perk.feats or {}) do

                local feat_ele = xml:InitStatic("details_wnd:feat", nil)

                local icon_frame = xml:InitStatic("details_wnd:feat:icon_frame", feat_ele)
                local icon = xml:InitStatic("details_wnd:feat:icon_frame:icon", icon_frame)
                icon:InitTexture(feat.icon)

                local name = xml:InitTextWnd("details_wnd:feat:name", feat_ele)
                name:SetText(gc(feat.name))

                local cat_icon = xml:InitStatic("details_wnd:feat:category", feat_ele)
                cat_icon:InitTexture(npcd.FEAT_CATEGORY_UI[feat.category].icon)

                local hint = { type = HINT_TYPE.FEAT, id = feat.uid, ele = icon }
                table.insert(UI_DETAILS.hints, hint)

                UI_DETAILS.scroll:AddWindow(feat_ele, true)
            end

            -- close button
            UI_DETAILS.close_button:SetWndPos(vector2():set(UI_DETAILS.close_button:GetWndPos().x, UI_DETAILS.scroll:GetWndPos().y + UI_DETAILS.scroll:GetHeight() + 10))

        end
    end

    UI_DETAILS.dialog:Show(true)
end

function npcd_dashboard_tab:ShowFeatDetailsWindow(feat_id)
    Printer:Debug(LOG.REMOVE, CAT.UI, "Clearing Details Window")
    self:UpdateDetailsWindow(feat_id, HINT_TYPE.FEAT)
end

function npcd_dashboard_tab:ShowPerkDetailsWindow(perk_id)
    Printer:Debug(LOG.REMOVE, CAT.UI, "Clearing Details Window")
    self:UpdateDetailsWindow(perk_id, HINT_TYPE.PERK)
end

--------------------------------
--- Apps Menu
--- ----------------------------

function npcd_dashboard_tab:InitAppsMenu()
    -- Printer:DebugTable("APP", APP)
    -- Printer:DebugTable("MENU", MENU)
    for _, app in pairs(APP) do
        -- e.g. UI_MENU["profiles"] = {}        
        UI_MENU[app] = {}
        local button_spacing = 10
        local menus = APP_MENU[app] or {}
        local menu_count = #menus
        
        if menu_count > 0 then
            -- Create all buttons first to get their heights
            local buttons = {}
            for i, menu in ipairs(menus) do
                UI_MENU[app][menu] = {}
                UI_MENU[app][menu].button = xml:Init3tButton(app .. "_panel:menu_bar:button", UI_APP[app].dialog)
                UI_MENU[app][menu].button:TextControl():SetText(gc(STRING_PREFIX .. "menu_".. menu))
                self:Register(UI_MENU[app][menu].button, app .. "_menu_button_" .. menu)
                self:AddCallback(app .. "_menu_button_" .. menu, ui_events.BUTTON_CLICKED, function ()
                    self:On_Menu_Button_Clicked(app, menu)
                end, self)
                table.insert(buttons, {menu = menu, button = UI_MENU[app][menu].button})
            end
            
            -- Calculate vertical centering for menu buttons
            -- Use the panel dialog height as reference for centering
            local panel_height = UI_APP[app].dialog:GetHeight()
            local middle = panel_height / 2
            local first_button_height = buttons[1].button:GetHeight()
            local total_height = (menu_count * first_button_height) + ((menu_count - 1) * button_spacing)
            local start_y = middle - (total_height / 2)
            
            -- Position buttons vertically centered with proper spacing
            for i, button_data in ipairs(buttons) do
                local button_height = button_data.button:GetHeight()
                local y_pos = start_y + ((i - 1) * (button_height + button_spacing))
                button_data.button:SetWndPos(vector2():set(button_data.button:GetWndPos().x, y_pos))
            end
        end
    end
end

function npcd_dashboard_tab:On_Menu_Button_Clicked(app, menu)
    Printer:Debug(LOG.START, CAT.UI, "Menu Button Clicked - App: " .. app .. " Menu: " .. menu)
    self:ActivateAppMenu(app, menu)
end


function npcd_dashboard_tab:InitPerksBrowser()
    Printer:Debug(LOG.START, CAT.UI, "Initializing Perks Browser")
    self.perks_browser = {}
    self.perks_browser.dialog = xml:InitStatic("perks_browser", self)
    self.perks_browser.dialog:Show(false)
    local browser_content = xml:InitStatic("perks_browser:terminal_display:content", nil)
    self.perks_browser.content = {}
    self.perks_browser.content.dialog = browser_content
    self.perks_browser.frame = xml:InitStatic("perks_browser:frame", self.perks_browser.dialog)
    self.perks_browser.frame:Show(true)

    -- perks terminal
    -- ------------------------------
    local perks_terminal = npcd_ui_fx.get_sfx_config(npcd_ui_fx.SFX.VIDEO_TERMINAL, "npc_perks_terminal")
    perks_terminal.name = "NPC Perks Terminal"
    perks_terminal.group = "npc_perks_fx"
    perks_terminal.xml_init = "npcd_pda_dashboard.xml"
    perks_terminal.parent = self.perks_browser.dialog
    perks_terminal.display = "perks_browser:terminal_display"
    perks_terminal.glass = "perks_browser:terminal_display:terminal_glass"
    perks_terminal.display_showing = 0 -- middle
    perks_terminal.speed = 0
    perks_terminal.start_timer = 0
    perks_terminal.content = self.perks_browser.content.dialog
    perks_terminal.content_showing = 1 -- none
    perks_terminal.on_content_displayed_callback = { functor = self.UpdatePerksBrowser, self = self}

    -- instantiate the terminal
    -- ------------------------------
    self.perks_browser.terminal = npcd_ui_fx.SFXVideoTerminal_Create(perks_terminal, self)

    -- perk detail window
    self:InitPerkBrowserContent()
end


function npcd_dashboard_tab:StartPerksBrowser(app_name, menu_name)
    Printer:Debug(LOG.RUN, CAT.UI, "Start Perks Browser - App: " .. app_name .. " Menu: " .. menu_name)
    self.perks_browser.dialog:Show(true)
    if not self.perks_browser.terminal:IsOn() then
        self.perks_browser.terminal:SwitchOn()
    else
        self:ClearPerkDetails()
        self:UpdatePerksBrowser(menu_name)
    end
end

function npcd_dashboard_tab:ClosePerksBrowser()
    Printer:Debug(LOG.REMOVE, CAT.UI, "Closing Perks Browser")
    self:ClearPerkDetails()
    self.perks_browser.terminal:SwitchOff()
    self.perks_browser.dialog:Show(false)
    self.perks_browser.content.perks_scroller.scroll:Show(false)
    self.perks_browser.perk_detail.dialog:Show(false)
end

function npcd_dashboard_tab:UpdatePerksBrowser(menu_name)
    Printer:Debug(LOG.RUN, CAT.UI, "Updating Perks Terminal Display")
    if not menu_name then
        menu_name = UI_APP[APP.PERKS].default_menu
    end
    self.perks_browser.active_menu = menu_name
    self.perks_browser.frame:Show(false)
    self.perks_browser.frame = xml:InitStatic("perks_browser:frame", self.perks_browser.dialog)
    self.perks_browser.frame:Show(true)

    self.perks_browser.content.perks_scroller.scroll:Show(true)
    self.perks_browser.perk_detail.dialog:Show(true)
    self:UpdatePerksScroller(menu_name)
end

function npcd_dashboard_tab:UpdatePerksScroller(menu_name)
    Printer:Debug(LOG.RUN, CAT.UI, "Updating Perks Scroller")
    self:ResetPerksScroller()
    local scroll = self.perks_browser.content.perks_scroller.scroll

    local perks_list = nil
    if menu_name == MENU.ALL then
        Printer:Debug(LOG.INFO, CAT.UI, "Loading All Perks into Scroller")
        perks_list = npcd.get_perks()
    elseif menu_name == MENU.LEARNED then
        Printer:Debug(LOG.INFO, CAT.UI, "Loading Learned Perks into Scroller")
        perks_list = npcd.get_learned_perks()
    elseif menu_name == MENU.DISCOVERED then
        Printer:Debug(LOG.INFO, CAT.UI, "Loading Discovered Perks into Scroller")
        perks_list = npcd.get_discovered_perks()
    else
        Printer:Debug(LOG.INFO, CAT.UI, "Loading Perks by Category into Scroller - Category: " .. menu_name)
        perks_list = npcd.get_perks()
    end

    if self.perks_browser.category_filter and self.perks_browser.category_filter ~= MENU.ALL then
        Printer:Debug(LOG.INFO, CAT.UI, "Filtering Perks by Category - Category: " .. self.perks_browser.category_filter)
        local filtered_perks = {}
        for perk_id, perk in pairs(perks_list) do
            if perk.category == self.perks_browser.category_filter then
                filtered_perks[perk_id] = perk
            end
        end
        perks_list = filtered_perks
        Printer:Debug(LOG.INFO, CAT.UI, "Filtered Perks Count: " .. tostring(#perks_list))
    end

    local search_filter = self:GetSearchFilter()
    Printer:Debug(LOG.INFO, CAT.UI, " search_filter: " .. tostring(search_filter))
    if search_filter and search_filter ~= "" then
        Printer:Debug(LOG.INFO, CAT.UI, "Filtering Perks by Search Text - Filter: " .. search_filter)
        local filtered_perks = {}
        local filter_text = string.lower(search_filter)
        for perk_id, perk in pairs(perks_list) do
            if string.find(string.lower(perk.name), filter_text) then
                filtered_perks[perk_id] = perk
            end
        end
        perks_list = filtered_perks
        Printer:Debug(LOG.INFO, CAT.UI, "Filtered Perks Count: " .. tostring(#perks_list))
    end
    -- filter perks by search text
    for index, perk in pairs(perks_list) do
        Printer:Debug(LOG.INFO, CAT.UI, "Adding Perk to Scroller - Perk: " .. perk.name)
        self.perks_browser.content.perks_scroller.row[index] = {}
        self.perks_browser.content.perks_scroller.row[index].button = xml:Init3tButton("perks_browser:scroller:item_button", nil)
        self.perks_browser.content.perks_scroller.row[index].button:TextControl():SetText(gc(perk.name))
        self.perks_browser.content.perks_scroller.row[index].button:TextControl():SetFont(GetFontSmall())
        scroll:AddWindow(self.perks_browser.content.perks_scroller.row[index].button, true)
        local id = "npcd_perk_button_" .. index -- .. "_" .. math.random(1000,9999)
        self:Register(self.perks_browser.content.perks_scroller.row[index].button, id)
        self:AddCallback(id, ui_events.BUTTON_CLICKED, function ()
            Printer:Debug(LOG.INFO, CAT.UI, "NPC Perk Button Clicked - Perk: " .. perk.name .. " Index: " .. index .. " perk_id: " .. perk.id)
            local selected = self.perks_browser.content.perks_scroller.selected
            if selected and self.perks_browser.content.perks_scroller.row[selected] then
                self.perks_browser.content.perks_scroller.row[selected].button:Enable(true)
            end
            self.perks_browser.content.perks_scroller.selected = index
            self.perks_browser.content.perks_scroller.row[index].button:Enable(false)
            self:UpdatePerkDetails(perk.id)
        end, self)
        Printer:Debug(LOG.ADD, CAT.UI, "Added Perk to Scroller - Perk: " .. perk.name .. " perk_id: " .. perk.id .. " Button ID: " .. id .. " Index: " .. index)
    end
    -- reset feat details window bar
    local stateless = true
    self:SetFeatDetailsWindowState(UI_FEAT_DETAILS_WINDOW_STATE.HIDDEN, stateless)
    UI_FEAT_DETAILS.toggle_button:TextControl():SetText("")
    UI_FEAT_DETAILS.toggle_button:Show(false)

    self:CloseSearchBox()
end

function npcd_dashboard_tab:ResetPerksScroller()
    Printer:Debug(LOG.RUN, CAT.UI, "Resetting Perks Scroller")
    self.perks_browser.content.perks_scroller.scroll:Clear()
    self.perks_browser.content.perks_scroller.selected = nil
end

function npcd_dashboard_tab:RemovePerksBrowser()
    Printer:Debug(LOG.REMOVE, CAT.UI, "Removing Perks Browser")
    self.perks_browser.dialog:Show(false)
    return self:ResetPerksScroller()
end

--------------------------------
-- Perk Details Window
-- -----------------------------

UI_FEAT_DETAILS_WINDOW_STATE = {
    MAXIMIZED = 1,
    MINIMIZED = 2,
    CLOSED = 3,
    HIDDEN = 4
}
UI_FEAT_DETAILS = {}


function feat_details_window_showing_complete()
    Printer:Debug(LOG.COMPLETE, CAT.UI, "Feat Details Window Showing FX Complete")
    if npcd_pda_dashboard.UI_FEAT_DETAILS then  
        npcd_pda_dashboard.UI_FEAT_DETAILS.scroll:Show(true)
        npcd_pda_dashboard.UI_FEAT_DETAILS.close_button:Show(true)
    end

end

function npcd_dashboard_tab:InitPerkBrowserContent()
    Printer:Debug(LOG.START, CAT.UI, "Initializing Perk Details Window")


    -- pekrs scroller
    local scroller = xml:InitStatic("perks_browser:scroller", self.perks_browser.content.dialog)
    self.perks_browser.content.perks_scroller = scroller
    self.perks_browser.content.perks_scroller.scroll = xml:InitScrollView("perks_browser:scroller:scroll", scroller)
    self.perks_browser.content.perks_scroller.row = {}
    self.perks_browser.content.perks_scroller.scroll:Show(false)

    -- perks search button
    self.perks_browser.content.perks_scroller.search = xml:Init3tButton("perks_browser:search_button", self.perks_browser.content.dialog)
    self.perks_browser.content.perks_scroller.search:TextControl():SetText(game.translate_string("ui_npcd_details_perk_search"))
    self:Register(self.perks_browser.content.perks_scroller.search, "perks_browser_search_button")
    self:AddCallback("perks_browser_search_button", ui_events.BUTTON_CLICKED, function ()
        self:InitSearchBox()
    end, self)

    -- pekrs categories scroller
    self.perks_browser.content.perks_scroller.categories_scroll = xml:InitScrollView("perks_browser:scroller:scroll", scroller)
    self.perks_browser.content.perks_scroller.categories_scroll.row = {}
    local categories  = npcd.get_perk_categories_ui_list() or {}
    -- Printer:DebugTable("PERK CATEGORIES", categories)
    for i, category in ipairs(categories) do
        Printer:Debug(LOG.INFO, CAT.UI, "Adding Perk Category to Categories Scroller - Category: " .. category.name)
        self.perks_browser.content.perks_scroller.categories_scroll.row[i] = {}
        self.perks_browser.content.perks_scroller.categories_scroll.row[i].button = xml:Init3tButton("perks_browser:scroller:category_button", nil)
        self.perks_browser.content.perks_scroller.categories_scroll.row[i].button:TextControl():SetText(gc("ui_mcm_lst_" .. category.name))
        self.perks_browser.content.perks_scroller.categories_scroll.row[i].button:TextControl():SetFont(GetFontSmall())
        self.perks_browser.content.perks_scroller.categories_scroll:AddWindow(self.perks_browser.content.perks_scroller.categories_scroll.row[i].button, true)
        local id = "npcd_perk_category_button_" .. category.name -- .. "_" .. math.random(1000,9999)
        self:Register(self.perks_browser.content.perks_scroller.categories_scroll.row[i].button, id)
        self:AddCallback(id, ui_events.BUTTON_CLICKED, function ()
            Printer:Debug(LOG.INFO, CAT.UI, "NPC Perk Category Button Clicked - Category: " .. category.name .. " Index: " .. i)
            self.perks_browser.category_filter = category.name
            self.perks_browser.content.perks_scroller.categories_scroll:Show(false)
            self.perks_browser.content.perks_scroller.scroll:Show(true)
            self.perks_browser.content.perks_scroller.categories:TextControl():SetText(self.perks_browser.content.perks_scroller.categories_scroll.row[i].button:TextControl():GetText())
            self.perks_browser.content.perks_scroller.categories:TextControl():SetTextColor(c_blue)
            self.perks_browser.content.perks_scroller.categories:InitTexture("ui_npcd_pda_perks_category_filter_active")
            self:UpdatePerksScroller(self.perks_browser.active_menu)
        end, self)
        Printer:Debug(LOG.ADD, CAT.UI, "Added Perk Category to Categories Scroller - Category: " .. category.name .. " Button ID: " .. id .. " Index: " .. i)
    end
    -- add all button to categories scroller
    local all_button_index = #npcd.get_perk_categories_ui_list() + 1
    self.perks_browser.content.perks_scroller.categories_scroll.row[all_button_index] = {}
    self.perks_browser.content.perks_scroller.categories_scroll.row[all_button_index].button = xml:Init3tButton("perks_browser:scroller:category_button", nil)
    self.perks_browser.content.perks_scroller.categories_scroll.row[all_button_index].button:TextControl():SetText(gc("ui_mcm_lst_st_npcd_perk_category_all"))
    self.perks_browser.content.perks_scroller.categories_scroll.row[all_button_index].button:TextControl():SetFont(GetFontSmall())
    self.perks_browser.content.perks_scroller.categories_scroll:AddWindow(self.perks_browser.content.perks_scroller.categories_scroll.row[all_button_index].button, true)
    local all_id = "npcd_perk_category_button_all" -- .. "_" .. math.random(1000,9999)
    self:Register(self.perks_browser.content.perks_scroller.categories_scroll.row[all_button_index].button, all_id)
    self:AddCallback(all_id, ui_events.BUTTON_CLICKED, function ()
        Printer:Debug(LOG.INFO, CAT.UI, "NPC Perk Category All Button Clicked - Index: " .. all_button_index)
        self.perks_browser.category_filter = MENU.ALL
        self.perks_browser.content.perks_scroller.categories_scroll:Show(false)
        self.perks_browser.content.perks_scroller.scroll:Show(true)
        self.perks_browser.content.perks_scroller.categories:TextControl():SetText(gc("ui_npcd_details_perk_filter"))
        self.perks_browser.content.perks_scroller.categories:TextControl():SetTextColor(c_grey)
        self.perks_browser.content.perks_scroller.categories:InitTexture("ui_npcd_pda_perks_category_filter")
        self:UpdatePerksScroller(self.perks_browser.active_menu)
    end, self)

    self.perks_browser.content.perks_scroller.categories_scroll:Show(false)

    -- perks categories button
    self.perks_browser.content.perks_scroller.categories = xml:Init3tButton("perks_browser:categories_button", self.perks_browser.content.dialog)
    self.perks_browser.content.perks_scroller.categories:TextControl():SetText(gc("ui_npcd_details_perk_filter"))
    self:Register(self.perks_browser.content.perks_scroller.categories, "perks_browser_categories_button")
    self:AddCallback("perks_browser_categories_button", ui_events.BUTTON_CLICKED, function ()
        local is_showing = self.perks_browser.content.perks_scroller.categories_scroll:IsShown()
        Printer:Debug(LOG.INFO, CAT.UI, "Perks Browser Categories Button Clicked - Currently Showing: " .. tostring(is_showing))
        if is_showing then
            self.perks_browser.content.perks_scroller.categories_scroll:Show(false)
            self.perks_browser.content.perks_scroller.scroll:Show(true)
        else
            self.perks_browser.content.perks_scroller.categories_scroll:Show(true)
            self.perks_browser.content.perks_scroller.scroll:Show(false)
        end
    end, self)


    -- perk detail window
    self.perks_browser.perk_detail = {}
    self.perks_browser.perk_detail.dialog = xml:InitStatic("perks_browser:perk_detail", self.perks_browser.content.dialog)
    
    -- perk card
    self.perks_browser.perk_detail.perk_card = {}
    local perk_card = xml:InitStatic("perks_browser:perk_detail:perk_card", self.perks_browser.perk_detail.dialog)
    self.perks_browser.perk_detail.perk_card.dialog = perk_card
    local icon_frame = xml:InitStatic("perks_browser:perk_detail:perk_card:icon_frame", perk_card)
    self.perks_browser.perk_detail.perk_card.icon = xml:InitStatic("perks_browser:perk_detail:perk_card:icon_frame:icon", icon_frame)
    self.perks_browser.perk_detail.perk_card.name = xml:InitTextWnd("perks_browser:perk_detail:perk_card:name", perk_card)
    self.perks_browser.perk_detail.perk_card.type = xml:InitTextWnd("perks_browser:perk_detail:perk_card:type", perk_card)

    -- characteristics
    local characteristics = xml:InitStatic("perks_browser:perk_detail:characteristics", self.perks_browser.perk_detail.dialog)
    local header = xml:InitTextWnd("perks_browser:perk_detail:characteristics:header", characteristics)
    header:SetText(gc("ui_npcd_details_perk_characteristics_header"))

    local char_group = xml:InitStatic("perks_browser:perk_detail:characteristics:char_group", characteristics)
    
    local type_cap = xml:InitTextWnd("perks_browser:perk_detail:characteristics:char_group:type_cap", char_group)
    type_cap:SetText(gc("ui_npcd_details_perk_characteristics_type"))
    self.perks_browser.perk_detail.type = xml:InitTextWnd("perks_browser:perk_detail:characteristics:char_group:type", char_group)

    local category_cap = xml:InitTextWnd("perks_browser:perk_detail:characteristics:char_group:category_cap", char_group)
    category_cap:SetText(gc("ui_npcd_details_perk_characteristics_category"))
    self.perks_browser.perk_detail.category = xml:InitTextWnd("perks_browser:perk_detail:characteristics:char_group:category", char_group)

    local chance_cap = xml:InitTextWnd("perks_browser:perk_detail:characteristics:char_group:chance_cap", char_group)
    chance_cap:SetText(gc("ui_npcd_details_perk_characteristics_chance"))
    self.perks_browser.perk_detail.chance = xml:InitTextWnd("perks_browser:perk_detail:characteristics:char_group:chance", char_group)
    self.perks_browser.perk_detail.char_group = char_group

    local faction_cap = xml:InitTextWnd("perks_browser:perk_detail:characteristics:char_group:faction_cap", char_group)
    faction_cap:SetText(gc("ui_npcd_details_perk_characteristics_faction"))
    self.perks_browser.perk_detail.faction = xml:InitTextWnd("perks_browser:perk_detail:characteristics:char_group:faction", char_group)
    self.perks_browser.perk_detail.char_group = char_group

    local requirements_cap = xml:InitTextWnd("perks_browser:perk_detail:characteristics:char_group:requirements_cap", char_group)
    requirements_cap:SetText(gc("ui_npcd_details_perk_characteristics_requirements"))
    self.perks_browser.perk_detail.requirements = xml:InitTextWnd("perks_browser:perk_detail:characteristics:char_group:requirements", char_group)
    self.perks_browser.perk_detail.char_group = char_group

    -- description
    local details_frame = xml:InitStatic("perks_browser:perk_detail:details_frame", self.perks_browser.perk_detail.dialog)
    self.perks_browser.perk_detail.details_frame = details_frame
    local description = xml:InitStatic("perks_browser:perk_detail:details_frame:perk_description", details_frame)
    local scroll = xml:InitScrollView("perks_browser:perk_detail:details_frame:perk_description:scroll", description)
    self.perks_browser.perk_detail.description_scroll = scroll

    -- feats
    local feats = xml:InitStatic("perks_browser:perk_detail:feats", self.perks_browser.perk_detail.dialog)
    local feats_header = xml:InitTextWnd("perks_browser:perk_detail:feats:header", feats)
    feats_header:SetText(gc("ui_npcd_details_perk_feats_header"))
    local feats_frame = xml:InitStatic("perks_browser:perk_detail:feats:frame", feats)
    local feats_scroll = xml:InitScrollView("perks_browser:perk_detail:feats:frame:scroll", feats_frame)
    self.perks_browser.perk_detail.feats_scroller = {} 
    self.perks_browser.perk_detail.feats_scroller.scroll = feats_scroll
    self.perks_browser.perk_detail.feats_scroller.selected = nil
    self.perks_browser.perk_detail.feats_scroller.row = {}

    -- feat details

    -- Details Window
    UI_FEAT_DETAILS = {}
    UI_FEAT_DETAILS.dialog = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details", details_frame)
    UI_FEAT_DETAILS.feat_details = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details:frame", UI_FEAT_DETAILS.dialog)
    UI_FEAT_DETAILS.background = xml:InitFrame("perks_browser:perk_detail:details_frame:feat_details:background", UI_FEAT_DETAILS.feat_details)
    UI_FEAT_DETAILS.scroll = xml:InitScrollView("perks_browser:perk_detail:details_frame:feat_details:scroll", UI_FEAT_DETAILS.feat_details)
    UI_FEAT_DETAILS.scroll:Show(false)
    UI_FEAT_DETAILS.toggle_button = xml:Init3tButton("perks_browser:perk_detail:details_frame:feat_details:toggle_button", UI_FEAT_DETAILS.feat_details)
    UI_FEAT_DETAILS.toggle_button:TextControl():SetFont(GetFontMedium())
    UI_FEAT_DETAILS.toggle_button:TextControl():SetText("")
    -- self:Register(UI_FEAT_DETAILS.toggle_button, "feat_details_window_toggle_button")
    -- self:AddCallback("feat_details_window_toggle_button", ui_events.BUTTON_CLICKED, function ()
    --     Printer:Debug(LOG.INFO, CAT.UI, "Feat Details Window Toggle Button Clicked")
    --     self:SetFeatDetailsWindowState(UI_FEAT_DETAILS_WINDOW_STATE.MAXIMIZED)
    -- end, self)
    UI_FEAT_DETAILS.toggle_button:Enable(false)
    UI_FEAT_DETAILS.minimize_button = xml:Init3tButton("perks_browser:perk_detail:details_frame:feat_details:minimize_button", UI_FEAT_DETAILS.dialog)
    self:Register(UI_FEAT_DETAILS.minimize_button, "feat_details_window_minimize_button")
    self:AddCallback("feat_details_window_minimize_button", ui_events.BUTTON_CLICKED, function ()
        Printer:Debug(LOG.INFO, CAT.UI, "Feat Details Window Minimize Button Clicked")
        self:SetFeatDetailsWindowState(UI_FEAT_DETAILS_WINDOW_STATE.MINIMIZED)
    end, self)

    UI_FEAT_DETAILS.maximize_button = xml:Init3tButton("perks_browser:perk_detail:details_frame:feat_details:maximize_button", UI_FEAT_DETAILS.dialog)
    self:Register(UI_FEAT_DETAILS.maximize_button, "feat_details_window_maximize_button")
    self:AddCallback("feat_details_window_maximize_button", ui_events.BUTTON_CLICKED, function ()
        Printer:Debug(LOG.INFO, CAT.UI, "Feat Details Window Maximize Button Clicked")
        self:SetFeatDetailsWindowState(UI_FEAT_DETAILS_WINDOW_STATE.MAXIMIZED)
    end, self)

    UI_FEAT_DETAILS.close_button = xml:Init3tButton("perks_browser:perk_detail:details_frame:feat_details:close_button", UI_FEAT_DETAILS.dialog)
    self:Register(UI_FEAT_DETAILS.close_button, "feat_details_window_close_button")
    self:AddCallback("feat_details_window_close_button", ui_events.BUTTON_CLICKED, function ()
        Printer:Debug(LOG.INFO, CAT.UI, "Feat Details Window Close Button Clicked")
        self:SetFeatDetailsWindowState(UI_FEAT_DETAILS_WINDOW_STATE.CLOSED)
    end, self)


    UI_FEAT_DETAILS.dialog:Show(false)
    -- FX: Showing on details window
    local showing = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.SHOWING)
    showing.dialog = UI_FEAT_DETAILS.background
    showing.speed = 0
    showing.starting_position = 2 -- from bottom
    -- showing.show_on_position = 300
    showing.show_on_position = 100
    showing.on_showing_complete = {"npcd_pda_dashboard", "feat_details_window_showing_complete"}
    npcd_ui_fx.add_fx(showing, "feat_details_window_showing")
    UI_FEAT_DETAILS.fx = {}
    UI_FEAT_DETAILS.fx.showing = showing

    self.perks_browser.perk_detail.dialog:Show(false)
end

function npcd_dashboard_tab:ClearPerkDetails()
    Printer:Debug(LOG.REMOVE, CAT.UI, "Clearing Perk Details")
    self.perks_browser.perk_detail.perk_card.icon:Show(false)
    self.perks_browser.perk_detail.perk_card.name:SetText("")
    self.perks_browser.perk_detail.perk_card.type:SetText("")
    self.perks_browser.perk_detail.type:SetText("")
    self.perks_browser.perk_detail.category:SetText("")
    self.perks_browser.perk_detail.chance:SetText("")
    self.perks_browser.perk_detail.faction:SetText("")
    self.perks_browser.perk_detail.requirements:SetText("")
    self.perks_browser.perk_detail.description_scroll:Clear()
    self.perks_browser.perk_detail.feats_scroller.scroll:Clear()
end

function npcd_dashboard_tab:SetFeatDetailsWindowState(state, stateless)
    Printer:Debug(LOG.RUN, CAT.UI, "Setting Feat Details Window State to: " .. tostring(state))
    if not stateless then
        Printer:Debug(LOG.ADD, CAT.UI, "Updating Feat Details Window State Variable to: " .. tostring(state))
        UI_FEAT_DETAILS.state = state
    end
    Printer:Debug(LOG.INFO, CAT.UI, "Current Feat Details Window State Variable: " .. tostring(UI_FEAT_DETAILS.state))
    UI_FEAT_DETAILS.dialog:Show(true)
    UI_FEAT_DETAILS.scroll:Show(true)
    UI_FEAT_DETAILS.toggle_button:Show(true)
    UI_FEAT_DETAILS.hidden_state = false
    -- reference position and size
    local window_x = UI_FEAT_DETAILS.dialog:GetWndPos().x
    local window_y = self.perks_browser.perk_detail.details_frame:GetWndPos().y
    local window_width = UI_FEAT_DETAILS.dialog:GetWidth()
    local window_height = self.perks_browser.perk_detail.details_frame:GetHeight() - 5

    if state == UI_FEAT_DETAILS_WINDOW_STATE.MAXIMIZED then
        Printer:Debug(LOG.INFO, CAT.UI, "Maximizing Feat Details Window")
        UI_FEAT_DETAILS.dialog:SetWndPos(vector2():set(window_x, window_y))
        UI_FEAT_DETAILS.dialog:SetWndSize(vector2():set(window_width, window_height))
        UI_FEAT_DETAILS.feat_details:SetWndSize(vector2():set(window_width, window_height))
        UI_FEAT_DETAILS.background:SetWndSize(vector2():set(window_width, window_height))
        UI_FEAT_DETAILS.scroll:SetWndSize(vector2():set(UI_FEAT_DETAILS.scroll:GetWidth(), window_height - 5))
        -- buttons
        UI_FEAT_DETAILS.maximize_button:Show(false)
        UI_FEAT_DETAILS.minimize_button:Show(true)
        UI_FEAT_DETAILS.close_button:Show(true)
        self:UpdateFeatDetailsWindow(self.perks_browser.perk_detail.perk_id, self.perks_browser.perk_detail.feat_id)
    elseif state == UI_FEAT_DETAILS_WINDOW_STATE.MINIMIZED then
        Printer:Debug(LOG.INFO, CAT.UI, "Minimizing Feat Details Window")
        local offset = window_height / 3
        UI_FEAT_DETAILS.dialog:SetWndPos(vector2():set(window_x, window_height / 3 - 30))
        UI_FEAT_DETAILS.dialog:SetWndSize(vector2():set(window_width, window_height / 3 + 25 + offset))
        UI_FEAT_DETAILS.feat_details:SetWndSize(vector2():set(window_width, window_height / 3 + 25 + offset))
        UI_FEAT_DETAILS.background:SetWndSize(vector2():set(window_width, window_height / 3 + 25 + offset))
        UI_FEAT_DETAILS.scroll:SetWndSize(vector2():set(UI_FEAT_DETAILS.scroll:GetWidth(), window_height / 3 + 25 + offset - 5))
        self.perks_browser.perk_detail.description_scroll:SetWndSize(vector2():set(self.perks_browser.perk_detail.description_scroll:GetWidth(), offset -30))
        self:UpdatePerkDescription()
        -- buttons
        UI_FEAT_DETAILS.maximize_button:Show(true)
        UI_FEAT_DETAILS.minimize_button:Show(false)
        UI_FEAT_DETAILS.close_button:Show(true)
        self:UpdateFeatDetailsWindow(self.perks_browser.perk_detail.perk_id, self.perks_browser.perk_detail.feat_id)
    elseif state == UI_FEAT_DETAILS_WINDOW_STATE.CLOSED then
        Printer:Debug(LOG.INFO, CAT.UI, "Closing Feat Details Window")
        UI_FEAT_DETAILS.dialog:SetWndPos(vector2():set(window_x, self.perks_browser.perk_detail.dialog:GetWndPos().y + self.perks_browser.perk_detail.dialog:GetHeight() - 70))
        UI_FEAT_DETAILS.dialog:SetWndSize(vector2():set(window_width, 30))
        UI_FEAT_DETAILS.feat_details:SetWndSize(vector2():set(window_width, 30))
        UI_FEAT_DETAILS.background:SetWndSize(vector2():set(window_width, 30))
        UI_FEAT_DETAILS.scroll:SetWndSize(vector2():set(UI_FEAT_DETAILS.scroll:GetWidth(), 30))
        self.perks_browser.perk_detail.description_scroll:SetWndSize(vector2():set(self.perks_browser.perk_detail.description_scroll:GetWidth(), window_height))
        self:UpdatePerkDescription()
        -- buttons
        UI_FEAT_DETAILS.maximize_button:Show(false)
        UI_FEAT_DETAILS.minimize_button:Show(true)
        UI_FEAT_DETAILS.close_button:Show(true)
        UI_FEAT_DETAILS.scroll:Show(false)
    elseif state == UI_FEAT_DETAILS_WINDOW_STATE.HIDDEN then
        self.perks_browser.perk_detail.description_scroll:SetWndSize(vector2():set(self.perks_browser.perk_detail.description_scroll:GetWidth(), window_height))
        self:UpdatePerkDescription()
        UI_FEAT_DETAILS.hidden_state = true
        UI_FEAT_DETAILS.dialog:Show(false)
        UI_FEAT_DETAILS.toggle_button:Show(false)
        UI_FEAT_DETAILS.maximize_button:Show(false)
        UI_FEAT_DETAILS.minimize_button:Show(false)
        UI_FEAT_DETAILS.close_button:Show(false)
        UI_FEAT_DETAILS.scroll:Show(false)
    end
end

function npcd_dashboard_tab:UpdateFeatsScroller()
    Printer:Debug(LOG.RUN, CAT.UI, "Updating Perk Feats Scroller")
    self.perks_browser.perk_detail.feats_scroller.scroll:Clear()
    self.perks_browser.perk_detail.feats_scroller.selected = nil

    local perk_id = self.perks_browser.content.perks_scroller.selected or nil
    if not perk_id then
        Printer:Debug(LOG.WARN, CAT.UI, "No Perk Selected for Feats Scroller Update")
        return
    end 

    local perk = npcd.get_perk(perk_id)
    if not perk then
        Printer:Debug(LOG.WARN, CAT.UI, "Invalid Perk ID for Feats Scroller Update: " .. tostring(perk_id))
        return
    end

    -- reset feat details window bar
    local stateless = true
    self:SetFeatDetailsWindowState(UI_FEAT_DETAILS_WINDOW_STATE.HIDDEN, stateless)
    UI_FEAT_DETAILS.toggle_button:TextControl():SetText("")
    -- UI_FEAT_DETAILS.state = nil
    for index, feat in pairs(perk.feats or {}) do
        Printer:Debug(LOG.INFO, CAT.UI, "Adding Feat to Scroller - Feat: " .. feat.name)
        self.perks_browser.perk_detail.feats_scroller.row[index] = {}
        self.perks_browser.perk_detail.feats_scroller.row[index].button = xml:Init3tButton("perks_browser:perk_detail:feats:frame:item_button", nil)
        self.perks_browser.perk_detail.feats_scroller.row[index].button:TextControl():SetText(gc(feat.name))
        self.perks_browser.perk_detail.feats_scroller.row[index].button:TextControl():SetFont(GetFontSmall())
        self.perks_browser.perk_detail.feats_scroller.scroll:AddWindow(self.perks_browser.perk_detail.feats_scroller.row[index].button, true)
        local id = "npcd_feat_button_" .. index -- .. "_" .. math.random(1000,9999)
        self:Register(self.perks_browser.perk_detail.feats_scroller.row[index].button, id)
        self:AddCallback(id, ui_events.BUTTON_CLICKED, function ()
            Printer:Debug(LOG.INFO, CAT.UI, "NPC Feat Button Clicked - Feat: " .. feat.name .. " Index: " .. index)
            local selected = self.perks_browser.perk_detail.feats_scroller.selected
            if selected and self.perks_browser.perk_detail.feats_scroller.row[selected] then
                self.perks_browser.perk_detail.feats_scroller.row[selected].button:Enable(true)
            end
            self.perks_browser.perk_detail.feats_scroller.selected = index
            self.perks_browser.perk_detail.feats_scroller.row[index].button:Enable(false)
            self:UpdateFeatDetailsWindow(self.perks_browser.perk_detail.perk_id, feat.id)
        end, self)
        Printer:Debug(LOG.ADD, CAT.UI, "Added Feat to Scroller - Feat: " .. feat.name .. " Button ID: " .. id .. " Index: " .. index)
    end
end

function npcd_dashboard_tab:UpdatePerkDetails(perk_id)
    Printer:Debug(LOG.RUN, CAT.UI, "Updating Perk Details Window - Perk ID: " .. perk_id)
    self.perks_browser.perk_detail.perk_card.dialog:Show(false)
    local perk = npcd.get_perk(perk_id)
    -- Printer:DebugTable("PERK DETAILS", perk)
    if perk then
        self.perks_browser.perk_detail.perk_id = perk.id
        self.perks_browser.perk_detail.description = perk.description
        self.perks_browser.perk_detail.perk_card.icon:InitTexture(perk.icon)
        self.perks_browser.perk_detail.perk_card.icon:Show(true)
        self.perks_browser.perk_detail.perk_card.name:SetText(gc(perk.name))
        local type_text = gc("ui_mcm_lst_" .. npcd.PERK_TYPE_UI[perk.type].name)
        self.perks_browser.perk_detail.perk_card.type:SetText(type_text)
        self.perks_browser.perk_detail.type:SetText(type_text)
        self.perks_browser.perk_detail.category:SetText(gc("ui_mcm_lst_" .. npcd.PERK_CATEGORY_UI[perk.category].name))
        self.perks_browser.perk_detail.chance:SetText(tostring(perk.roll_chance) .. " %")
        -- optional characteristics
        if perk.depends and npcdu.tablelength(perk.depends) > 0 then
            self.perks_browser.perk_detail.requirements:SetText("")
            for _, dep in pairs(perk.depends) do
                local required_perk = npcd.get_perk(dep)
                if required_perk then
                    local requirement_name = gc(required_perk.name)
                    local current_text = self.perks_browser.perk_detail.requirements:GetText()
                    if current_text == "" then
                        self.perks_browser.perk_detail.requirements:SetText(requirement_name)
                    else
                        self.perks_browser.perk_detail.requirements:SetText(current_text .. ", " .. requirement_name)
                    end
                    self.perks_browser.perk_detail.requirements:Show(true)
                end
            end
        else
            self.perks_browser.perk_detail.requirements:Show(false)
            
        end
        if perk.faction then
            self.perks_browser.perk_detail.faction:SetText(perk.faction)
            self.perks_browser.perk_detail.faction:Show(true)
        else
            self.perks_browser.perk_detail.faction:Show(false)
        end

        self:UpdatePerkDescription()
        self:UpdateFeatsScroller()
    end
    self.perks_browser.perk_detail.perk_card.dialog:Show(true)
end

function npcd_dashboard_tab:UpdatePerkDescription()
    Printer:Debug(LOG.REMOVE, CAT.UI, "Clearing Feat Details Window")
    self.perks_browser.perk_detail.description_scroll:Clear()
    local description = xml:InitTextWnd("perks_browser:perk_detail:details_frame:perk_description:description", nil)
    description:SetText(gc(self.perks_browser.perk_detail.description or ""))
    description:AdjustHeightToText()
    self.perks_browser.perk_detail.description_scroll:AddWindow(description, true)
end

function npcd_dashboard_tab:CreateFeatDetailsAttribute(icon_texture, name_text, value_text)
    local attr = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details:attribute", nil)
    
    local name = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:attribute:name", attr)
    name:SetText(name_text)

    local icon = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details:attribute:icon", attr)
    icon:InitTexture(icon_texture)
    
    local value = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:attribute:value", attr)
    value:SetText(value_text)

    return attr
end

function npcd_dashboard_tab:CreateFeatDetailsStat(icon_texture, name_text, value_text)
    local attr = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details:stat", nil)
    
    local icon = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details:stat:icon", attr)
    icon:InitTexture(icon_texture)
    
    local name = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:stat:name", attr)
    name:SetText(name_text)
    
    local value = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:stat:value", attr)
    value:SetText(value_text)
    attr.value = value
    return attr
end

function npcd_dashboard_tab:UpdateFeatDetailsStats(perk_id, feat_id)
    Printer:Debug(LOG.START, CAT.UI, "Updating Details Window Feat Stats - Rank: " .. tostring(UI_FEAT_DETAILS.rank or 1))
    local feat = npcd.get_perk_feat(perk_id, feat_id)
    if feat then
        for stat_name, stat_el in pairs(UI_FEAT_DETAILS.stats or {}) do
            local ranked_stats = feat.stats[UI_FEAT_DETAILS.rank]
            stat_el.value:SetText(tostring(ranked_stats[stat_name] or "0"))
        end
        UI_FEAT_DETAILS.rank_ui:SetText(gc("ui_npcd_details_ability_rank") .. " [" .. tostring(UI_FEAT_DETAILS.rank) .. "]")
        UI_FEAT_DETAILS.rank_ui:SetTextColor(color_black)
    end
end

function npcd_dashboard_tab:UpdateFeatDetailsWindow(perk_id, feat_id)
    Printer:Debug(LOG.START, CAT.UI, "Update Feat Details Window -  perk ID: " .. perk_id .. " feat ID: " .. feat_id)
    self.show_hint = false
    self.perks_browser.perk_detail.feat_id = feat_id

    local feat = npcd.get_perk_feat(perk_id, feat_id)

    if feat then
        -- update the scroll content
        UI_FEAT_DETAILS.scroll:Clear()
        UI_FEAT_DETAILS.toggle_button:TextControl():SetText(gc(feat.name))

        -- update header
        local header = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details:header", nil)
        local icon_frame = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details:header:icon_frame", header)
        local icon = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details:header:icon_frame:icon", icon_frame)
        icon:InitTexture(feat.icon)
        local name = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:header:name", header)
        name:SetText(gc(feat.name))
        local resource = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:header:resource_label", header)
        resource:SetText(gc("ui_npcd_details_ability_resource") .. "  ---  ")
        local type = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:header:resource_type", header)
        type:SetText( gc("ui_npcd_details_ability_cost_unit_stamina"))
        UI_FEAT_DETAILS.scroll:AddWindow(header, true)
        -- update attributes
        local feat_type = self:CreateFeatDetailsAttribute(
            npcd.FEAT_TYPE_UI[feat.type].icon,
            gc("ui_mcm_st_npcd_feat_type"),
            gc("ui_mcm_lst_" .. feat.type)
        )
        UI_FEAT_DETAILS.scroll:AddWindow(feat_type, true)

        local feat_mode = self:CreateFeatDetailsAttribute(
            npcd.FEAT_MODE_UI[feat.mode].icon,
            gc("ui_mcm_st_npcd_feat_mode"),
            gc("ui_mcm_lst_" .. feat.mode)
        )
        UI_FEAT_DETAILS.scroll:AddWindow(feat_mode, true)

        local feat_category = self:CreateFeatDetailsAttribute(
            npcd.FEAT_CATEGORY_UI[feat.category].icon,
            gc("ui_mcm_st_npcd_feat_category"),
            gc("ui_mcm_lst_" .. feat.category)
        )
        UI_FEAT_DETAILS.scroll:AddWindow(feat_category, true)

        local feat_target = self:CreateFeatDetailsAttribute(
            npcd.FEAT_TARGET_UI[feat.target].icon,
            gc("ui_mcm_st_npcd_feat_target"),
            gc(npcd.FEAT_TARGET_UI[feat.target].desc)
        )
        UI_FEAT_DETAILS.scroll:AddWindow(feat_target, true)

        -- update description
        UI_FEAT_DETAILS.description = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:description", nil)
        UI_FEAT_DETAILS.description:SetText(gc(feat.description))
        UI_FEAT_DETAILS.description:AdjustHeightToText()
        UI_FEAT_DETAILS.scroll:AddWindow(UI_FEAT_DETAILS.description, true)

        -- stats section
        if feat.stats and npcdu.tablelength(feat.stats[1]) > 0 then
            -- Printer:DebugTable("FEAT STATS", feat.stats)
            local ranked_stats = feat.stats[UI_FEAT_DETAILS.rank or 1]
            local stats_header = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details:section", nil)
            local title = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:section:title", stats_header)
            title:SetText(gc("ui_npcd_details_ability_stats"))
            title:SetFont(GetFontMedium())
            UI_FEAT_DETAILS.scroll:AddWindow(stats_header, true)
            UI_FEAT_DETAILS.stats = {}
            for stat_name, stat_value in pairs(ranked_stats or {}) do
                if npcd.FEAT_STAT[stat_name] then
                    local suffix = self:__GetStatSuffix(stat_name)
                    local stat_attr = self:CreateFeatDetailsStat(
                        npcd.FEAT_STAT[stat_name].icon,
                        gc(npcd.FEAT_STAT[stat_name].name),
                        tostring(stat_value) .. suffix
                    )
                    UI_FEAT_DETAILS.scroll:AddWindow(stat_attr, true)
                    UI_FEAT_DETAILS.stats[stat_name] = stat_attr
                end
            end
            -- stat paging
            local stat_page = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details:stat_page", nil)
            local perk_rank = 1
            UI_FEAT_DETAILS.rank = 1
            UI_FEAT_DETAILS.rank_ui = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:stat_page:rank", stat_page)
            UI_FEAT_DETAILS.rank_ui:SetText(gc("ui_npcd_details_ability_rank") .. " [" .. tostring(UI_FEAT_DETAILS.rank) .. "]")
            UI_FEAT_DETAILS.rank_ui:SetTextColor(color_black)

            local prev_button = xml:Init3tButton("perks_browser:perk_detail:details_frame:feat_details:stat_page:prev_button", stat_page)
            local next_button = xml:Init3tButton("perks_browser:perk_detail:details_frame:feat_details:stat_page:next_button", stat_page)
            local cb_id = math.random(1000,9999)
            self:Register(prev_button, "feat_details_window_stat_prev_button".. cb_id)
            self:Register(next_button, "feat_details_window_stat_next_button".. cb_id)
            self:AddCallback("feat_details_window_stat_prev_button".. cb_id, ui_events.BUTTON_CLICKED, function ()
                Printer:Debug(LOG.INFO, CAT.UI, "Details Window Stat Prev Button Clicked")
                if UI_FEAT_DETAILS.rank > perk_rank then
                    UI_FEAT_DETAILS.rank = UI_FEAT_DETAILS.rank - 1
                    self:UpdateFeatDetailsStats(perk_id, feat_id)
                end
                prev_button:Enable(UI_FEAT_DETAILS.rank > perk_rank)
                next_button:Enable(UI_FEAT_DETAILS.rank < #feat.stats)
            end, self)
            self:AddCallback("feat_details_window_stat_next_button".. cb_id, ui_events.BUTTON_CLICKED, function ()
                Printer:Debug(LOG.INFO, CAT.UI, "Details Window Stat Next Button Clicked")
                if UI_FEAT_DETAILS.rank < #feat.stats then
                    UI_FEAT_DETAILS.rank = UI_FEAT_DETAILS.rank + 1
                    self:UpdateFeatDetailsStats(perk_id, feat_id)
                end
                prev_button:Enable(UI_FEAT_DETAILS.rank > perk_rank)
                next_button:Enable(UI_FEAT_DETAILS.rank < #feat.stats)
            end, self)
            prev_button:Enable(UI_FEAT_DETAILS.rank > perk_rank)
            next_button:Enable(UI_FEAT_DETAILS.rank < #feat.stats)
            UI_FEAT_DETAILS.scroll:AddWindow(stat_page, true)
            -- Printer:DebugTable("FEAT", feat)

            -- capstone section
            if feat.capstone then
                local capstone_header = xml:InitStatic("perks_browser:perk_detail:details_frame:feat_details:section", nil)
                local capstone_title = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:section:title", capstone_header)
                capstone_title:SetText(gc("ui_npcd_details_ability_capstone"))
                capstone_title:SetFont(GetFontMedium())
                UI_FEAT_DETAILS.scroll:AddWindow(capstone_header, true)
                -- update capstone description
                local capstone = xml:InitTextWnd("perks_browser:perk_detail:details_frame:feat_details:description", nil)
                capstone:SetText(gc(feat.capstone))
                capstone:AdjustHeightToText()
                UI_FEAT_DETAILS.scroll:AddWindow(capstone, true)
            end
        end
    end
    Printer:Debug(LOG.UPDATED, CAT.UI, "Feat Details Window Update Complete")
    if not UI_FEAT_DETAILS.state then
        self:SetFeatDetailsWindowState(UI_FEAT_DETAILS_WINDOW_STATE.MINIMIZED)
    elseif UI_FEAT_DETAILS.hidden_state then
        Printer:Debug(LOG.INFO, CAT.UI, "Feat Details Window is Hidden, resuming state")
        self:SetFeatDetailsWindowState(UI_FEAT_DETAILS.state)
    end

    UI_FEAT_DETAILS.dialog:Show(true)
end

