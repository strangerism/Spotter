--------------------------------
-- Activate App Panel
-- ----------------------------
function npcd_dashboard_tab:ActivateAppPanel(app_name)
    -- disable current active dialog
    if self.app_panel then
        self.app_panel:Show(false)
    end

    self:DeactivateOtherPanels(app_name)

    -- activate new dialog and children
    UI_APP[app_name].active = true
    self.app_panel = UI_APP[app_name].dialog
    if app_name ~= APP.HOME then
        self:ActivateAppMenu(app_name, UI_APP[app_name].default_menu or APP_MENU[app_name][1])
    end
    -- show new active dialog

    if self.app_panel then
        self.app_panel:Show(true)
    end

    -- update fx
    self.apps_bar_scanline.direction = self.apps_bar_scanline.direction * -1
    npcd_ui_fx.resume_fx(self.apps_bar_flickering.id)
end

function npcd_dashboard_tab:DeactivateOtherPanels(app_name)
    for _, name in pairs(APP) do
        if name ~= app_name then
            UI_APP[name].active = false
            if name == APP.PROFILES or name == APP.PERKS then
                npcd_ui_fx.stop_fx(self.menu_scroller.fx.scanline.id)
                npcd_ui_fx.stop_fx(self.menu_scroller.fx.wide_scanline.id)
                npcd_ui_fx.stop_fx(self.menu_scroller.fx.wide_scanline_2.id)
                npcd_ui_fx.stop_fx(self.menu_scroller.fx.flickering.id)

                -- self.npc_panel.init = false
            end
        end
    end
end

--------------------------------
-- Activate App Menu
-- ----------------------------
function npcd_dashboard_tab:ActivateAppMenu(app_name, menu_name)
    Printer:Debug(LOG.RUN, CAT.UI, "Activating App Menu - App: " .. app_name .. " Menu: " .. menu_name)
    -- disable current active menu panel
    if self.app_menu_panel then
        self.app_menu_panel:Show(false)
    end
    self:ResetItemScroller()
    self:DeactivateOtherMenus(app_name, menu_name)
    
    -- activate new menu panel and children  
    self.app_menu_panel = UI_MENU[app_name][menu_name].dialog
    Printer:Debug(LOG.ADD, CAT.UI, "Activated Menu - App: " .. app_name .. " Menu: " .. menu_name)
    
    -- show new active menu panel
    if self.app_menu_panel then
        self.app_menu_panel:Show(true)
    end

    -- update fx
    if not UI_MENU[app_name][menu_name].active then
        local activated_translate_fx = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.TRANSLATE)
        activated_translate_fx.dialog = UI_MENU[app_name][menu_name].button
        activated_translate_fx.orientation = 0
        activated_translate_fx.direction = 1
        activated_translate_fx.length = 10
        activated_translate_fx.stop = {"npcd_pda_dashboard", "enable_active_menu_button", app_name, menu_name, false}
        npcd_ui_fx.add_fx(activated_translate_fx, "menu_translate_" .. app_name .. "_" .. menu_name)
        npcd_ui_fx.resume_fx(activated_translate_fx.id)
    end
    UI_MENU[app_name][menu_name].active = true
    -- show item scroller for profiles and perks apps
    if app_name == APP.PROFILES then
        self:ClearNPCPanel()
        self.npc_panel.dialog:Show(true)
        self:ClosePerksBrowser()
        self:UpdateItemScroller(app_name, menu_name)
    end
    if app_name == APP.PERKS then
        self:RemoveNPCPanel()
        self:StartPerksBrowser(app_name, menu_name)
    end
    if app_name == APP.DATA then
        self:RemoveNPCPanel()
        self:ClosePerksBrowser()
    end
end

function npcd_dashboard_tab:DeactivateOtherMenus(app_name, menu_name)
    local menus = APP_MENU[app_name] or {}
    for _, name in pairs(menus) do
        if name ~= menu_name then
            -- disabling menus(name)
            if UI_MENU[app_name][name].active then
                -- translate current active [app][menu] button back to original position
                local deactivated_translate_fx = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.TRANSLATE)
                deactivated_translate_fx.dialog = UI_MENU[app_name][name].button
                deactivated_translate_fx.orientation = 0
                deactivated_translate_fx.direction = -1
                deactivated_translate_fx.length = 10
                deactivated_translate_fx.stop = {"npcd_pda_dashboard", "enable_active_menu_button", app_name, name, true}
                npcd_ui_fx.add_fx(deactivated_translate_fx, "menu_translate_" .. app_name .. "_" .. name)
                npcd_ui_fx.resume_fx(deactivated_translate_fx.id)
            end
            UI_MENU[app_name][name].active = false
            UI_MENU[app_name][name].button:Enable(true)
            Printer:Debug(LOG.REMOVE, CAT.UI, "Deactivated Menu - App: " .. app_name .. " Menu: " .. name)
        end
    end
end


function enable_active_menu_button(app_name, menu_name, enable)
    -- Printer:Debug(LOG.INFO, CAT.UI, "Setting Active Menu Button Enable State - App: " .. app_name .. " Menu: " .. menu_name .. " Enable: " .. tostring(enable))
    UI_MENU[app_name][menu_name].button:Enable(enable)

    -- redraw left shoulder to fix button overlap issue
    local GUI = npcd_pda_dashboard.get_ui()
    if GUI then
        -- Printer:Debug(LOG.INFO, CAT.UI, "Redrawing Left Shoulder to fix button overlap issue")
        GUI.left_shoulder = xml:InitStatic("left_side", GUI)
    end
end

-------------------------------
-- App Button Callbacks
-- ----------------------------

function npcd_dashboard_tab:On_Profiles_Button_Clicked()
    Printer:Debug(LOG.START, CAT.UI, "PROFILES Button Clicked")

    self.app[APP.PROFILES].button:Enable(false)
    self.app[APP.PERKS].button:Enable(true)
    self.app[APP.DATA].button:Enable(true)

    self.menu_scroller.ui.bg:Show(false)
    self.menu_scroller.ui.glass:Show(false)
    self.menu_scroller.ui.dialog:Show(true)

    self:ActivateAppPanel(APP.PROFILES)
    -- TODO move it from here
    npcd_ui_fx.resume_fx(self.menu_scroller.fx.glass_showing.id)
end

function npcd_dashboard_tab:On_Perks_Button_Clicked()
    Printer:Debug(LOG.START, CAT.UI, "PERKS Button Clicked")

    self.app[APP.PROFILES].button:Enable(true)
    self.app[APP.PERKS].button:Enable(false)
    self.app[APP.DATA].button:Enable(true)

    self:ActivateAppPanel(APP.PERKS)
end

function npcd_dashboard_tab:On_Data_Button_Clicked()
    Printer:Debug(LOG.START, CAT.UI, "DATA Button Clicked")

    self.app[APP.PROFILES].button:Enable(true)
    self.app[APP.PERKS].button:Enable(true)
    self.app[APP.DATA].button:Enable(false)

    self.menu_scroller.ui.bg:Show(false)
    self.menu_scroller.ui.glass:Show(false)
    self.menu_scroller.ui.dialog:Show(false)

    self:ActivateAppPanel(APP.DATA)
end

function npcd_dashboard_tab:EnableAppButtons(enable)
    for app_name, app in pairs(self.app) do
        app.button:Enable(enable)
    end
end

function npcd_dashboard_tab:SetHint(text, frame_to_fit, pos)

	if (not text) then
		self.tg_hint = time_global()
		self.hint_wnd:Show(false)
		return
	end
	
	if (time_global() < self.tg_hint + self.tg_hint_step) then
		return
	end
	
	self.hint_wnd:Show(true)
	self.hint_wnd_text:SetText(text)
	self.hint_wnd_text:AdjustHeightToText()
    self.hint_wnd_footer:SetWndPos(vector2():set( self.hint_wnd_footer:GetWndPos().x, self.hint_wnd_text:GetHeight() + self.hint_wnd_text:GetWndPos().y + 5))
    -- Adjust hint window size based on text size

	local w = self.hint_wnd:GetWidth()
	w = w >= 150 and w or 150
	local h = self.hint_wnd_text:GetHeight()+ 84 + self.hint_wnd_text:GetWndPos().y
	h = h >= 111 and h or 111
	self.hint_wnd:SetWndSize(vector2():set(w,h))

	pos = pos or GetCursorPosition()
	pos.y = pos.y - self.hint_wnd:GetHeight()
	pos.x = pos.x - self.hint_wnd:GetWidth()
	self.hint_wnd:SetWndPos(pos)
    if not frame_to_fit then
        frame_to_fit = self
    end
	FitInRect(self.hint_wnd,Frect():set(frame_to_fit.x,frame_to_fit.y,frame_to_fit:GetWidth(),frame_to_fit:GetHeight()),0,100)
end

function npcd_dashboard_tab:GetAbilitiesHintElements()
    if not self.npc_panel.init then
        return {}
    end
    if not self.npc_panel.specs.content.dialog:IsShown() then
        return {}
    end
    return self.npc_panel and self.npc_panel.specs and self.npc_panel.specs.content.scroll.row or {}
end

--------------------------------
-- Main Update Loop
--------------------------------
function npcd_dashboard_tab:Update()
    CUIScriptWnd.Update(self)

    -- update the talent specs scroll

    if self.npc_panel and self.npc_panel.specs and self.npc_panel.specs.content and self.npc_panel.specs.content.scroll and self.npc_panel.specs.content.update_talent_scroll then
        self:UpdateSpecsTerminalDisplay(SPECS.TALENTS, self.npc_panel.npc_id)
        self.npc_panel.specs.content.update_talent_scroll = false
        self.npc_panel.specs.content.scroll:SetScrollPos(self.npc_panel.specs.content.update_talent_scroll_pos or 0)
        self.npc_panel.specs.content.update_talent_scroll_pos = nil
    end

    -- Update the dashboard contents here if needed.
	-- Hint
    for _, v in pairs(self:GetAbilitiesHintElements()) do
        -- Printer:Debug(LOG.START, CAT.UI, "Checking Hint Element")
        -- Printer:Debug(LOG.DEBUG, CAT.UI, "Checking Hint Element: " .. tostring(v.data and v.data.feat_name or v.data and v.data.perk_name or "N/A"))
        if self.show_hint and v and v.feat_icon and v.feat_icon:IsCursorOverWindow() then
            if v.data then
                self.hint_title:SetText( v.data.feat_type .. " Feat" )
                self.hint_icon:InitTexture( v.data.feat_icon )
                self.hint_name:SetText( v.data.feat_name )
                self:SetHint( "\\n \\n" .. v.data.feat_hint , UI_APP[APP.PROFILES].dialog)
                self.hint_feat_uid = v.data.feat_uid
                if self.hint_feat_uid then
                    RegisterScriptCallback("on_key_press",on_key_press_feat_hint)
                end
                return
            end
		end
		if self.show_hint and v and v.perk_icon and v.perk_icon:IsCursorOverWindow() then
            if v.data then
                self.hint_title:SetText( v.data.perk_type .. " Perk" )
                self.hint_icon:InitTexture( v.data.perk_icon )
                self.hint_name:SetText( v.data.perk_name )
                self:SetHint( "\\n \\n" .. v.data.perk_hint, UI_APP[APP.PROFILES].dialog)
                self.hint_perk_uid = v.data.perk_id
                if self.hint_perk_uid then
                    RegisterScriptCallback("on_key_press",on_key_press_perk_hint)
                end
                return
            end
		end
	end
     -- Check Details Window Hints
    if UI_DETAILS.dialog:IsShown() then
        -- Printer:Debug(LOG.START, CAT.UI, "Checking Details Window Hint")
        for _, hint in ipairs(UI_DETAILS.hints or {}) do
            if hint.ele and hint.ele:IsCursorOverWindow() then
                if hint.type == HINT_TYPE.FEAT then
                    local feat = npcd.get_ability_feat(hint.id)
                    if feat then
                        self.hint_title:SetText( gc("ui_mcm_lst_" .. feat.type) .. " Feat" )
                        self.hint_icon:InitTexture( feat.icon )
                        self.hint_name:SetText( gc(feat.name) )
                        self:SetHint( "\\n \\n" .. gc(feat.hint), UI_DETAILS.dialog)
                        self.hint_feat_uid = hint.id
                        if self.hint_feat_uid then
                            RegisterScriptCallback("on_key_press",on_key_press_feat_hint)
                        end
                        return
                    end
                end
                if hint.type == HINT_TYPE.PERK then
                    local perk = npcd.get_perk(hint.id)
                    if perk then
                        self.hint_title:SetText( gc("ui_mcm_lst_" .. perk.type) .. " Perk" )
                        self.hint_icon:InitTexture( perk.icon )
                        self.hint_name:SetText( gc(perk.name) )
                        self:SetHint( "\\n \\n" .. gc(perk.hint), UI_DETAILS.dialog)
                        self.hint_perk_uid = hint.id
                        if self.hint_perk_uid then
                            RegisterScriptCallback("on_key_press",on_key_press_perk_hint)
                        end
                        return
                    end
                end
            end
        end
    end
    if self.npc_panel.specs.active_spec == SPECS.TALENTS and not UI_DETAILS.dialog:IsShown() then
        -- Printer:Debug(LOG.START, CAT.UI, "Checking NPC Panel Talents Hint")
        for _, hint in ipairs(self.npc_panel.specs.content.hints or {}) do
            if hint.ele and hint.ele:IsCursorOverWindow() then
                local feat = npcd.get_ability_feat(hint.id)
                if feat then
                    self.hint_title:SetText( gc("ui_mcm_lst_" .. feat.type) .. " Feat" )
                    self.hint_icon:InitTexture( feat.icon )
                    self.hint_name:SetText( gc(feat.name) )
                    self:SetHint( "\\n \\n" .. gc(feat.hint), UI_APP[APP.PROFILES].dialog)
                    self.hint_feat_uid = hint.id
                    if self.hint_feat_uid then
                        RegisterScriptCallback("on_key_press",on_key_press_feat_hint)
                    end
                    return
                end
            end
        end
    end
    UnregisterScriptCallback("on_key_press",on_key_press_feat_hint)
    UnregisterScriptCallback("on_key_press",on_key_press_perk_hint)
    self:SetHint(false)
end

function get_menu_items(app_name, menu_name)
    
    local table_items = {}

    if app_name == APP.PROFILES then

        local npcs_id_list = npcd.get_npcs_id_list()

        for i = 1, #npcs_id_list do
            local npc_deck = npcd_npcs_mcm.get_npc(npcs_id_list[i], menu_name)
            if npc_deck then
                Printer:Trace(LOG.INFO, CAT.UI, "Menu Item NPC Deck Found: " .. npc_deck.id)
                Printer:TraceTable("NPC Deck", npc_deck)
                local npc_data = npcd.get_npc_data(npc_deck.id)
                if npc_data then
                    Printer:Trace(LOG.INFO, CAT.UI, "Menu Item NPC Data Found: " .. npc_data.id)
                    Printer:TraceTable("NPC Data", npc_data)
                    table.insert(table_items, { id = npc_data.id, name = npc_data.name })
                end
            end
        end
    end

    if app_name == APP.PERKS then
        for perk_id, perk in pairs(npcd.get_perks() or {}) do
            table.insert(table_items, { id = perk.id, name = perk.name })
        end
    end

    return table_items
end

function on_key_release(key)
    if key == DIK_keys.DIK_J then
        local pda_menu = ActorMenu.get_pda_menu()
        local pda3d = get_console_cmd(1,"g_3d_pda")
        if not (pda_menu:IsShown()) and db.actor:item_in_slot(8) then
            if (pda3d) then
                db.actor:activate_slot(8)
            else
                pda_menu:ShowDialog(true)
            end
            
            pda_menu:SetActiveSubdialog("eptNPCD")
        elseif (pda_menu:IsShown()) then
            if (pda3d) then
                db.actor:activate_slot(0)
            else
                pda_menu:HideDialog()
            end
        end
    end
    if key == DIK_keys.MOUSE_2 then
        Printer:Debug(LOG.INFO, CAT.UI, "Right Mouse Button Released")
        local ui = npcd_pda_dashboard.get_ui()
        if ui.perks_browser.content.perks_scroller.search:IsCursorOverWindow() then
            ui.perks_browser.content.perks_scroller.search:TextControl():SetText(game.translate_string("ui_npcd_details_perk_search"))
            ui:ClearSearchBox()
        end
        if ui.perks_browser.content.perks_scroller.categories:IsCursorOverWindow() then
            ui.perks_browser.category_filter = MENU.ALL
            ui.perks_browser.content.perks_scroller.categories_scroll:Show(false)
            ui.perks_browser.content.perks_scroller.scroll:Show(true)
            ui.perks_browser.content.perks_scroller.categories:TextControl():SetText(gc("ui_npcd_details_perk_filter"))
            ui.perks_browser.content.perks_scroller.categories:TextControl():SetTextColor(c_grey)
            ui.perks_browser.content.perks_scroller.categories:InitTexture("ui_npcd_pda_perks_category_filter")
            ui:UpdatePerksScroller(ui.perks_browser.active_menu)
        end
    end
end

function on_key_press_feat_hint(key)
    -- Printer:Debug(LOG.INFO, CAT.UI, "on_key_press_feat_hint - Key: " .. tostring(key))
    if key == DIK_keys.MOUSE_2 then
        local ui = npcd_pda_dashboard.get_ui()
        if not ui then
            return
        end
        if not ui.hint_feat_uid then
            return
        end
        -- UnregisterScriptCallback("on_key_press",on_key_press_feat_hint)
        Printer:Debug(LOG.INFO, CAT.UI, "Showing Feat Detailed Info - Feat ID: %s",ui.hint_feat_uid)
        ui:ShowFeatDetailsWindow(ui.hint_feat_uid)
        ui.hint_feat_uid = nil
    end
end

function on_key_press_perk_hint(key)
    -- Printer:Debug(LOG.INFO, CAT.UI, "on_key_press_perk_hint - Key: " .. tostring(key))
    if key == DIK_keys.MOUSE_2 then
        local ui = npcd_pda_dashboard.get_ui()
        if not ui then
            return
        end
        if not ui.hint_perk_uid then
            return
        end
        -- UnregisterScriptCallback("on_key_press",on_key_press_perk_hint)
        Printer:Debug(LOG.INFO, CAT.UI, "Showing Perk Detailed Info - Perk ID: %s",ui.hint_perk_uid)
        ui:ShowPerkDetailsWindow(ui.hint_perk_uid)
        ui.hint_perk_uid = nil
    end
end


function on_game_start()
    if mac_mcm then
        mac_mcm.add_app("npcd", {
            name = "pda_btn_npcd",
            texture = "pda_npcd_app",
            tab = "eptNPCD",
            func = npcd_pda_dashboard.get_ui
        })
    end
	RegisterScriptCallback("on_key_release",on_key_release)
end
