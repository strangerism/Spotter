-- Constructor.
class "npcd_dashboard_tab" (CUIScriptWnd)
function npcd_dashboard_tab:__init() super()
    xml:ParseFile("npcd_pda_dashboard.xml")
	self:InitControls()
end

-- Initialise the interface.
function npcd_dashboard_tab:InitControls()
    Printer:Debug(LOG.INFO, CAT.UI, "Initialising NPCD PDA Dashboard UI")
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	

-- FX Managers
-- FX: Flickering Manager 
    local manager = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING_MANAGER)
    npcd_ui_fx.add_fx(manager)
    self.flickering_manager = manager

    -- Apps Bar
    self:InitAppsBar()
    xml:InitStatic("left_side", self)

    -- App Panel
    self:InitHomePanel()
    self:InitNPCSPanel()
    self:InitPerksPanel()
    self:InitDeckPanel()
    self:InitAppsMenu()
    self:ActivateAppPanel(APP.HOME)

    xml:InitStatic("right_side", self)
    -- Footer
    self.footer = xml:InitStatic("footer", self)

    npcd_ui_fx.resume_fx(self.flickering_manager.id)
end

function npcd_dashboard_tab:InitAppsBar()

    self.apps_bar = xml:InitStatic("apps_bar", self)
    local background = xml:InitStatic("apps_bar:background", self.apps_bar)
    xml:InitStatic("apps_bar:frame", self.apps_bar)
    
-- FX: Scanlines on Apps Bar
    local scanlines = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.SCANLINES)
    scanlines.dialog = background
    scanlines.speed = 0.04
    scanlines.orientation = 1
    scanlines.scale = 3
    scanlines.margin_v = 5
    scanlines.intensity = 0.3
    scanlines.random_accel = true
    npcd_ui_fx.add_fx(scanlines)
    self.apps_bar_scanline = scanlines

-- FX: FLickering on scanline
    local scanline_flicker = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING)
    local scanline_ui = npcd_ui_fx.get_fx_ui(scanlines.id)
    scanline_flicker.dialog = scanline_ui
    scanline_flicker.speed = 0.05
    scanline_flicker.intensity = 0.3
    scanline_flicker.max_intensity = 0.6
    scanline_flicker.random_duration = {"npcd_pda_dashboard", "npcs_scroller_glitch_duration"}
    scanline_flicker.random_cooldown = {"npcd_pda_dashboard", "npcs_scroller_glitch_cooldown"}
    npcd_ui_fx.add_fx(scanline_flicker)
    npcd_ui_fx.add_fx_to_manager(scanline_flicker.id, self.flickering_manager and self.flickering_manager.id or nil)
    self.apps_bar_scanline_flickering = scanline_flicker

-- FX: Flickering on Apps Bar
    local flickering = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING)
    flickering.dialog = background
    flickering.speed = 0.02
    npcd_ui_fx.add_fx(flickering)
    self.apps_bar_flickering = flickering

    self.app = {}
    self.app[APP.NPCS] = {}
    self.app[APP.NPCS].tab = xml:InitStatic("apps_bar:npcs", self.apps_bar)
    xml:InitStatic("apps_bar:npcs:tab_left", self.app[APP.NPCS].tab)
    self.app[APP.NPCS].button = xml:Init3tButton("apps_bar:npcs:button", self.app[APP.NPCS].tab)
    self.app[APP.NPCS].button:Enable(true)
    xml:InitStatic("apps_bar:npcs:tab_right", self.app[APP.NPCS].tab)
    self:Register(self.app[APP.NPCS].button, "app_button_" .. APP.NPCS)

    self.app[APP.PERKS] = {}
    self.app[APP.PERKS].tab = xml:InitStatic("apps_bar:perks", self.apps_bar)
    xml:InitStatic("apps_bar:perks:tab_left", self.app[APP.PERKS].tab)
    self.app[APP.PERKS].button = xml:Init3tButton("apps_bar:perks:button", self.app[APP.PERKS].tab)
    self.app[APP.PERKS].button:Enable(true)
    xml:InitStatic("apps_bar:perks:tab_right", self.app[APP.PERKS].tab)
    self:Register(self.app[APP.PERKS].button, "app_button_" .. APP.PERKS)

    self.app[APP.DECK] = {}
    self.app[APP.DECK].tab = xml:InitStatic("apps_bar:deck", self.apps_bar)
    xml:InitStatic("apps_bar:deck:tab_left", self.app[APP.DECK].tab)
    self.app[APP.DECK].button = xml:Init3tButton("apps_bar:deck:button", self.app[APP.DECK].tab)
    self.app[APP.DECK].button:Enable(true)
    xml:InitStatic("apps_bar:deck:tab_right", self.app[APP.DECK].tab)
    self:Register(self.app[APP.DECK].button, "app_button_" .. APP.DECK)

    Printer:Debug(LOG.INFO, CAT.UI, "Initialising NPCD PDA Dashboard UI Callbacks")
    self:AddCallback("app_button_" .. APP.NPCS, ui_events.BUTTON_CLICKED, self.On_NPCS_Button_Clicked, self)
    self:AddCallback("app_button_" .. APP.PERKS, ui_events.BUTTON_CLICKED, self.On_Perks_Button_Clicked, self)
    self:AddCallback("app_button_" .. APP.DECK, ui_events.BUTTON_CLICKED, self.On_Deck_Button_Clicked, self)

    npcd_ui_fx.resume_fx(self.apps_bar_scanline.id)
end

function npcd_dashboard_tab:InitHomePanel()
    -- Home Panel
    UI_APP[APP.HOME].active = false
    UI_APP[APP.HOME].dialog = xml:InitStatic("home_panel", self)
    local panel_bg = xml:InitStatic("home_panel:panel_bg", UI_APP[APP.HOME].dialog)
    xml:InitStatic("home_panel:panel_logo", panel_bg)
    UI_APP[APP.HOME].dialog:Show(false)
end

function npcs_scroller_glitch_duration()
    return time_global() + math.random(10, 50) * 5
end

function npcs_scroller_glitch_cooldown()
    return time_global() + math.random(10, 50) * 100
end

function npcs_scroller_bg_showing_fx_stop()
    Printer:Debug(LOG.INFO, CAT.UI, "NPCS Scroller BG Showing FX Stopped")
    local ui = get_ui()
    if ui then
        Printer:Debug(LOG.START, CAT.UI, "Forcing NPCS Scroller Flickering FX to start")
        npcd_ui_fx.resume_fx(ui.npcs_scroller_flickering.id)
        ui.npcs_scroller_flickering.force = 500 -- 0.5 seconds
        npcd_ui_fx.resume_fx(ui.npcs_scroller_scanline.id)
    end
end

function npcd_dashboard_tab:InitNPCSPanel()
    -- NPCS Panel
    UI_APP[APP.NPCS].active = false
    UI_APP[APP.NPCS].dialog = xml:InitStatic("npcs_panel", self)

    
    local menu_bar = xml:InitStatic("npcs_panel:menu_bar", UI_APP[APP.NPCS].dialog)
    
    local panel_bg = xml:InitStatic("npcs_panel:panel_bg", UI_APP[APP.NPCS].dialog)
    xml:InitStatic("npcs_panel:v_main_separator", panel_bg)
    xml:InitStatic("npcs_panel:panel_logo", panel_bg)

    local npcs_scroller = xml:InitStatic("npcs_panel:npcs_scroller", UI_APP[APP.NPCS].dialog)
    xml:InitStatic("npcs_panel:npcs_scroller:anchor_top", npcs_scroller)

    --------------------------------
    -- NPCS Scroller Background
    --------------------------------
    self.scroller_bg = xml:InitStatic("npcs_panel:npcs_scroller:scroller_bg", npcs_scroller)
    self.scroller_bg:Show(false)
-- FX: Showing on NPCS scroller background    
    local npcs_scroller_bg_showing_fx = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.SHOWING)
    npcs_scroller_bg_showing_fx.speed = 0.005
    npcs_scroller_bg_showing_fx.dialog = self.scroller_bg
    npcs_scroller_bg_showing_fx.stop = {"npcd_pda_dashboard", "npcs_scroller_bg_showing_fx_stop"}
    npcd_ui_fx.add_fx(npcs_scroller_bg_showing_fx)
    self.npcs_scroller_bg_showing_fx = npcs_scroller_bg_showing_fx

-- FX: Scanlines on NPCS scroller
    local scanlines = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.SCANLINES)
    scanlines.dialog = self.scroller_bg
    scanlines.speed = 0.025
    scanlines.random_accel = true
    scanlines.accel_length = 10
    scanlines.margin_v = -5
    scanlines.margin_h = 0
    scanlines.orientation = 1
    npcd_ui_fx.add_fx(scanlines)
    self.npcs_scroller_scanline = scanlines

-- FX: Flickering on NPCS scroller
    local flickering = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING)
    flickering.dialog = self.scroller_bg
    flickering.random_duration = {"npcd_pda_dashboard", "npcs_scroller_glitch_duration"}
    flickering.random_cooldown = {"npcd_pda_dashboard", "npcs_scroller_glitch_cooldown"}
    npcd_ui_fx.add_fx(flickering)
    self.npcs_scroller_flickering = flickering
    npcd_ui_fx.add_fx_to_manager(flickering.id, self.flickering_manager.id)

    --------------------------------
    --- NPCS Scroller Elements
    --------------------------------
    self.scroller_dirt = xml:InitStatic("npcs_panel:npcs_scroller:scroller_dirt", npcs_scroller)

    local scroller_frame = xml:InitStatic("npcs_panel:npcs_scroller:scroller_frame", npcs_scroller)

    xml:InitStatic("npcs_panel:npcs_scroller:anchor_bottom", npcs_scroller)

    --------------------------------
    --- NPCS Menu bar
    --------------------------------

    UI_APP[APP.NPCS].dialog:Show(false)
end

function npcd_dashboard_tab:InitAppsMenu()
    Printer:DebugTable("APP", APP)
    Printer:DebugTable("MENU", MENU)
    for _, app in pairs(APP) do
        -- e.g. UI_MENU["npcs"] = {}        
        UI_MENU[app] = {}
        local button_spacing = 10
        local menus = APP_MENU[app] or {}
        local menu_count = #menus
        
        if menu_count > 0 then
            -- Create all buttons first to get their heights
            local buttons = {}
            for i, menu in ipairs(menus) do
                UI_MENU[app][menu] = {}
                UI_MENU[app][menu].button = xml:Init3tButton(app .. "_panel:menu_bar:button", UI_APP[app].dialog)
                UI_MENU[app][menu].button:TextControl():SetText(gc(STRING_PREFIX .. "menu_".. menu))
                self:Register(UI_MENU[app][menu].button, app .. "_menu_button_" .. menu)
                self:AddCallback(app .. "_menu_button_" .. menu, ui_events.BUTTON_CLICKED, function ()
                    self:On_Menu_Button_Clicked(app, menu)
                end, self)
                table.insert(buttons, {menu = menu, button = UI_MENU[app][menu].button})
            end
            
            -- Calculate vertical centering for menu buttons
            -- Use the panel dialog height as reference for centering
            local panel_height = UI_APP[app].dialog:GetHeight()
            local middle = panel_height / 2
            local first_button_height = buttons[1].button:GetHeight()
            local total_height = (menu_count * first_button_height) + ((menu_count - 1) * button_spacing)
            local start_y = middle - (total_height / 2)
            
            -- Position buttons vertically centered with proper spacing
            for i, button_data in ipairs(buttons) do
                local button_height = button_data.button:GetHeight()
                local y_pos = start_y + ((i - 1) * (button_height + button_spacing))
                button_data.button:SetWndPos(vector2():set(button_data.button:GetWndPos().x, y_pos))
            end
        end
    end
end

function npcd_dashboard_tab:On_Menu_Button_Clicked(app, menu)
    Printer:Debug(LOG.INFO, CAT.UI, "Menu Button Clicked - App: " .. app .. " Menu: " .. menu)
    -- Handle menu button click logic here.
end

function npcd_dashboard_tab:InitPerksPanel()
    -- Perks Panel
    UI_APP[APP.PERKS].active = false
    UI_APP[APP.PERKS].dialog = xml:InitStatic("perks_panel", self)
    local panel_bg = xml:InitStatic("perks_panel:panel_bg", UI_APP[APP.PERKS].dialog)
    xml:InitStatic("npcs_panel:v_main_separator", panel_bg)
    xml:InitStatic("perks_panel:panel_logo", panel_bg)
    UI_APP[APP.PERKS].dialog:Show(false)
end

function npcd_dashboard_tab:InitDeckPanel()
    -- Deck Panel
    UI_APP[APP.DECK].active = false
    UI_APP[APP.DECK].dialog = xml:InitStatic("deck_panel", self)
    local panel_bg = xml:InitStatic("deck_panel:panel_bg", UI_APP[APP.DECK].dialog)
    xml:InitStatic("npcs_panel:v_main_separator", panel_bg)
    xml:InitStatic("deck_panel:panel_logo", panel_bg)
    UI_APP[APP.DECK].dialog:Show(false)
end

function npcd_dashboard_tab:ActivateAppPanel(app_name)
    if self.app_panel then
        self.app_panel:Show(false)
    end
    self:DeactivateOtherPanels(app_name)
    UI_APP[app_name].active = true
    self.app_panel = UI_APP[app_name].dialog
    self.app_panel:Show(true)
    self.apps_bar_scanline.direction = self.apps_bar_scanline.direction * -1

    npcd_ui_fx.resume_fx(self.apps_bar_flickering.id)
    -- stopping all panel fx on app change
end

function npcd_dashboard_tab:DeactivateOtherPanels(app_name)
    for _, name in pairs(APP) do
        if name ~= app_name then
            UI_APP[name].active = false
            if name == APP.NPCS then
                npcd_ui_fx.stop_fx(self.npcs_scroller_scanline.id)
                npcd_ui_fx.stop_fx(self.npcs_scroller_flickering.id)
            end
        end
    end
end

function npcd_dashboard_tab:On_NPCS_Button_Clicked()
    Printer:Debug(LOG.INFO, CAT.UI, "NPCS Button Clicked")
    self.app[APP.NPCS].button:Enable(false)
    self.app[APP.PERKS].button:Enable(true)
    self.app[APP.DECK].button:Enable(true)
    self.scroller_bg:Show(false)

    self:ActivateAppPanel(APP.NPCS)
    npcd_ui_fx.resume_fx(self.npcs_scroller_bg_showing_fx.id)
    
end

function npcd_dashboard_tab:On_Perks_Button_Clicked()
    Printer:Debug(LOG.INFO, CAT.UI, "PERKS Button Clicked")
    self.app[APP.NPCS].button:Enable(true)
    self.app[APP.PERKS].button:Enable(false)
    self.app[APP.DECK].button:Enable(true)
    self:ActivateAppPanel(APP.PERKS)
end

function npcd_dashboard_tab:On_Deck_Button_Clicked()
    Printer:Debug(LOG.INFO, CAT.UI, "DECK Button Clicked")
    self.app[APP.NPCS].button:Enable(true)
    self.app[APP.PERKS].button:Enable(true)
    self.app[APP.DECK].button:Enable(false)
    self:ActivateAppPanel(APP.DECK)
end

function npcd_dashboard_tab:EnableAppButtons(enable)
    for app_name, app in pairs(self.app) do
        app.button:Enable(enable)
    end
end

function npcd_dashboard_tab:Update()
    CUIScriptWnd.Update(self)
    -- Update the dashboard contents here if needed.
end

function on_key_release(key)
    if key == DIK_keys.DIK_J then
        local pda_menu = ActorMenu.get_pda_menu()
        local pda3d = get_console_cmd(1,"g_3d_pda")
        if not (pda_menu:IsShown()) and db.actor:item_in_slot(8) then
            if (pda3d) then
                db.actor:activate_slot(8)
            else
                pda_menu:ShowDialog(true)
            end
            
            pda_menu:SetActiveSubdialog("eptNPCD")
        elseif (pda_menu:IsShown()) then
            if (pda3d) then
                db.actor:activate_slot(0)
            else
                pda_menu:HideDialog()
            end
        end
    end
end

function on_game_start()
    if mac_mcm then
        mac_mcm.add_app("npcd", {
            name = "pda_btn_npcd",
            texture = "pda_npcd_app",
            tab = "eptNPCD",
            func = npcd_pda_dashboard.get_ui
        })
    end
	RegisterScriptCallback("on_key_release",on_key_release)
end
