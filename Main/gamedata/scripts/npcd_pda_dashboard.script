--------------------------------
-- Activate App Panel
-- ----------------------------
function npcd_dashboard_tab:ActivateAppPanel(app_name)
    -- disable current active dialog
    if self.app_panel then
        self.app_panel:Show(false)
    end

    self:DeactivateOtherPanels(app_name)

    -- activate new dialog and children
    UI_APP[app_name].active = true
    self.app_panel = UI_APP[app_name].dialog
    if app_name ~= APP.HOME then
        self:ActivateAppMenu(app_name, UI_APP[app_name].default_menu or APP_MENU[app_name][1])
    end
    -- show new active dialog
    self:UpdateAppsBar()
    if self.app_panel then
        self.app_panel:Show(true)
    end

    -- update fx
    self.apps_bar_scanline.direction = self.apps_bar_scanline.direction * -1
    npcd_ui_fx.resume_fx(self.apps_bar_flickering.id)
end

function npcd_dashboard_tab:DeactivateOtherPanels(app_name)
    for _, name in pairs(APP) do
        if name ~= app_name then
            UI_APP[name].active = false
            if name == APP.PROFILES or name == APP.PERKS then
                npcd_ui_fx.stop_fx(self.menu_scroller.fx.scanline.id)
                npcd_ui_fx.stop_fx(self.menu_scroller.fx.wide_scanline.id)
                npcd_ui_fx.stop_fx(self.menu_scroller.fx.wide_scanline_2.id)
                npcd_ui_fx.stop_fx(self.menu_scroller.fx.flickering.id)

                -- self.npc_panel.init = false
            end
        end
    end
end

--------------------------------
-- Activate App Menu
-- ----------------------------
function npcd_dashboard_tab:ActivateAppMenu(app_name, menu_name)
    Printer:Debug(LOG.RUN, CAT.UI, "Activating App Menu - App: " .. app_name .. " Menu: " .. menu_name)
    -- disable current active menu panel
    if self.app_menu_panel then
        self.app_menu_panel:Show(false)
    end
    self:ResetItemScroller()
    self:DeactivateOtherMenus(app_name, menu_name)
    
    -- activate new menu panel and children  
    self.app_menu_panel = UI_MENU[app_name][menu_name].dialog
    Printer:Debug(LOG.ADD, CAT.UI, "Activated Menu - App: " .. app_name .. " Menu: " .. menu_name)
    
    -- show new active menu panel
    if self.app_menu_panel then
        self.app_menu_panel:Show(true)
    end

    -- update fx
    if not UI_MENU[app_name][menu_name].active then
        local activated_translate_fx = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.TRANSLATE)
        activated_translate_fx.dialog = UI_MENU[app_name][menu_name].button
        activated_translate_fx.orientation = 0
        activated_translate_fx.direction = 1
        activated_translate_fx.length = 10
        activated_translate_fx.stop = {"npcd_pda_dashboard", "enable_active_menu_button", app_name, menu_name, false}
        npcd_ui_fx.add_fx(activated_translate_fx)
        npcd_ui_fx.resume_fx(activated_translate_fx.id)
    end
    UI_MENU[app_name][menu_name].active = true
    -- show item scroller for profiles and perks apps
    if app_name == APP.PROFILES or app_name == APP.PERKS then
        self:UpdateItemScroller(app_name, menu_name)
        -- npcd_ui_fx.resume_fx(self.menu_scroller.fx.glass_showing.id)
    end
end

function npcd_dashboard_tab:DeactivateOtherMenus(app_name, menu_name)
    local menus = APP_MENU[app_name] or {}
    for _, name in pairs(menus) do
        if name ~= menu_name then
            if UI_MENU[app_name][name].active then
                -- translate current active [app][menu] button back to original position
                local deactivated_translate_fx = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.TRANSLATE)
                deactivated_translate_fx.dialog = UI_MENU[app_name][name].button
                deactivated_translate_fx.orientation = 0
                deactivated_translate_fx.direction = -1
                deactivated_translate_fx.length = 10
                deactivated_translate_fx.stop = {"npcd_pda_dashboard", "enable_active_menu_button", app_name, name, true}
                npcd_ui_fx.add_fx(deactivated_translate_fx)
                npcd_ui_fx.resume_fx(deactivated_translate_fx.id)
            end
            UI_MENU[app_name][name].active = false
            UI_MENU[app_name][name].button:Enable(true)
            Printer:Debug(LOG.REMOVE, CAT.UI, "Deactivated Menu - App: " .. app_name .. " Menu: " .. name)
        end
    end
end

function enable_active_menu_button(app_name, menu_name, enable)
    Printer:Debug(LOG.INFO, CAT.UI, "Setting Active Menu Button Enable State - App: " .. app_name .. " Menu: " .. menu_name .. " Enable: " .. tostring(enable))
    UI_MENU[app_name][menu_name].button:Enable(enable)

    -- redraw left shoulder to fix button overlap issue
    local GUI = npcd_pda_dashboard.get_ui()
    if GUI then
        Printer:Debug(LOG.INFO, CAT.UI, "Redrawing Left Shoulder to fix button overlap issue")
        GUI.left_shoulder = xml:InitStatic("left_side", GUI)
    end
end

