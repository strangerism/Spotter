class "npcd_dashboard_search_box" (CUIScriptWnd)
function npcd_dashboard_search_box:__init() super()
    Printer:Debug(LOG.INFO, CAT.UI, "Initialising NPCD PDA Dashboard Search Box UI Constructor")
	self:SetWndRect			(Frect():set(0,0,1024,768))
	self:SetAutoDelete(true)

    local xml = CScriptXmlInit()
    xml:ParseFile("npcd_pda_dashboard.xml")

    self.xml = xml
    self.search_filter = nil

    self:InitControls()
end

function npcd_dashboard_search_box:InitControls()
    Printer:Debug(LOG.INFO, CAT.UI, "Initialising NPCD PDA Dashboard Search Box UI")
    self.dialog = self.xml:InitStatic("perks_browser:search_box", self )
    self.search = self.xml:InitEditBox("perks_browser:search_box:search", self.dialog )
    self.search:SetText("")
    self:Register(self.search, "perks_browser_search_box")
    self:AddCallback("perks_browser_search_box", ui_events.EDIT_TEXT_COMMIT, function ()
        local search_text = self.search:GetText()
        Printer:Debug(LOG.INFO, CAT.UI, "Perks Browser Search Box Text Changed - New Text: " .. tostring(search_text))
        if search_text == "" then
            self.search_filter = nil
        else
            self.search_filter = search_text:lower()
        end
        local ui = npcd_pda_dashboard.get_ui()
        ui.perks_browser.content.perks_scroller.search:TextControl():SetText(search_text)
        ui:ClearPerkDetails()
        ui:UpdatePerksScroller(ui.perks_browser.active_menu)
    end, self)
end

function npcd_dashboard_search_box:Update()
	CUIScriptWnd.Update(self)
end

function npcd_dashboard_search_box:__finalize()
end

function npcd_dashboard_search_box:ClearSearch()
    Printer:Debug(LOG.INFO, CAT.UI, "Clearing NPCD PDA Dashboard Search Box UI Text and Filter")
    self.search:Show(false)
    self.search:SetText("")
    self.search_filter = nil
    self.search:Show(true)
end

function npcd_dashboard_search_box:Close()
    Printer:Debug(LOG.INFO, CAT.UI, "Destroying NPCD PDA Dashboard Search Box UI")

	self:HideDialog()
	
	Unregister_UI("npcd_dashboard_search_box")
end

function npcd_dashboard_search_box:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self,dik,keyboard_action)
	if (res == false) then
		local bind = dik_to_bind(dik)					
		if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
			if dik == DIK_keys.DIK_ESCAPE or bind == key_bindings.kACTIVE_JOBS or bind == key_bindings.kCUSTOM20 then
                local ui = npcd_pda_dashboard.get_ui()
                if self.search:GetText() == "" then
                    ui.perks_browser.content.perks_scroller.search:TextControl():SetText(game.translate_string("ui_npcd_details_perk_search"))
                end
                ui.perks_browser.content.perks_scroller.search:Show(true)
				self:Close()
			end        
		end
	end
	return res
end

-- Constructor.
class "npcd_dashboard_tab" (CUIScriptWnd)
function npcd_dashboard_tab:__init() super()
    xml:ParseFile("npcd_pda_dashboard.xml")
	self:InitControls()
end

-- Initialise the interface.
function npcd_dashboard_tab:InitControls()
    Printer:Debug(LOG.INFO, CAT.UI, "Initialising NPCD PDA Dashboard UI")
	self:SetWndRect(Frect():set(0, 0, 1024, 768))

-- FX: Managers

-- FX: Flickering Manager 
    self.flickering_manager = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING_MANAGER)
    npcd_ui_fx.add_fx(self.flickering_manager, "dashboard_flickering_manager")
    npcd_ui_fx.resume_fx(self.flickering_manager.id)
    
    -- Apps Bar
    self:InitAppsBar()
    self.left_shoulder = xml:InitStatic("left_side", self)
    -- App Panel
    self:InitHomePanel()
    self:InitProfilesPanel()
    self:InitPerksPanel()
    self:InitDataPanel()
    self:InitAppsMenu()
    self:InitItemScroller()
    self:InitNPCPanelInfo()
    self:InitPerksBrowser()
    self:ActivateAppPanel(APP.HOME)
    xml:InitStatic("right_side", self)
    -- Footer
    self.footer = xml:InitStatic("footer", self)

    self:InitDetailsWindow()

    -- Hint Window
    self.show_hint = true
	self.hint_wnd = xml:InitFrame("hint_wnd:background",self)
	self.hint_wnd:SetAutoDelete(false)
    self.hint_header = xml:InitStatic("hint_wnd:header",self.hint_wnd)
    -- self.hint_header:InitTexture("hint_wnd:header:background",self.hint_header)
    self.hint_title = xml:InitTextWnd("hint_wnd:header:title",self.hint_header)
    self.hint_icon_frame = xml:InitStatic("hint_wnd:header:icon_frame",self.hint_header)
    self.hint_icon = xml:InitStatic("hint_wnd:header:icon",self.hint_header)
    self.hint_name = xml:InitTextWnd("hint_wnd:header:name",self.hint_header)
	self.hint_wnd_text = xml:InitTextWnd("hint_wnd:text",self.hint_wnd)
    self.hint_wnd_footer = xml:InitTextWnd("hint_wnd:footer",self.hint_wnd)
	self.hint_wnd:Show(false)

	self.tg_hint         = nil
	self.tg_hint_step    = 1000 --[ms]
end

function npcd_dashboard_tab:InitSearchBox()

    self.perks_browser.content.perks_scroller.search:Show(false)
	if (not self.search_box) then
		self.search_box = npcd_dashboard_search_box()
	end
	
	if (self.search_box) and (not self.search_box:IsShown()) then
		self.search_box:ShowDialog(true)
		Register_UI("npcd_dashboard_search_box","item_backpack")
        self.search_box.search:CaptureFocus(true)
	end

    return self.search_box
end

function npcd_dashboard_tab:GetSearchFilter()
    return self.search_box and self.search_box.search_filter or nil
end

function npcd_dashboard_tab:ClearSearchBox()
    if self.search_box then
        Printer:Debug(LOG.INFO, CAT.UI, "Clearing NPCD PDA Dashboard Search Box UI Text and Filter")
        self.search_box:ClearSearch()
        self:ClearPerkDetails()
        self:UpdatePerksScroller(self.perks_browser.active_menu)
    end
end

function npcd_dashboard_tab:CloseSearchBox()
    if self.search_box then
        Printer:Debug(LOG.INFO, CAT.UI, "Closing NPCD PDA Dashboard Search Box UI")
        if self.search_box.search:GetText() == "" then
            self.perks_browser.content.perks_scroller.search:TextControl():SetText(game.translate_string("ui_npcd_details_perk_search"))
        end
        self.perks_browser.content.perks_scroller.search:Show(true)
        self.search_box:Close()
    end
end

-- destroy UI
function npcd_dashboard_tab:Destroy()
    Printer:Debug(LOG.INFO, CAT.UI, "Destroying NPCD PDA Dashboard UI")
    npcd_ui_fx.remove_all_fx()
    SINGLETON = nil
end

--------------------------------
--- APP Bar
--- ----------------------------

function npcd_dashboard_tab:InitAppsBar()

    self.apps_bar = xml:InitStatic("apps_bar", self)
    local background = xml:InitStatic("apps_bar:background", self.apps_bar)
    xml:InitStatic("apps_bar:frame", self.apps_bar)
    
-- FX: Scanlines on Apps Bar
    local scanlines = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.SCANLINES)
    scanlines.dialog = background
    scanlines.speed = 0.04
    scanlines.orientation = 1
    scanlines.scale = 3
    scanlines.margin_v = 5
    scanlines.intensity = 0.3
    scanlines.random_accel = true
    scanlines.accel_length = 5
    npcd_ui_fx.add_fx(scanlines, "apps_bar_scanlines")
    self.apps_bar_scanline = scanlines

-- FX: FLickering on scanline
    local scanline_flicker = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING)
    local scanline_ui = npcd_ui_fx.get_fx_ui(scanlines.id)
    scanline_flicker.dialog = scanline_ui
    scanline_flicker.speed = 0.05
    scanline_flicker.intensity = 0.3
    scanline_flicker.max_intensity = 0.6
    scanline_flicker.random_duration = {"npcd_pda_dashboard", "items_scroller_glitch_duration"}
    scanline_flicker.random_cooldown = {"npcd_pda_dashboard", "items_scroller_glitch_cooldown"}
    npcd_ui_fx.add_fx(scanline_flicker, "apps_bar_scanline_flicker")
    npcd_ui_fx.add_fx_to_manager(scanline_flicker.id, self.flickering_manager and self.flickering_manager.id or nil)
    self.apps_bar_scanline_flickering = scanline_flicker

-- FX: Flickering on Apps Bar
    local flickering = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING)
    flickering.dialog = background
    flickering.speed = 0.02
    npcd_ui_fx.add_fx(flickering, "apps_bar_flickering")
    self.apps_bar_flickering = flickering

    self.app = {}
    self.app[APP.PROFILES] = {}
    self.app[APP.PROFILES].tab = xml:InitStatic("apps_bar:profiles", self.apps_bar)
    xml:InitStatic("apps_bar:profiles:tab_left", self.app[APP.PROFILES].tab)
    self.app[APP.PROFILES].button = xml:Init3tButton("apps_bar:profiles:button", self.app[APP.PROFILES].tab)
    self.app[APP.PROFILES].button:Enable(true)
    self.app[APP.PROFILES].button:TextControl():SetFont(GetFontSmall())
    xml:InitStatic("apps_bar:profiles:tab_right", self.app[APP.PROFILES].tab)
    self:Register(self.app[APP.PROFILES].button, "app_button_" .. APP.PROFILES)

    self.app[APP.PERKS] = {}
    self.app[APP.PERKS].tab = xml:InitStatic("apps_bar:perks", self.apps_bar)
    xml:InitStatic("apps_bar:perks:tab_left", self.app[APP.PERKS].tab)
    self.app[APP.PERKS].button = xml:Init3tButton("apps_bar:perks:button", self.app[APP.PERKS].tab)
    self.app[APP.PERKS].button:Enable(true)
    self.app[APP.PERKS].button:TextControl():SetFont(GetFontSmall())
    xml:InitStatic("apps_bar:perks:tab_right", self.app[APP.PERKS].tab)
    self:Register(self.app[APP.PERKS].button, "app_button_" .. APP.PERKS)

    self.app[APP.DATA] = {}
    self.app[APP.DATA].tab = xml:InitStatic("apps_bar:data", self.apps_bar)
    xml:InitStatic("apps_bar:data:tab_left", self.app[APP.DATA].tab)
    self.app[APP.DATA].button = xml:Init3tButton("apps_bar:data:button", self.app[APP.DATA].tab)
    self.app[APP.DATA].button:Enable(true)
    self.app[APP.DATA].button:TextControl():SetFont(GetFontSmall())
    xml:InitStatic("apps_bar:data:tab_right", self.app[APP.DATA].tab)
    self:Register(self.app[APP.DATA].button, "app_button_" .. APP.DATA)

    Printer:Debug(LOG.INFO, CAT.UI, "Initialising NPCD PDA Dashboard UI Callbacks")
    self:AddCallback("app_button_" .. APP.PROFILES, ui_events.BUTTON_CLICKED, self.On_Profiles_Button_Clicked, self)
    self:AddCallback("app_button_" .. APP.PERKS, ui_events.BUTTON_CLICKED, self.On_Perks_Button_Clicked, self)
    self:AddCallback("app_button_" .. APP.DATA, ui_events.BUTTON_CLICKED, self.On_Data_Button_Clicked, self)

    npcd_ui_fx.resume_fx(self.apps_bar_scanline.id)
end


--------------------------------
--- Item Scroller
--- ----------------------------

function npcd_dashboard_tab:InitItemScroller()

    self.menu_scroller = {}
    self.menu_scroller.ui = {}
    self.menu_scroller.fx = {}
    --------------------------------
    local scroller_dialog = xml:InitStatic("scroller", self)
    self.menu_scroller.ui.dialog = scroller_dialog

    xml:InitStatic("scroller:anchor_top", scroller_dialog)

    --------------------------------
    -- Scroller Background
    --------------------------------
    self.menu_scroller.ui.bg = xml:InitStatic("scroller:scroller_bg", scroller_dialog)
    self.menu_scroller.ui.bg:Show(true)
    self.menu_scroller.ui.glass = xml:InitStatic("scroller:scroller_glass", scroller_dialog)
    self.menu_scroller.ui.glass:Show(false)
-- FX: Showing on scroller background
    local glass_showing = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.SHOWING)
    glass_showing.dialog = self.menu_scroller.ui.glass
    glass_showing.speed = 0.02
    glass_showing.on_showing_complete = {"npcd_pda_dashboard", "items_scroller_glass_showing_fx_stop"}
    npcd_ui_fx.add_fx(glass_showing, "menu_scroller_glass_showing")
    self.menu_scroller.fx.glass_showing = glass_showing

-- FX: Scanlines on scroller
    local scanlines = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.SCANLINES)
    scanlines.dialog = self.menu_scroller.ui.glass
    scanlines.speed = 0.025
    scanlines.random_accel = true
    scanlines.accel_length = 5
    scanlines.margin_v = -5
    scanlines.margin_h = 0
    scanlines.orientation = 1
    npcd_ui_fx.add_fx(scanlines, "menu_scroller_scanlines")
    self.menu_scroller.fx.scanline = scanlines

-- FX: Wide Scanlines on scroller
    local wide_scanlines = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.SCANLINES)
    wide_scanlines.dialog = self.menu_scroller.ui.glass
    wide_scanlines.speed = 0.04
    wide_scanlines.random_accel = false
    wide_scanlines.margin_v = -5
    wide_scanlines.margin_h = 0
    wide_scanlines.orientation = 1
    wide_scanlines.scale = 5
    wide_scanlines.intensity = 0.05
    npcd_ui_fx.add_fx(wide_scanlines, "menu_scroller_wide_scanlines")
    self.menu_scroller.fx.wide_scanline = wide_scanlines

    local wide_scanlines_2 = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.SCANLINES)
    wide_scanlines_2.dialog = self.menu_scroller.ui.glass
    wide_scanlines_2.speed = 0.04
    wide_scanlines_2.random_accel = false
    wide_scanlines_2.margin_v = -5
    wide_scanlines_2.margin_h = 0
    wide_scanlines_2.offset = 0.5
    wide_scanlines_2.orientation = 1
    wide_scanlines_2.scale = 5
    wide_scanlines_2.intensity = 0.05
    npcd_ui_fx.add_fx(wide_scanlines_2, "menu_scroller_wide_scanlines_2")
    self.menu_scroller.fx.wide_scanline_2 = wide_scanlines_2

-- FX: Flickering on scroller
    local flickering = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING)
    flickering.dialog = self.menu_scroller.ui.glass
    flickering.random_duration = {"npcd_pda_dashboard", "items_scroller_glitch_duration"}
    flickering.random_cooldown = {"npcd_pda_dashboard", "items_scroller_glitch_cooldown"}
    npcd_ui_fx.add_fx(flickering, "menu_scroller_flickering")
    self.menu_scroller.fx.flickering = flickering
    npcd_ui_fx.add_fx_to_manager(flickering.id, self.flickering_manager.id)

    self.menu_scroller.ui.dirt = xml:InitStatic("scroller:scroller_dirt", scroller_dialog)

    self.menu_scroller.ui.frame = xml:InitStatic("scroller:scroller_frame", scroller_dialog)
    
    --------------------------------
    --- Scroller Elements
    --------------------------------    
    self.menu_scroller.scroll = xml:InitScrollView("scroller:scroll", self.menu_scroller.ui.bg)
    self.menu_scroller.row = {}

    xml:InitStatic("scroller:anchor_bottom", scroller_dialog)
    self.menu_scroller.ui.dialog:Show(false)
end

function npcd_dashboard_tab:UpdateItemScroller(app_name, menu_name)
    Printer:Debug(LOG.RUN, CAT.UI, "Updating Item Scroller - App: " .. app_name .. " Menu: " .. menu_name)
    self.menu_scroller.ui.dialog:Show(false)
    self.menu_scroller.scroll:Clear()
    local menu_items = get_menu_items(app_name, menu_name)
    -- Printer:DebugTable("Menu Items", menu_items)
    for index, menu_item in ipairs(menu_items or {}) do
        self.menu_scroller.row[index] = {}
        self.menu_scroller.row[index].button = xml:Init3tButton("scroller:item_button", nil)
        self.menu_scroller.scroll:AddWindow(self.menu_scroller.row[index].button, true)
        self:Register(self.menu_scroller.row[index].button, "item_scroller_button_" .. index)
        self:AddCallback("item_scroller_button_" .. index, ui_events.BUTTON_CLICKED, function ()
            local selected = self.menu_scroller.selected
            if selected and self.menu_scroller.row[selected] then
                self.menu_scroller.row[selected].button:TextControl():SetFont(GetFontSmall())
                self.menu_scroller.row[selected].button:Enable(true)
            end
            self.menu_scroller.selected = index
            self.menu_scroller.row[index].button:Enable(false)
            self.menu_scroller.row[index].button:TextControl():SetFont(GetFontMedium())
            local menu_item = self.menu_scroller.row[index].menu_item
            self:OnClickScrollerItem(menu_item.app_name, menu_item.id)
            Printer:Debug(LOG.INFO, CAT.UI, "Item Scroller Button Clicked - Item[%s]: " .. menu_item.name, menu_item.idx)
        end, self)
        Printer:Debug(LOG.ADD, CAT.UI, "Item Scroller Row Created - Index: " .. index)
        menu_item.app_name = app_name
        self.menu_scroller.row[index].menu_item = menu_item
        self.menu_scroller.row[index].button:TextControl():SetText(index .. ". " .. gc(menu_item.name) or menu_item.name)
        self.menu_scroller.row[index].button:TextControl():SetFont(GetFontSmall())
    end
    -- Printer:DebugTable("Item Scroller Rows", self.menu_scroller.row)
    if #menu_items == 1 then
        self.menu_scroller.row[1].button:Enable(true)
    end
    self.menu_scroller.ui.dialog:Show(true)
end

function npcd_dashboard_tab:ResetItemScroller()
    Printer:Debug(LOG.REMOVE, CAT.UI, "Resetting Item Scroller")
    -- self:ResetNPCPanel()
    if self.menu_scroller.scroll then
        self.menu_scroller.scroll:Clear()
    end
    self.menu_scroller.selected = nil
    self.menu_scroller.ui.dialog:Show(false)
end

function items_scroller_glitch_duration()
    return time_global() + math.random(10, 50) * 5
end

function items_scroller_glitch_cooldown()
    local cooldown = math.random(50, 100) * 100
    -- Printer:Debug(LOG.INFO, CAT.UI, "Items Scroller Glitch Cooldown set to " .. cooldown .. " ms")
    -- Printer:Debug(LOG.INFO, CAT.UI, "Items Scroller Glitch will be ready at " .. (time_global() + cooldown) .. " ms")
    return time_global() + cooldown
end

function items_scroller_glass_showing_fx_stop()
    Printer:Debug(LOG.INFO, CAT.UI, "Items Scroller BG Showing FX Stopped")
    local ui = get_ui()
    if ui then
        Printer:Debug(LOG.INFO, CAT.UI, "Forcing Items Scroller Flickering FX to start")
        npcd_ui_fx.resume_fx(ui.menu_scroller.fx.flickering.id)
        ui.menu_scroller.fx.flickering.force = 500 -- 0.5 seconds
        npcd_ui_fx.resume_fx(ui.menu_scroller.fx.scanline.id)
        npcd_ui_fx.resume_fx(ui.menu_scroller.fx.wide_scanline.id)
        npcd_ui_fx.resume_fx(ui.menu_scroller.fx.wide_scanline_2.id)
        ui.menu_scroller.ui.bg:Show(true)
    end
end

--------------------------------
--- Panel Info
--- ----------------------------

-- called by item scroller when an item is selected or when we enter a new menu
function npcd_dashboard_tab:OnClickScrollerItem(app_name, item_id)
    Printer:Debug(LOG.INFO, CAT.UI, "Requested Updating Item Panel - App: " .. app_name .. " Item ID: " .. item_id)
    if app_name == APP.PROFILES then
        if not self.npc_panel.init then
            self:InitNPCPanel(item_id)
        else
            self:UpdateNPCPanel(item_id)
        end
    end
end

--- NPC Panel Info
--- ----------------------------

function npcd_dashboard_tab:InitNPCPanelInfo()
    Printer:Debug(LOG.INFO, CAT.UI, "Init NPC Panel Info ")

    self.npc_panel = {}
    local npc_panel = xml:InitStatic("npc_panel", self)
    self.npc_panel.dialog = npc_panel
    self.npc_panel.dialog:Show(false)

    --------------------------------
    -- info terminal
    -- ------------------------------
    self.npc_panel.info = {}
    local info = xml:InitStatic("npc_panel:info", npc_panel)
    self.npc_panel.info.dialog = info

    local info_terminal = npcd_ui_fx.get_sfx_config(npcd_ui_fx.SFX.VIDEO_TERMINAL, "npc_info_terminal")
    info_terminal.name = "NPC Info Terminal"
    info_terminal.group = "npc_info_fx"
    info_terminal.xml_init = "npcd_pda_dashboard.xml"
    info_terminal.parent = info
    info_terminal.display = "npc_panel:info:terminal_display"

    --------------------------------
    -- Content
    -- ------------------------------
    local info_content = xml:InitStatic("npc_panel:info:terminal_display:content", nil)
    self.npc_panel.info.content = {}
    self.npc_panel.info.content.dialog = info_content
    info_terminal.content = info_content
    info_terminal.on_content_displayed_callback = { functor = self.UpdateInfoTerminalDisplay, self = self}

-- FX: Flickering Manager for content elements
    self.npc_panel.info.content.fx = {}
    self.npc_panel.info.content.fx.flickering_manager = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING_MANAGER)
    npcd_ui_fx.add_fx(self.npc_panel.info.content.fx.flickering_manager, "npc_info_content_flickering_manager")

    -- Id Card
    -- ------------------------------
    self.npc_panel.info.content.idcard = {}
    local idcard = xml:InitStatic("npc_panel:info:terminal_display:content:idcard", info_content)
    self.npc_panel.info.content.idcard.dialog = idcard

    -- Idcard Group
    -- -----------------------------
    local idcard_group = xml:InitStatic("npc_panel:info:idcard_group", idcard)
    self.npc_panel.info.content.idcard.portrait = xml:InitStatic("npc_panel:info:idcard_group:portrait", idcard_group)
    self.npc_panel.info.content.idcard.name = xml:InitTextWnd("npc_panel:info:idcard_group:name", idcard_group)
    self.npc_panel.info.content.idcard.community = xml:InitTextWnd("npc_panel:info:idcard_group:community", idcard_group)

    self.npc_panel.info.content.idcard.favorite = xml:Init3tButton("npc_panel:info:idcard_group:favorite", idcard_group)
    -- self.npc_panel.info.content.idcard.favorite:InitTexture("ui_npcd_pda_npc_detail_info_favorite_button")

    self.npc_panel.info.content.idcard.unfavorite = xml:Init3tButton("npc_panel:info:idcard_group:unfavorite", idcard_group)
    -- self.npc_panel.info.content.idcard.unfavorite:InitTexture("ui_npcd_pda_npc_detail_info_unfavorite_button")

    self:Register(self.npc_panel.info.content.idcard.favorite, "npc_panel_idcard_favorite_button")
    self:AddCallback("npc_panel_idcard_favorite_button", ui_events.BUTTON_CLICKED, function ()
        npcd.set_favorite(self.npc_panel.npc_id, true)
        self.npc_panel.info.content.idcard.favorite:Show(false)
        self.npc_panel.info.content.idcard.unfavorite:Show(true)
        Printer:Debug(LOG.INFO, CAT.UI, "NPC ID " .. self.npc_panel.npc_id .. " added to favorites")
    end, self)
    self.npc_panel.info.content.idcard.favorite:Show(false)

    self:Register(self.npc_panel.info.content.idcard.unfavorite, "npc_panel_idcard_unfavorite_button")
    self:AddCallback("npc_panel_idcard_unfavorite_button", ui_events.BUTTON_CLICKED, function ()
        npcd.set_favorite(self.npc_panel.npc_id, false)
        self.npc_panel.info.content.idcard.favorite:Show(true)
        self.npc_panel.info.content.idcard.unfavorite:Show(false)
        Printer:Debug(LOG.INFO, CAT.UI, "NPC ID " .. self.npc_panel.npc_id .. " removed from favorites")
    end, self)
    self.npc_panel.info.content.idcard.unfavorite:Show(false)

    self.npc_panel.info.content.idcard.locked = xml:InitStatic("npc_panel:info:idcard_group:lock", idcard_group)
    self.npc_panel.info.content.idcard.locked:InitTexture("ui_npcd_pda_npc_detail_info_locked")
    self.npc_panel.info.content.idcard.locked:Show(false)
    self.npc_panel.info.content.idcard.unlocked = xml:InitStatic("npc_panel:info:idcard_group:lock", idcard_group)
    self.npc_panel.info.content.idcard.unlocked:InitTexture("ui_npcd_pda_npc_detail_info_unlocked")
    self.npc_panel.info.content.idcard.unlocked:Show(false)

-- FX: Showing on portrait
    local showing = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.SHOWING)
    showing.dialog = self.npc_panel.info.content.idcard.portrait
    showing.speed = 0.005
    -- showing.on_showing_complete = {"npcd_pda_dashboard", "npc_panel_info_showing_fx_stop"}
    npcd_ui_fx.add_fx(showing, "npc_panel_info_portrait_showing")
    self.npc_panel.info.content.fx.portrait_showing = showing
-- FX: Flickering on portrait
    local flickering = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING)
    flickering.dialog = self.npc_panel.info.content.idcard.portrait
    flickering.intensity = 0.65
    flickering.max_intensity = 0.9
    flickering.random_duration = {"npcd_pda_dashboard", "items_scroller_glitch_duration"}
    flickering.random_cooldown = {"npcd_pda_dashboard", "items_scroller_glitch_cooldown"}
    npcd_ui_fx.add_fx(flickering, "npc_panel_info_portrait_flickering")
    self.npc_panel.info.content.fx.portrait_flickering = flickering
    npcd_ui_fx.add_fx_to_manager(flickering.id, self.npc_panel.info.content.fx.flickering_manager.id)

    -- Characteristics
    -- ------------------------------
    self.npc_panel.info.content.npc_info_group = {}
    local npc_info_group = xml:InitStatic("npc_panel:info:terminal_display:content:npc_info_group", info_content)
    self.npc_panel.info.content.npc_info_group.dialog = npc_info_group


    -- char frame
    -- ------------------------------
    local char_frame = xml:InitStatic("npc_panel:info:char_frame", npc_info_group)
    xml:InitStatic("npc_panel:info:char_frame:vseparator", char_frame)
    xml:InitStatic("npc_panel:info:char_frame:top_line", char_frame)
    xml:InitStatic("npc_panel:info:char_frame:char_bg", char_frame)
    self.npc_panel.info.content.npc_info_group.header = xml:InitTextWnd("npc_panel:info:char_frame:char_header", char_frame)
    xml:InitStatic("npc_panel:info:char_frame:bottom_line", char_frame)

    -- characteristics group
    -- ------------------------------
    self.npc_panel.info.content.characteristics = {}
    local char_group = xml:InitFrame("npc_panel:info:char_frame:char_group", char_frame)
    self.npc_panel.info.content.characteristics.dialog = char_group
    local i = 1
    local x_offset = 0
    for _, char_name in pairs(NPCS_CHARACTERISTICS) do
        self.npc_panel.info.content.characteristics[char_name.id] = {}
        local icon = xml:InitStatic("npc_panel:info:char_frame:char_group:ico", char_group)
        self.npc_panel.info.content.characteristics[char_name.id].icon = icon
        self.npc_panel.info.content.characteristics[char_name.id].icon:InitTexture(char_name.ico)
        self.npc_panel.info.content.characteristics[char_name.id].icon:SetWndPos(vector2():set(icon:GetWndPos().x + x_offset, icon:GetWndPos().y + i * icon:GetHeight()))
        local label = xml:InitTextWnd("npc_panel:info:char_frame:char_group:label", char_group)
        self.npc_panel.info.content.characteristics[char_name.id].label = label
        self.npc_panel.info.content.characteristics[char_name.id].label:SetText(gc(char_name.label))
        self.npc_panel.info.content.characteristics[char_name.id].label:SetFont(GetFontSmall())
        self.npc_panel.info.content.characteristics[char_name.id].label:SetWndPos(vector2():set(label:GetWndPos().x + x_offset, label:GetWndPos().y + i * icon:GetHeight()))

        local value = xml:InitTextWnd("npc_panel:info:char_frame:char_group:value", char_group)
        self.npc_panel.info.content.characteristics[char_name.id].value = value
        self.npc_panel.info.content.characteristics[char_name.id].value:SetText("")
        self.npc_panel.info.content.characteristics[char_name.id].value:SetWndPos(vector2():set(value:GetWndPos().x + x_offset, value:GetWndPos().y + i * icon:GetHeight()))
        self.npc_panel.info.content.characteristics[char_name.id].value:SetFont(GetFontSmall())
        i = i + 1
        if i > 6 then
            i = 1
            x_offset = x_offset + 105
        end
    end

    -- data group
    self.npc_panel.info.content.data = {}
    local data_group = xml:InitFrame("npc_panel:info:char_frame:char_group", char_frame)
    self.npc_panel.info.content.data.dialog = data_group
    i = 1
    x_offset = 0
    for _, data in ipairs(NPC_INFO_GROUP_LIST[NPC_INFO_GROUP.DATA]) do
        self.npc_panel.info.content.data[data.id] = {}
        local label = xml:InitTextWnd("npc_panel:info:char_frame:char_group:label", data_group)
        self.npc_panel.info.content.data[data.id].label = label
        self.npc_panel.info.content.data[data.id].label:SetText(gc(data.label))
        self.npc_panel.info.content.data[data.id].label:SetWndPos(vector2():set(label:GetWndPos().x - 20 + x_offset, label:GetWndPos().y + i * label:GetHeight()))
        local value = xml:InitTextWnd("npc_panel:info:char_frame:char_group:value1", data_group)
        self.npc_panel.info.content.data[data.id].value = value
        self.npc_panel.info.content.data[data.id].value:SetWndPos(vector2():set(value:GetWndPos().x + x_offset, value:GetWndPos().y + i * value:GetHeight()))
        self.npc_panel.info.content.data[data.id].value:SetText("")
        i = i + 1
        if i > 6 then
            i = 1
            x_offset = x_offset + 105
        end        
    end
    self.npc_panel.info.content.data.dialog:Show(false)
    
    -- statistics group
    self.npc_panel.info.content.statistics = {}
    local stats_group = xml:InitFrame("npc_panel:info:char_frame:char_group", char_frame)
    self.npc_panel.info.content.statistics.dialog = stats_group
    i = 1
    x_offset = 0
    for _, stat in ipairs(NPC_INFO_GROUP_LIST[NPC_INFO_GROUP.TRACKING]) do
        self.npc_panel.info.content.statistics[stat.id] = {}
        local label = xml:InitTextWnd("npc_panel:info:char_frame:char_group:label", stats_group)
        self.npc_panel.info.content.statistics[stat.id].label = label
        self.npc_panel.info.content.statistics[stat.id].label:SetWndPos(vector2():set(label:GetWndPos().x - 20 + x_offset, label:GetWndPos().y + i * label:GetHeight()))
        self.npc_panel.info.content.statistics[stat.id].label:SetText(gc(stat.label))
        local value 
        if stat.id == "last_place_seen" or stat.id == "last_place_tracked" then
            value = xml:InitTextWnd("npc_panel:info:char_frame:char_group:value2", stats_group)
            value:SetWndPos(vector2():set(value:GetWndPos().x + 50 + x_offset, value:GetWndPos().y + i * value:GetHeight()))
            i = i + 1
        else
            value = xml:InitTextWnd("npc_panel:info:char_frame:char_group:value2", stats_group)
            value:SetWndPos(vector2():set(value:GetWndPos().x + 50 + x_offset, value:GetWndPos().y + i * value:GetHeight()))
        end
        value:SetText("")
        i = i + 1
        self.npc_panel.info.content.statistics[stat.id].value = value
        if i > 6 then
            i = 1
            x_offset = x_offset + 105
        end
    end
    self.npc_panel.info.content.statistics.dialog:Show(false)

    -- standings group
    self.npc_panel.info.content.standings = {}
    local standings_group = xml:InitFrame("npc_panel:info:char_frame:char_group", char_frame)
    self.npc_panel.info.content.standings.dialog = standings_group
    i = 1
    x_offset = 0
    for _, standing in ipairs(NPC_INFO_GROUP_LIST[NPC_INFO_GROUP.STANDINGS]) do
        self.npc_panel.info.content.standings[standing.id] = {}
        local label = xml:InitTextWnd("npc_panel:info:char_frame:char_group:label", standings_group)
        self.npc_panel.info.content.standings[standing.id].label = label
        self.npc_panel.info.content.standings[standing.id].label:SetWndPos(vector2():set(label:GetWndPos().x - 20 + x_offset, label:GetWndPos().y + i * label:GetHeight()))
        self.npc_panel.info.content.standings[standing.id].label:SetText(gc(standing.label))
        local value
        if standing.id == "relation" then
            value = xml:InitTextWnd("npc_panel:info:char_frame:char_group:value_cx", standings_group)
        else
            value = xml:InitTextWnd("npc_panel:info:char_frame:char_group:value1", standings_group)
        end
        self.npc_panel.info.content.standings[standing.id].value = value
        self.npc_panel.info.content.standings[standing.id].value:SetWndPos(vector2():set(value:GetWndPos().x + x_offset, value:GetWndPos().y + i * value:GetHeight()))
        self.npc_panel.info.content.standings[standing.id].value:SetText("")
        i = i + 1
        if i > 6 then
            i = 1
            x_offset = x_offset + 105
        end        
    end
    self.npc_panel.info.content.standings.dialog:Show(false)

-- FX: Flickering on characteristics group
    local char_flickering = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING)
    char_flickering.dialog = self.npc_panel.info.content.npc_info_group.dialog
    npcd_ui_fx.add_fx(char_flickering, "npc_panel_info_characteristics_flickering")
    self.npc_panel.info.content.fx.char_flickering = char_flickering

    self.npc_panel.info.content.npc_info_group.dialog:Show(false)

    --------------------------------
    -- frame
    -- ------------------------------
    self.npc_panel.info.frame = xml:InitStatic("npc_panel:info:info_frame", info)
    self.npc_panel.info.frame:Show(true)

    -- glass and dirt
    info_terminal.glass = "npc_panel:info:terminal_display:terminal_glass"
    info_terminal.dirt = "npc_panel:info:terminal_display:terminal_glass:terminal_dirt"

    self.npc_panel.info.rank = xml:InitTextWnd("npc_panel:info:rank", info)
    self.npc_panel.info.rank_cap = xml:InitTextWnd("npc_panel:info:rank_cap", info)

    self.npc_panel.info.toggle = xml:Init3tButton("npc_panel:info:toggle", info)
    self.npc_panel.info.toggle:TextControl():SetFont(GetFontSmall())
    self.npc_panel.info.toggle_state = NPC_INFO_GROUP.CHARACTERISTICS
    self.npc_panel.info.toggle:TextControl():SetText(self.npc_panel.info.toggle_state)
    self:Register(self.npc_panel.info.toggle, "npc_panel_info_toggle_button")
    self:AddCallback("npc_panel_info_toggle_button", ui_events.BUTTON_CLICKED, function ()
        -- cycle through the NPC_INFO_GROUPS on each click
        if self.npc_panel.info.toggle_state == NPC_INFO_GROUP.CHARACTERISTICS then
            self:UpdateInfoGroup(NPC_INFO_GROUP.DATA)
        elseif self.npc_panel.info.toggle_state == NPC_INFO_GROUP.DATA then
            self:UpdateInfoGroup(NPC_INFO_GROUP.TRACKING)
        elseif self.npc_panel.info.toggle_state == NPC_INFO_GROUP.TRACKING then
            self:UpdateInfoGroup(NPC_INFO_GROUP.STANDINGS)
        elseif self.npc_panel.info.toggle_state == NPC_INFO_GROUP.STANDINGS then
            self:UpdateInfoGroup(NPC_INFO_GROUP.CHARACTERISTICS)
        end
    end, self)
    
    -- instantiate the terminal
    -- ------------------------------
    self.npc_panel.info.terminal = npcd_ui_fx.SFXVideoTerminal_Create(info_terminal, self)
    
    self.npc_panel.info.dialog:Show(true)

    --------------------------------
    -- specs panel
    -- ------------------------------  
    self.npc_panel.specs = {}
    local specs = xml:InitStatic("npc_panel:specs", npc_panel)
    self.npc_panel.specs.dialog = specs
    self.npc_panel.specs.dialog:Show(true)

    --------------------------------
    -- specs terminal
    -- ------------------------------
    local specs_terminal = npcd_ui_fx.get_sfx_config(npcd_ui_fx.SFX.VIDEO_TERMINAL, "npc_specs_terminal")
    specs_terminal.name = "NPC Specs Terminal"
    specs_terminal.group = "npc_specs_fx"
    specs_terminal.xml_init = "npcd_pda_dashboard.xml"
    specs_terminal.parent = specs
    specs_terminal.display = "npc_panel:specs:terminal_display"
    specs_terminal.display_showing = 0 -- from middle
    specs_terminal.start_timer = 0.45

    -- tabs
    -- ------------------------------
    specs_terminal.tabs = {}
    specs_terminal.tabs.frame = "npc_panel:specs:terminal_tabs"
    specs_terminal.tabs.auto_orient = true
    specs_terminal.tabs.orient = 0
    specs_terminal.tabs.button = "npc_panel:specs:terminal_tabs:button"
    specs_terminal.tabs.spacing = 10
    specs_terminal.tabs.positional_spacing = 1
    specs_terminal.tabs.tab = {}
    for i, spec_data in ipairs(TERMINAL_TABS) do
        specs_terminal.tabs.tab[i] = {}
        specs_terminal.tabs.tab[i].name = spec_data.name
        specs_terminal.tabs.tab[i].default = spec_data.default or false
        specs_terminal.tabs.tab[i].label = spec_data.label
        specs_terminal.tabs.tab[i].on_click_callback = { functor = self.OnTerminalTabClicked, self = self}
    end

    -- header
    -- ------------------------------
    local specs_header = xml:InitStatic("npc_panel:specs:terminal_display:header", nil)
    self.npc_panel.specs.header = {}
    self.npc_panel.specs.header.dialog = specs_header
    self.npc_panel.specs.header.top_line = xml:InitStatic("npc_panel:specs:terminal_display:header:top_line", specs_header)
    self.npc_panel.specs.header.background = xml:InitStatic("npc_panel:specs:terminal_display:header:background", specs_header)
    self.npc_panel.specs.header.content = xml:InitStatic("npc_panel:specs:terminal_display:header:content", specs_header)
    local label = xml:InitTextWnd("npc_panel:specs:terminal_display:header:content:label", self.npc_panel.specs.header.content)
    specs_terminal.header = specs_header

    -- content
    -- ------------------------------
    local specs_content = xml:InitStatic("npc_panel:specs:terminal_display:content", nil)
    self.npc_panel.specs.content = {}
    self.npc_panel.specs.content.dialog = specs_content
    self.npc_panel.specs.content.scroll = xml:InitScrollView("npc_panel:specs:terminal_display:content:scroll", specs_content)
    self.npc_panel.specs.content.scroll.row = {}
    self.npc_panel.specs.content.scroll:Show(false)
    specs_terminal.content = specs_content
    specs_terminal.on_content_displayed_callback = { functor = self.UpdateSpecsTerminalDisplay, self = self}

    -- frame
    self.npc_panel.specs.frame = xml:InitStatic("npc_panel:specs:specs_frame", specs)
    self.npc_panel.specs.frame:Show(true)

    -- glass and dirt
    specs_terminal.glass = "npc_panel:specs:terminal_display:terminal_glass"
    -- specs_terminal.dirt = "npc_panel:specs:terminal_display:terminal_glass:terminal_dirt"

    -- instantiate the terminal
    -- ------------------------------
    self.npc_panel.specs.terminal = npcd_ui_fx.SFXVideoTerminal_Create(specs_terminal, self)
    
    self.npc_panel.specs.content.hints = {}
    self.npc_panel.specs.content.talent_section = {}
    for _, section_name in pairs(npcd.FEAT_TYPE) do
        self.npc_panel.specs.content.talent_section[section_name] = {}
        self.npc_panel.specs.content.talent_section[section_name].show = true
    end
    self.npc_panel.specs.content.update_talent_scroll = nil
    self.npc_panel.specs.header.talents_view = VIEW.GROUPED
    -- self.npc_panel.info.dialog:Show(false)
end

function npcd_dashboard_tab:ClearInfoTerminalDisplay()
    Printer:Debug(LOG.REMOVE, CAT.UI, "Clearing NPC Panel Info Display")
    self.npc_panel.info.content.dialog:Show(false)
    self.npc_panel.info.content.idcard.dialog:Show(false)
    self.npc_panel.info.content.npc_info_group.dialog:Show(false)
    self:UpdateInfoGroup(NPC_INFO_GROUP.CHARACTERISTICS)
end

function npcd_dashboard_tab:UpdateInfoTerminalDisplay(npc_id)
    if npc_id == nil then
        npc_id = self.npc_panel.npc_id
        self.npc_panel.info.content.dialog:Show(true)
        self.npc_panel.info.content.idcard.portrait:Show(true)
        self.npc_panel.info.content.idcard.dialog:Show(true)
        self.npc_panel.info.content.idcard.name:Show(true)
        self.npc_panel.info.content.idcard.community:Show(true)
        self.npc_panel.info.content.npc_info_group.dialog:Show(true)
        self.npc_panel.info.toggle_state = NPC_INFO_GROUP.CHARACTERISTICS
    end
    Printer:Debug(LOG.RUN, CAT.UI, "Updating NPC Panel Info - NPC ID: " .. npc_id)
    -- Update the NPC panel info with the new NPC data
    local npc_data = npcd.get_npc_data(npc_id)
    if npc_data then
        self.npc_panel.info.content.idcard.portrait:InitTexture(npc_data.icon)
        self.npc_panel.info.content.idcard.portrait:Show(false)
        self.npc_panel.info.content.idcard.name:SetText(npc_data.name)
        self.npc_panel.info.content.idcard.community:SetText(npc_data.community)
        if npcd.get_favorite(npc_id) then
            self.npc_panel.info.content.idcard.favorite:Show(false)
            self.npc_panel.info.content.idcard.unfavorite:Show(true)
        else
            self.npc_panel.info.content.idcard.favorite:Show(true)
            self.npc_panel.info.content.idcard.unfavorite:Show(false)
        end
        self.npc_panel.info.rank:SetText(npc_data.perk_rank)
        -- self.npc_panel.info.rank:SetFont(GetFontMedium())

        -- update data group
        self.npc_panel.info.content.data["id"].value:SetText(npc_data.id)
        self.npc_panel.info.content.data["community"].value:SetText(npc_data.community)
        self.npc_panel.info.content.data["rank"].value:SetText(tostring(npc_data.rank))
        self.npc_panel.info.content.data["reputation"].value:SetText(tostring(npc_data.reputation))
        self.npc_panel.info.content.data["squad_id"].value:SetText(tostring(npc_data.squad_id))
        self.npc_panel.info.content.data["squad_commander"].value:SetText(npc_data.squad_commander)

        -- update standings group
        self.npc_panel.info.content.standings["attitude"].value:SetText(tostring(npc_data.standings.attitude))
        self.npc_panel.info.content.standings["relation"].value:SetText(npcd_relations.get_relation_desc(npc_data.standings.relation))
        self.npc_panel.info.content.standings["goodwill_personal"].value:SetText(tostring(npc_data.standings.goodwill_personal))
        self.npc_panel.info.content.standings["goodwill_actor_faction"].value:SetText(tostring(npc_data.standings.goodwill_actor_faction))
    end

    local npc_deck = npcd.get_npc(npc_id)
    -- Printer:DebugTable("NPC DECK", npc_deck)
    if npc_deck then
        for name, value in pairs(npc_deck.Characteristics or {}) do
            Printer:Debug(LOG.INFO, CAT.UI, "NPC Characteristic[" .. name .. "]: " .. value)
            if self.npc_panel.info.content.characteristics[name] then
                self.npc_panel.info.content.characteristics[name].value:SetText(tostring(value) or "null")
            end
        end
        if not npc_deck.show_profile then
            Printer:Debug(LOG.INFO, CAT.UI, "NPC Profile Locked")
            self.npc_panel.info.content.idcard.locked:Show(true)
            self.npc_panel.info.content.idcard.unlocked:Show(false)
        else
            Printer:Debug(LOG.INFO, CAT.UI, "NPC Profile Unlocked")
            self.npc_panel.info.content.idcard.locked:Show(false)
            self.npc_panel.info.content.idcard.unlocked:Show(true)
        end

        -- cont data group
        self.npc_panel.info.content.data["alive"].value:SetText(tostring(npc_deck.alive))
        self.npc_panel.info.content.data["recruitable"].value:SetText(tostring(npc_deck.Info.can_recruit))
        
        -- statistics group
        self.npc_panel.info.content.statistics["last_joined"].value:SetText(npcdu.format_npc_time(npc_deck.Info.last_joined))
        self.npc_panel.info.content.statistics["last_time_seen"].value:SetText(npcdu.format_npc_time(npc_deck.Info.last_time_seen))
        self.npc_panel.info.content.statistics["last_place_seen"].value:SetText(npc_deck.Info.last_place_seen or "")
        self.npc_panel.info.content.statistics["last_place_tracked"].value:SetText(npc_deck.Info.last_place_tracked or "")
        self.npc_panel.info.content.data["codec_frequency"].value:SetText(tostring(""))

    end
    self:UpdateInfoGroup(self.npc_panel.info.toggle_state)
    self.npc_panel.info.content.fx.char_flickering.flickering_duration = 100
    npcd_ui_fx.resume_fx(self.npc_panel.info.content.fx.char_flickering.id)
    npcd_ui_fx.resume_fx(self.npc_panel.info.content.fx.portrait_showing.id)
end

function npcd_dashboard_tab:UpdateInfoGroup(state)
    Printer:Debug(LOG.RUN, CAT.UI, "Updating NPC Info Group to: " .. state)
    self.npc_panel.info.toggle_state = state
    self.npc_panel.info.toggle:TextControl():SetText(self.npc_panel.info.toggle_state)
    if state == NPC_INFO_GROUP.CHARACTERISTICS then
        Printer:Debug(LOG.RUN, CAT.UI, "Showing Characteristics Group")
        self.npc_panel.info.content.data.dialog:Show(false)
        self.npc_panel.info.content.statistics.dialog:Show(false)
        self.npc_panel.info.content.standings.dialog:Show(false)
        self.npc_panel.info.content.characteristics.dialog:Show(true)
        self.npc_panel.info.content.npc_info_group.header:SetText(gc("ui_npcd_npc_info_characteristics"))
    elseif state == NPC_INFO_GROUP.DATA then
        Printer:Debug(LOG.RUN, CAT.UI, "Showing Data Group")
        self.npc_panel.info.content.characteristics.dialog:Show(false)
        self.npc_panel.info.content.statistics.dialog:Show(false)
        self.npc_panel.info.content.standings.dialog:Show(false)
        self.npc_panel.info.content.data.dialog:Show(true)
        self.npc_panel.info.content.npc_info_group.header:SetText(gc("ui_npcd_npc_info_data"))
    elseif state == NPC_INFO_GROUP.TRACKING then
        Printer:Debug(LOG.RUN, CAT.UI, "Showing Tracking Group")
        self.npc_panel.info.content.characteristics.dialog:Show(false)
        self.npc_panel.info.content.data.dialog:Show(false)
        self.npc_panel.info.content.standings.dialog:Show(false)
        self.npc_panel.info.content.statistics.dialog:Show(true)
        self.npc_panel.info.content.npc_info_group.header:SetText(gc("ui_npcd_npc_info_tracking"))
    elseif state == NPC_INFO_GROUP.STANDINGS then
        Printer:Debug(LOG.RUN, CAT.UI, "Showing Standings Group")
        self.npc_panel.info.content.characteristics.dialog:Show(false)
        self.npc_panel.info.content.data.dialog:Show(false)
        self.npc_panel.info.content.statistics.dialog:Show(false)
        self.npc_panel.info.content.standings.dialog:Show(true)
        self.npc_panel.info.content.npc_info_group.header:SetText(gc("ui_npcd_npc_info_standings"))
    else
        Printer:Debug(LOG.WARN, CAT.UI, "Unknown NPC Info Group State: " .. state)
    end
end

function npcd_dashboard_tab:OnTerminalTabClicked(tab_index, spec_name)
    Printer:Debug(LOG.RUN, CAT.UI, "NPC Panel Specs Tab " .. tab_index .. " Clicked - Spec: " .. spec_name)
    self:UpdateSpecsTerminalDisplay(spec_name, self.npc_panel.npc_id)
end

function npcd_dashboard_tab:__ClearSpecsTerminalDisplay()
    Printer:Debug(LOG.REMOVE, CAT.UI, "Clearing NPC Panel Specs Display")
    if not self.npc_panel.specs.content then return end
    local scroll = self.npc_panel.specs.content.scroll
    scroll:Show(false)
    scroll:Clear()
    self:__ClearSpecsTabScrollRows()
    UI_DETAILS.dialog:Show(false)
    self.show_hint = true
    UI_DETAILS.rank = nil
end

function npcd_dashboard_tab:__ClearSpecsTabScrollRows()
    Printer:Debug(LOG.REMOVE, CAT.UI, "Clearing NPC Panel Specs Scroll Rows")
    for _, row in pairs(self.npc_panel.specs.content.scroll.row or {}) do
        row.button:Show(false)
        row.button = nil
    end
    self.npc_panel.specs.content.scroll.row = {}

    for _, talent in pairs(self.npc_panel.specs.content.talents or {}) do
        talent.talent_icon:Show(false)
        talent.talent_icon = nil
    end
    self.npc_panel.specs.content.talents = {}
    self.npc_panel.specs.content.hints = {}
end

function npcd_dashboard_tab:UpdateSpecsTerminalDisplay(spec_name, npc_id)
    Printer:Debug(LOG.RUN, CAT.UI, "Updating Specs Terminal Display - Spec: %s NPC ID: %s", spec_name, npc_id)
    self.npc_panel.specs.active_spec = spec_name
    --- setup when no params are passed (init callback from terminal)
    if spec_name == nil or npc_id == nil then
        spec_name = TERMINAL_TABS_UTIL.get_default_tab().name
        npc_id = self.npc_panel.npc_id
    end
    self.npc_panel.specs.content.hints = {}
    --------------------------------
    --- clears content
    --- ------------------------------

    if spec_name == SPECS.ABILITIES then
        Printer:Debug(LOG.INFO, CAT.UI, "Updating Abilities Spec Content")
        -- update the header
        self.npc_panel.specs.header.dialog:Show(true)
        self.npc_panel.specs.header.content:Show(false)
        self.npc_panel.specs.header.content = xml:InitStatic("npc_panel:specs:terminal_display:header:content", self.npc_panel.specs.header.dialog)
        local label = xml:InitTextWnd("npc_panel:specs:terminal_display:header:content:label", self.npc_panel.specs.header.content)
        -- local type = xml:InitTextWnd("npc_panel:specs:ability:h_type", self.npc_panel.specs.header.content)
        local mode = xml:InitTextWnd("npc_panel:specs:ability:h_mode", self.npc_panel.specs.header.content)
        local source = xml:InitTextWnd("npc_panel:specs:ability:h_source", self.npc_panel.specs.header.content)
        local rank = xml:InitTextWnd("npc_panel:specs:ability:h_rank", self.npc_panel.specs.header.content)
        label:SetText(TERMINAL_TABS_UTIL.get_label(spec_name))
        self.npc_panel.specs.header.content:Show(true)
        --------------------------------
        -- update the content
        -- --------------------------------

        -- update the scroll
        local scroll = self.npc_panel.specs.content.scroll
        scroll:Show(false)
        scroll:Clear()
        self:__ClearSpecsTabScrollRows()
        local npc_deck = npcd.get_npc(npc_id)
        -- Printer:DebugTable("NPC Abilities", npc_deck.Ability)
        if npc_deck and npc_deck.show_profile then
            local index = 0
            for _, ability in pairs(npc_deck.Ability) do
                local feat = npcd.get_ability_feat(ability.id)
                if feat.type == npcd.FEAT_TYPE.ACTIVE  then
                    self:__CreateAbilityRow(npc_id, feat, scroll, index)
                    index = index + 1
                end
            end
        end
        scroll:Show(true)
    end
    if spec_name == SPECS.TALENTS then

        --------------------------------
        --- update the header
        --------------------------------
        self.npc_panel.specs.header.dialog:Show(true)
        self.npc_panel.specs.header.content:Show(false)
        self.npc_panel.specs.header.content = xml:Init3tButton("npc_panel:specs:terminal_display:header:button", self.npc_panel.specs.header.dialog)
        if self.npc_panel.specs.header.talents_view == VIEW.GROUPED then
            Printer:Debug(LOG.INFO, CAT.UI, "Setting Talents View to GROUPED")
            self.npc_panel.specs.header.content:InitTexture(UI_TALENTS_VIEW[VIEW.GROUPED].icon)
            self.npc_panel.specs.header.content:TextControl():SetText(gc(UI_TALENTS_VIEW[VIEW.GROUPED].desc))
        else
            Printer:Debug(LOG.INFO, CAT.UI, "Setting Talents View to ALL")
            self.npc_panel.specs.header.content:InitTexture(UI_TALENTS_VIEW[VIEW.ALL].icon)
            self.npc_panel.specs.header.content:TextControl():SetText(gc(UI_TALENTS_VIEW[VIEW.ALL].desc))
        end
        local id = "talents_view" .. spec_name -- .. "_" .. math.random(1000,9999)
        self:Register(self.npc_panel.specs.header.content, id)
        self:AddCallback(id, ui_events.BUTTON_CLICKED, function ()
            Printer:Debug(LOG.INFO, CAT.UI, "Toggling Talents View Mode")
            if self.npc_panel.specs.header.talents_view == VIEW.GROUPED then
                self.npc_panel.specs.header.talents_view = VIEW.ALL
            else
                self.npc_panel.specs.header.talents_view = VIEW.GROUPED
            end
            self.npc_panel.specs.content.update_talent_scroll = true
            self.npc_panel.specs.content.update_talent_scroll_pos = self.npc_panel.specs.content.scroll:GetCurrentScrollPos()
        end, self)
        --------------------------------
        -- update the content
        -- --------------------------------
        -- reset the scroll
        local scroll = self.npc_panel.specs.content.scroll
        scroll:Show(false)
        Printer:Debug(LOG.INFO, CAT.UI, "Clearing Specs Tab Scroll Rows for Talents Spec")
        scroll:Clear()
        self:__ClearSpecsTabScrollRows()
        self.npc_panel.specs.content.talents = {}
        local npc_deck = npcd.get_npc(npc_id)
        if npc_deck and npc_deck.show_profile then
            self:__CreateTalentSection(npc_id, npcd.FEAT_TYPE.ACTIVE, scroll)
            self:__CreateTalentSection(npc_id, npcd.FEAT_TYPE.PASSIVE, scroll)
            self:__CreateTalentSection(npc_id, npcd.FEAT_TYPE.MUTATION, scroll)
            self:__CreateTalentSection(npc_id, npcd.FEAT_TYPE.BOON, scroll)
            self:__CreateTalentSection(npc_id, npcd.FEAT_TYPE.TRAIT, scroll)
        end
        scroll:Show(true)
    end

    if spec_name == SPECS.PERKS then
        -- update the header
        self.npc_panel.specs.header.content:Show(false)
        self.npc_panel.specs.header.content = xml:InitStatic("npc_panel:specs:terminal_display:header:content", self.npc_panel.specs.header.dialog)
        local label = xml:InitTextWnd("npc_panel:specs:terminal_display:header:content:label", self.npc_panel.specs.header.content)        
        label:SetText(TERMINAL_TABS_UTIL.get_label(spec_name))
        local type = xml:InitTextWnd("npc_panel:specs:perk:h_type", self.npc_panel.specs.header.content)
        local category = xml:InitTextWnd("npc_panel:specs:perk:h_category", self.npc_panel.specs.header.content)
        local rank = xml:InitTextWnd("npc_panel:specs:perk:h_rank", self.npc_panel.specs.header.content)

        local scroll = self.npc_panel.specs.content.scroll
        scroll:Show(false)
        scroll:Clear()
        self:__ClearSpecsTabScrollRows()
        local npc_perks = npcd.get_npc_perks(npc_id)
        local npc_deck = npcd.get_npc(npc_id)
        if npc_perks and (npc_deck and npc_deck.show_profile) then
            local index = 0
            for _, perk in pairs(npc_perks) do
                local perk = npcd.get_perk(perk.id)
                self:__CreatePerkRow(npc_id, perk, scroll, index)
                index = index + 1
            end
        end
        scroll:Show(true)        
    end

    if spec_name == SPECS.EQUIPMENT then
        -- update the header
        self.npc_panel.specs.header.content:Show(false)
        self.npc_panel.specs.header.content = xml:InitStatic("npc_panel:specs:terminal_display:header:content", self.npc_panel.specs.header.dialog)
        local label = xml:InitTextWnd("npc_panel:specs:terminal_display:header:content:label", self.npc_panel.specs.header.content)        
        label:SetText(TERMINAL_TABS_UTIL.get_label(spec_name))
        local scroll = self.npc_panel.specs.content.scroll
        scroll:Show(false)
        scroll:Clear()
        self:__ClearSpecsTabScrollRows()
    end
    -- Printer:DebugTable("Specs Scroll Rows", self.npc_panel.specs.content.scroll.row)
end

function npcd_dashboard_tab:__CreateTalentSection(npc_id, feat_type, scroll)
    local name = gc("ui_mcm_lst_" .. feat_type)
    Printer:Debug(LOG.INFO, CAT.UI, "Creating Talent Section - Type: %s Name: %s", feat_type, name)
    if feat_type == npcd.FEAT_TYPE.PASSIVE or feat_type == npcd.FEAT_TYPE.ACTIVE then
        name = name .. " " .. gc("ui_npcd_details_ability_header")
    end
    local talent_section = xml:InitStatic("npc_panel:specs:talent_section", nil)
    local feat_list = npcd.get_npc_feats_bytype(npc_id, feat_type)
    -- feat_list = npcd.get_npc_feats(npc_id)
    if self.npc_panel.specs.header.talents_view == VIEW.GROUPED then
    if npcdu.tablelength(feat_list) == 0 then
        local section_background = xml:InitStatic("npc_panel:specs:talent_section:background", talent_section)
        local section_name = xml:InitTextWnd("npc_panel:specs:talent_section:name", talent_section)
        section_name:SetText(name)
    else
        -- toggle button
        local talent_section_button = xml:Init3tButton("npc_panel:specs:talent_section_button", talent_section)
        if not self.npc_panel.specs.content.talent_section[feat_type].show then
            talent_section_button:InitTexture("ui_npcd_pda_talent_section_closed_button")
        end
        talent_section_button:TextControl():SetText(name)
        local id = "talent_section_button" .. feat_type -- .. "_" .. math.random(1000,9999)
        self:Register(talent_section_button, id)
        self:AddCallback(id, ui_events.BUTTON_CLICKED, function ()
            Printer:Debug(LOG.INFO, CAT.UI, "Toggling Talent Section - Type: %s", feat_type)
            self.npc_panel.specs.content.talent_section[feat_type].show = not self.npc_panel.specs.content.talent_section[feat_type].show
            self.npc_panel.specs.content.update_talent_scroll = true
            self.npc_panel.specs.content.update_talent_scroll_pos = scroll:GetCurrentScrollPos()
        end, self)
    end
    else
        talent_section:SetWndSize(vector2():set(talent_section:GetWidth(), 0))
    end
    self.npc_panel.specs.content.talent_section[feat_type].dialog = talent_section
    self.npc_panel.specs.content.talent_section[feat_type].groups = {}

    local talent_grp = xml:InitFrame("npc_panel:specs:talent_group", talent_section)
    if self.npc_panel.specs.content.talent_section[feat_type].show then
        local column = 0
        local row = 0
        local section_y_offset = talent_section:GetWndPos().y + talent_section:GetHeight()
        for _, feat in pairs(feat_list or {}) do
            if column > 2 then
                column = 0
                row = row + 1
                Printer:Debug(LOG.INFO, CAT.UI, "Adding Talent Group to Section - Columns full, creating new group")
                talent_grp = xml:InitFrame("npc_panel:specs:talent_group", talent_section)
            end
            local talent = xml:InitStatic("npc_panel:specs:talent", talent_grp)
            talent:SetWndPos(vector2():set(talent:GetWndPos().x + column * (talent:GetWidth() + 5), section_y_offset + talent:GetWndPos().y + row * (talent:GetHeight() + 5)))
            -- icon
            local icon_frame = xml:InitStatic("npc_panel:specs:talent:icon_frame", talent)
            local icon = xml:InitStatic("npc_panel:specs:talent:icon_frame:icon", icon_frame)
            talent.talent_icon = icon
            icon:InitTexture(feat.icon)
            local hint = { type = HINT_TYPE.FEAT, id = feat.uid, ele = icon }
            table.insert(self.npc_panel.specs.content.hints, hint)
            -- name
            local name = xml:InitTextWnd("npc_panel:specs:talent:name", talent)
            name:SetText(gc(feat and feat.name) or "NULL")
            -- arrange in grid
            column = column + 1
            table.insert(self.npc_panel.specs.content.talents, talent)
            if column > 2 then
                Printer:Debug(LOG.INFO, CAT.UI, "Adding Talent Group to Section - Columns full, creating new group")
                table.insert(self.npc_panel.specs.content.talent_section[feat_type].groups, talent_grp)
            end
        end
        -- add remaining talents
        if column > 0 and column < 3 then
            Printer:Debug(LOG.INFO, CAT.UI, "Adding remaining talents in section - columns %s", column)
            table.insert(self.npc_panel.specs.content.talent_section[feat_type].groups, talent_grp)
        end
    end
    local visible_groups_count = 0
    for _, group in pairs(self.npc_panel.specs.content.talent_section[feat_type].groups or {}) do
        if self.npc_panel.specs.content.talent_section[feat_type].show then
            visible_groups_count = visible_groups_count + 1
        end
    end
    talent_section:SetWndSize(vector2():set(talent_section:GetWidth(), talent_section:GetHeight() + visible_groups_count *  (talent_grp:GetHeight() + 5)))
    scroll:AddWindow(talent_section, true)
    local space = xml:InitStatic("npc_panel:specs:talent_section:spacer", nil)
    scroll:AddWindow(space, true)
end

function npcd_dashboard_tab:__GetStatSuffix(stat_name)

    local suffix = ""
    if stat_name == npcd.FEAT_SETTING.STAT.CHANCE then
        suffix = " %"
    end
    if stat_name == npcd.FEAT_SETTING.STAT.DURATION or stat_name == npcd.FEAT_SETTING.STAT.COOLDOWN then
        suffix = " s"
    end
    return suffix
end

function npcd_dashboard_tab:__CreateAbilityRow(npc_id, feat, scroll, index)

    local perk = npcd.get_perk(feat.perk_id)
    local rank = npcdu.get_perk_rank(npc_id, perk.id)
    local rank_desc = npcdu.get_perk_rank_desc(npc_id, perk.id)

    scroll.row[index] = {}
    scroll.row[index].button = xml:Init3tButton("npc_panel:specs:ability", nil)
    scroll:AddWindow(scroll.row[index].button, true)
    local row_data = {
        feat_name = gc(feat and feat.name) or "NULL",
        feat_hint = gc(feat and feat.hint) or "NULL",
        feat_icon = feat and feat.icon or "ui_npcd_hud_default_icon",
        feat_type = gc(feat and "ui_mcm_lst_" .. feat.type) or "NULL",
        feat_mode = gc(feat and "ui_mcm_lst_" .. feat.mode) or "NULL",

        perk_name = gc(perk and perk.name) or "NULL",
        perk_icon = perk and perk.icon or "ui_npcd_hud_default_icon",
        perk_type = gc(perk and "ui_mcm_lst_" .. perk.type) or "NULL",
        perk_hint = gc(perk and perk.hint) or "NULL",
        rank = rank_desc or "NULL",
        feat_uid = feat and feat.uid or "NULL",
        perk_id = perk and perk.id or "NULL",
    }
    i = 0
    local stat_group = xml:InitFrame("npc_panel:specs:ability:stat_group", scroll.row[index].button)
    self:__CreateStatGroup(feat.stats[rank], stat_group)
    
    scroll.row[index].button:TextControl():SetText("+++   " .. row_data.feat_name .. "   +++")

    local icon_frame = xml:InitStatic("npc_panel:specs:ability:icon_frame", scroll.row[index].button)
    local icon = xml:InitStatic("npc_panel:specs:ability:icon", scroll.row[index].button)
    icon:InitTexture(row_data.feat_icon)
    scroll.row[index].feat_icon = icon

    -- local type = xml:InitTextWnd("npc_panel:specs:ability:type", scroll.row[index].button)
    -- type:SetText(row_data.feat_type)
    -- type:SetFont(GetFontSmall())

    local mode = xml:InitTextWnd("npc_panel:specs:ability:mode", scroll.row[index].button)
    mode:SetText(row_data.feat_mode)
    mode:SetFont(GetFontSmall())
    
    local source_frame = xml:InitStatic("npc_panel:specs:ability:source_frame", scroll.row[index].button)
    local source = xml:InitStatic("npc_panel:specs:ability:source", scroll.row[index].button)
    source:InitTexture(row_data.perk_icon)
    scroll.row[index].perk_icon = source

    local rank = xml:InitTextWnd("npc_panel:specs:ability:rank", scroll.row[index].button)
    rank:SetText(row_data.rank)
    rank:SetFont(GetFontMedium())
    
    scroll.row[index].data = row_data

    -- -- register button callback
    local id = "npc_ability_button_" .. index -- .. "_" .. math.random(1000,9999)
    self:Register(scroll.row[index].button, id)
    self:AddCallback(id, ui_events.BUTTON_CLICKED, function ()
        Printer:Debug(LOG.INFO, CAT.UI, "NPC Ability Button Clicked - Ability: " .. row_data.feat_name)
    end, self)
end

