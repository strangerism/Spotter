function get_printer()
	if not Printer then
		Printer = npcd_logging.get_printer("npcd_pda_dashboard")
	end 
	LOG = Printer:GetLogTypes()
	CAT = Printer:GetLogCategories()
end
RegisterScriptCallback("npcd_on_log_update", get_printer)


if not mac_mcm then
    local original_set_active_subdialog = pda.set_active_subdialog
    pda.set_active_subdialog = function (section)
        if (section == "eptNPCD") then
            return get_ui()
        else
            return original_set_active_subdialog(section)
        end
    end
end


