function SFXVideoTerminal_Create(sfx_config)
	Printer:Debug(LOG.START, CAT.UI," Creating SFXVideoTerminal")
	local sfx_id = sfx_config.type .. "_" .. (name or "") .. "_".. tostring(math.random(10000, 99999))
	sfx_config.id = sfx_id
	local video_terminal = SFXVideoTerminal(sfx_config)
	SFX_INSTANCES[sfx_id] = video_terminal
	return video_terminal
end

function SFXVideoTerminal:Show(show)
	Printer:Debug(LOG.RUN, CAT.UI," SFXVideoTerminal: show %s", tostring(show))
	if self.dialog then
		Printer:Debug(LOG.INFO, CAT.UI," SFXVideoTerminal: setting dialog visibility to %s", tostring(show))
		self.dialog:Show(show)
	end
end

function SFXVideoTerminal:SwitchOn()
	Printer:Debug(LOG.RUN, CAT.UI," SFXVideoTerminal: switch on")
	Printer:Debug(LOG.RUN, CAT.UI,"Starting FX: %s", self.fx.showing_display.id)
	npcd_ui_fx.resume_fx(self.fx.showing_display.id)
end

function SFXVideoTerminal:SwitchOff()
	self.display:Show(false)
	if self.fx.scanlines then
		npcd_ui_fx.remove_fx(self.fx.scanlines.id)
	end
	npcd_ui_fx.stop_fx(self.fx.flickering.id)
	self.content:Show(false)
	if self.header then
		self.header:Show(false)
	end
	if self.glass then
		self.glass:Show(false)
		self.glass = nil
	end
	if self.dirt then
		self.dirt:Show(false)
		self.dirt = nil
	end
end


function sfx_video_terminal_on_started(sfx_id)
	Printer:Debug(LOG.RUN, CAT.UI," SFXVideoTerminal: started callback %s", sfx_id)
	Printer:DebugTable("SFX INSTANCES:", SFX_INSTANCES)
	local video_terminal = SFX_INSTANCES[sfx_id]
	if video_terminal and video_terminal.__on_started then
		video_terminal:__on_started()
	else
		Printer:Debug(LOG.ERROR, CAT.UI," SFXVideoTerminal: started failed, invalid self reference")
	end
end

function sfx_video_terminal_on_content_displayed(sfx_id)
	Printer:Debug(LOG.RUN, CAT.UI," SFXVideoTerminal: content displayed callback %s", sfx_id)
	local video_terminal = SFX_INSTANCES[sfx_id]
	if video_terminal and video_terminal.__on_content_displayed then
		video_terminal:__on_content_displayed()
	else
		Printer:Debug(LOG.ERROR, CAT.UI," SFXVideoTerminal: on_content_displayed failed, invalid self reference")
	end
end



--- SFX HANDLERS: VIDEO TERMINAL