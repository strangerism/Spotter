    showing = {
        name = "showing",
        module = "npe_dialog_codec",
		group_name = "codec_ui",
		execution = npe_execution.TYPE.CONDITIONAL,
		stop_condition = { "npe_dialog_codec", "portrait_showing_completed", "actor" },
        start_timer = 0.15,
        loop_timer = 0.0,        
        functor = { "npe_dialog_codec", "show_portrait", "actor" },
