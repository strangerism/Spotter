local npcdu = npcd_utils
local gc = game.translate_string

function get_printer()
	if not Printer then
		Printer = npcd_logging.get_printer("npcd_ui_fx")
	end 
	LOG = Printer:GetLogTypes()
	CAT = Printer:GetLogCategories()
end
RegisterScriptCallback("npcd_on_log_update", get_printer)

Runner ={	
    hiding = {
        name = "hiding",
        module = "npe_dialog_codec",
		group_name = "codec_ui",
		execution = npe_execution.TYPE.CONDITIONAL,
		stop_condition = { "npe_dialog_codec", "portrait_hiding_completed", "caller" },
        start_timer = 0.6,
        loop_timer = 0.0,      
        functor = { "npe_dialog_codec", "hide_portrait", "caller" },
		start = { "npe_dialog_codec", "on_start_hide_portrait", "caller" },
		stop = { "npe_dialog_codec", "on_stop_hide_portrait", "caller" },
    },
	scanlines = {
		name = "scanlines",
		module = "npcd_ui_fx",
		group_name = "npcd_ui_fx",
		execution = npe_execution.TYPE.INFINITE,
		start_timer = 0.1,
		loop_timer = 0.04,
		functor = { "npcd_ui_fx", "run_scanlines" },
		start = { "npcd_ui_fx", "on_start_scanlines" },
	},
    flickering = {
        name = "flickering",
        module = "npcd_ui_fx",
		group_name = "npcd_ui_fx",
		execution = npe_execution.TYPE.CONDITIONAL,
		stop_condition = { "npcd_ui_fx", "flickering_duration_ended" },
        start_timer = 0.015,
        loop_timer = 0.015,
        functor = { "npcd_ui_fx", "run_flickering" },
		start = { "npcd_ui_fx", "on_start_flickering" },
		stop = { "npcd_ui_fx", "on_stop_flickering" },
    },
    flickering_manager = {
        name = "flickering_manager",
		module = "npcd_ui_fx",
		group_name = "npcd_ui_fx",
		execution = npe_execution.TYPE.INFINITE,
        start_timer = 1,
        loop_timer = 1,
        functor = { "npcd_ui_fx", "run_flickering_manager" },
		start = { "npcd_ui_fx", "on_start_flickering_manager" },
		stop = { "npcd_ui_fx", "on_stop_flickering_manager" },
    },
    showing = {
        name = "showing",
        module = "npcd_ui_fx",
		group_name = "npcd_ui_fx",
		execution = npe_execution.TYPE.CONDITIONAL,
		stop_condition = { "npcd_ui_fx", "showing_completed"},
        start_timer = 0.15,
        loop_timer = 0.0,
        functor = { "npcd_ui_fx", "run_show" },
		start = { "npcd_ui_fx", "on_start_show" },
		stop = { "npcd_ui_fx", "on_stop_show" },
    },
	translate = {
		name = "translate",
		module = "npcd_ui_fx",
		group_name = "npcd_ui_fx",
		execution = npe_execution.TYPE.CONDITIONAL,
		stop_condition = { "npcd_ui_fx", "translate_completed"},
		start_timer = 0.1,
		loop_timer = 0.00,
		functor = { "npcd_ui_fx", "run_translate" },
		start = { "npcd_ui_fx", "on_start_translate" },
		stop = { "npcd_ui_fx", "on_stop_translate" },
	},
}

FX = {
	SHOWING = "showing",
	HIDING = "hiding",
	FLICKERING_MANAGER = "flickering_manager",
	SCANLINES = "scanlines",
	FLICKERING = "flickering",
	TRANSLATE = "translate",
}

local FX_CONFIG = {
	[FX.HIDING] = {
	},
	[FX.SCANLINES] = {
		type = FX.SCANLINES,
		dialog = nil,
		start = nil,
		speed = nil,
		random_accel = false,
		accel_length = nil, -- acceleration event length multiplier in ms (100 * accel_length, 500 * accel_length)
		orientation = 1, -- 0 - horizontal, 1 - vertical
		scale = 1.0,
		intensity = nil, -- 0 to 1 - the intensity of the scanline
		margin_v = 0, -- vertical margin of the scanline respective to dialog
		margin_h = 0, -- horizontal margin of the scanline respective to dialog
		direction = 1, -- 1 - in, -1 - out
		start_x = nil,
		start_y = nil,
		offset = 0, -- offset starting position as percentage of dialog height/width
		fx_ui = nil,
		fx_element = "scanline",
		init_on_start = false, -- initialize the fx_ui element on start callback 
		accel_event = nil,
		accel_cycle = 0,
		accel_increment = nil,
		accel_direction = 1, -- internal -- 1 - accelerating, -1 - decelerating
	},
	[FX.FLICKERING] = {
		type = FX.FLICKERING,
		dialog = nil,
		flickering_duration = nil,
		random_duration = false,
		flickering_cooldown = nil,
		random_cooldown = false,
		cooldown_value = 0,
		intensity = 1, -- 0 to 1 - the intensity of the flickering -- if 1 then full hide/show instead of alpha change -- must be used on non texture dialogs
		restore_alpha = nil, -- explicitly set the alpha to restore after flickering ends
		max_intensity = nil, -- instead of using alpha restore, restore to this intensity value (0 to 1)*255
		speed = nil,
		fx_ui = nil,
		fx_element = nil,
		init_on_start = false,
		force = nil, -- if managed, commands the manager to start flickering immediately (one-shot) value is duration in ms
	},
	[FX.FLICKERING_MANAGER] = {
		type = FX.FLICKERING_MANAGER,
		manager_type = FX.FLICKERING,
	},
	[FX.SHOWING] = {
		type = FX.SHOWING,
		dialog = nil,
		start = nil,
		speed = nil,
		cursor = 0,
		y = 0,
		height = 0,
		on_showing_complete = nil,
	},
	[FX.TRANSLATE] = { -- translate the dialog from its initial position along the specified orientation and direction
		type = FX.TRANSLATE,
		dialog = nil,
		start = nil,
		speed = nil,
		orientation = 0, -- 0 - x axis, 1 - y axis
		direction = 1, -- 1 - forward, -1 - backward
		length = nil, -- how many pixels is translated
	},
}

local Managed = {
	[FX.FLICKERING] = {
	},
}

local FX_CONTROLS = {
	[FX.SCANLINES] = {
		direction = true
	}
}

local FX_JOBS = {
}

local xml = CScriptXmlInit()
xml:ParseFile("ui_npcd_fx.xml")

function get_fx_config(fx_name, group)
	local config = npcdu.copy(FX_CONFIG[fx_name])
	if group then
		config.group = group
	end
	return config
end

function add_fx(fx_config, name)
	if not fx_config.type then
		Printer:Debug(LOG.ERROR, CAT.UI_ACTION," FX type not specified!")
		return
	end
	local fx_id = fx_config.type .. "_" .. (name or "") .. "_".. tostring(math.random(10000, 99999))
	local new_runner = npcdu.copy(Runner[fx_config.type])
	new_runner.name = fx_id
	new_runner.start_timer = fx_config.start or new_runner.start_timer
	new_runner.loop_timer = fx_config.speed or new_runner.loop_timer
	new_runner.stop = fx_config.stop or new_runner.stop
	FX_JOBS[fx_id] = {
		runner_name = fx_id,
		config = fx_config,
	}
	npe_execution.Add(new_runner)
	fx_config.id = fx_id
	if fx_config.fx_element and not fx_config.init_on_start then
		fx_config.fx_ui = xml:InitStatic(fx_config.fx_element, fx_config.dialog)
		fx_config.fx_ui:Show(false)
	end
	Printer:TraceTable("Adding FX:", fx_config)
end

function remove_fx(fx_id)
	local fx_job = FX_JOBS[fx_id]
	if fx_job then
		npe_execution.Remove(fx_job.runner_name)
		FX_JOBS[fx_id] = nil
	end
end

function remove_all_fx()
	for fx_id, _ in pairs(FX_JOBS) do
		remove_fx(fx_id)
	end
end

function stop_fx(fx_id)
	local fx_job = FX_JOBS[fx_id]
	if fx_job then
		npe_execution.Stop(fx_job.runner_name)
		if fx_job.config.fx_ui and fx_job.config.type ~= FX.SHOWING then
			fx_job.config.fx_ui:Show(false)
			fx_job.config.fx_ui = nil
		end
	end
end

function resume_fx(fx_id)
	local fx_job = FX_JOBS[fx_id]
	if fx_job then
		npe_execution.Resume(fx_job.runner_name)
		if fx_job.config.fx_ui then
			fx_job.config.fx_ui:Show(true)
		end		
	end
end

function show_fx(fx_id, show)
	local fx_job = FX_JOBS[fx_id]
	if fx_job then
		-- npe_execution.Resume(fx_job.runner_name)
		if fx_job.config.fx_ui then
			fx_job.config.fx_ui:Show(show)
		end		
	end
end

function reset_fx(fx_id)
	local fx_job = FX_JOBS[fx_id]
	if fx_job then
		npe_execution.Remove(fx_job.runner_name)
		npe_execution.Add(fx_job.config)
		resume_fx(fx_id)
	end
end

function update_fx(fx_id, name, value)
	local fx_job = FX_JOBS[fx_id]
	if not fx_job then return end
	if not FX_CONTROLS[fx_job.config.type][name] then return end

	fx_job.config[name] = value
end

function get_fx_ui(fx_id)
	local fx_job = FX_JOBS[fx_id]
	if not fx_job then return nil end
	return fx_job.config.fx_ui
end

function add_fx_to_manager(fx_id, manager_id)
	if not FX_JOBS[manager_id] then return end
	if not FX_JOBS[fx_id] then return end
	Printer:TraceTable("Adding FX to Manager:", {fx_id = fx_id, manager_id = manager_id})
	local manager = FX_JOBS[manager_id].config
	local manager_type = manager.manager_type
	if not Managed[manager_type] then
		Managed[manager_type] = {}
	end
	Managed[manager_type][fx_id] = fx_id
end

function remove_fx_from_manager(fx_id, manager_id)
	if not FX_JOBS[manager_id] then return end
	local manager = FX_JOBS[manager_id].config
	local manager_type = manager.manager_type
	if not Managed[manager_type] then return end
	Managed[manager_type][fx_id] = nil
end

function purge_fx_manager(manager_id)
	if not FX_JOBS[manager_id] then return end
	local manager = FX_JOBS[manager_id].config
	local manager_type = manager.manager_type
	if not Managed[manager_type] then return end
	Managed[manager_type] = {}
end

-- FX HANDLERS UTILITIES

local DEFAULT_ALPHA = 255
local FLICKERING_ALPHA = 180
SCANLINES_ALPHA = 100
local clr_cache = {}

local function change_alpha(clr, a)
    if not (clr and a ) then return end

    if not clr_cache[clr .. "_" .. a] then
        b = bit.band(clr, 255)
        g = bit.band(bit.rshift(clr, 8), 255)
        r = bit.band(bit.rshift(clr, 16), 255)
        clr_cache[clr .. "_" .. a] = GetARGB(a, r, g, b)
    end

    return clr_cache[clr .. "_" .. a]
end

function change_ui_alpha(ui_element, a)
	if not ui_element then return end
	local clr = ui_element:GetTextureColor()
	change_alpha(clr, a)
	ui_element:SetTextureColor(clr_cache[clr .. "_" .. a])
end

-- FX HANDLERS: SCANLINES

local function get_accel_event(accel_length)
	local chance = math.random(1, 100)
	if chance > 50 then
		local event = math.random(100 * accel_length, 500 * accel_length)
		Printer:Debug(LOG.START, CAT.UI_ACTION," scanlines acceleration event triggered %s", event)
		return event
	end
	return nil
end

function run_scanlines(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	Printer:Debug(LOG.INFO, CAT.UI_ACTION," update scanlines %s", runner_name)
    local GUI = config.fx_ui
	if not GUI then return false end

	local y = GUI:GetWndPos().y
	local x = GUI:GetWndPos().x
	-- update scanlines
	if orientation == 0 then
		x = x + config.direction * (config.accel_increment or 1)
		if x > config.ending_x then x = config.starting_x end
		if x < config.starting_x then x = config.ending_x end
	else 
		y = y + config.direction * (config.accel_increment or 1)
		if y > config.ending_y then y = config.starting_y end
		if y < config.starting_y then y = config.ending_y end
	end
	GUI:SetWndPos(vector2():set(x, y))

	-- check acceleration event
	if config.random_accel then
		config.accel_event = config.accel_event or get_accel_event(config.accel_length or 1)
		if config.accel_event then
			-- initialize acceleration parameters on first run
			if config.accel_increment == nil then
				Printer:Debug(LOG.START, CAT.UI_ACTION," scanlines %s starting acceleration", runner_name)
				config.accel_max_cycles = config.accel_event
				config.accel_min_speed = config.speed * 0.1  -- 10x faster at peak
				config.accel_speed_range = config.speed - config.accel_min_speed
				config.accel_increment = 1
			end

			if config.accel_direction > 0 and config.accel_cycle > (config.accel_event - math.ceil(config.accel_event/(config.accel_increment + config.accel_direction))) and config.accel_increment < 5 then
				Printer:Debug(LOG.INFO, CAT.UI_ACTION," scanlines %s increasing acceleration to %s", runner_name, config.accel_increment + 1)
				config.accel_increment = config.accel_increment + 1
			elseif config.accel_direction < 0 and config.accel_cycle < (config.accel_event - math.ceil(config.accel_event/(config.accel_increment + config.accel_direction))) and config.accel_increment > 1 then
				Printer:Debug(LOG.INFO, CAT.UI_ACTION," scanlines %s decreasing acceleration to %s", runner_name, config.accel_increment - 1)
				config.accel_increment = config.accel_increment - 1
			end

			-- update acceleration cycle
			config.accel_cycle = config.accel_cycle + config.accel_direction -- * (config.accel_increment or 1)
			
			-- reached max speed, start slowing down
			if config.accel_cycle >= config.accel_max_cycles then
				Printer:Debug(LOG.INFO, CAT.UI_ACTION," scanlines %s reached max speed, starting slowdown", runner_name)
				config.accel_direction = -1
			end
			
			-- completed acceleration cycle, reset to normal speed
			if config.accel_cycle <= 0 and config.accel_direction == -1 then
				Printer:Debug(LOG.STOP, CAT.UI_ACTION," scanlines %s resetting to normal speed %s", runner_name , config.speed)
				-- reset acceleration
				config.accel_event = nil
				config.accel_direction = 1
				config.accel_cycle = 0
				config.accel_increment = nil
				config.accel_max_cycles = nil
				config.accel_min_speed = nil
				config.accel_speed_range = nil
				npe_execution.RunnerUpdate(runner_name, {loop_timer = config.speed})
				return true
			end
			
			-- calculate exponential speed curve
			local progress = config.accel_cycle / config.accel_max_cycles
			local exponential_factor = math.pow(progress, 2)  -- quadratic curve for smoother acceleration
			local new_speed = config.speed - (config.accel_speed_range * exponential_factor)
			
			-- ensure minimum speed limit
			new_speed = math.max(new_speed, config.accel_min_speed)
			
			npe_execution.RunnerUpdate(runner_name, {loop_timer = new_speed})
			Printer:Debug(LOG.INFO, CAT.UI_ACTION," scanlines %s cycle %s/%s, speed %s", runner_name, config.accel_cycle, config.accel_max_cycles, new_speed)
		end
	end	
	return true
end

function on_start_scanlines(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	if not config.dialog then return end
	Printer:Debug(LOG.INFO, CAT.UI_ACTION," on_start_scanlines %s", runner_name)

	config.starting_y = config.margin_v
	config.ending_y = config.dialog:GetHeight() - config.margin_v
	local start_pos = config.margin_v + (config.dialog:GetHeight() * config.offset)
	if not config.fx_ui or config.init_on_start then
		config.fx_ui = xml:InitStatic(config.fx_element, config.dialog)
	end

	change_ui_alpha(config.fx_ui, (config.intensity and config.intensity * 255) or SCANLINES_ALPHA)
	config.fx_ui:SetWndPos(vector2():set(config.margin_h, start_pos))
    config.fx_ui:SetWndSize(vector2():set(config.dialog:GetWidth() - (config.margin_h + config.margin_h / 2), config.fx_ui:GetHeight() * config.scale))
	Printer:TraceTable("Scanline Config:", config)
	return true
end

-- FX HANDLERS: FLICKERING

function run_flickering(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	Printer:Debug(LOG.INFO, CAT.UI_ACTION," running flickering loop for %s", runner_name)
	-- flickering effect is done alternating alpha value of the ui element and switching its visibility
	if config.fx_ui:IsShown() then
		config.fx_ui:Show(false)
	else
		config.fx_ui:Show(true)
	end
end

function on_start_flickering(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	if not config.dialog then return end
	Printer:Debug(LOG.START, CAT.UI_ACTION," starting flickering loop for %s", runner_name)

	-- the fx element is the original dialog manipulation
	config.fx_ui = config.dialog
	-- starting the flickering effect by setting duration and new alpha
	-- duration can be preset in config or calculated here
	config.flickering_duration = time_global() + (config.flickering_duration or (math.random(10, 50) * 10))
	Printer:Debug(LOG.INFO, CAT.UI_ACTION," flickering duration set to %s for %s", config.flickering_duration, runner_name)
	if config.random_duration then
		-- execute custom random duration functor
		local duration = execute_func(unpack(config.random_duration))
		if duration and type(duration) == "number" then
			config.flickering_duration = duration
		end
	end

	if config.force then
		-- forced flickering duration
		config.flickering_duration = time_global() + config.force
		config.force = nil
	end

	if not config.restore_alpha  then
		-- cache original alpha to restore later
		if config.fx_ui.GetTextureColor then
			local c = npcdu.get_ui_element_color(config.fx_ui)
			local str  = string.format("Cached original color by %s", runner_name)
			-- Printer:DebugTable(str, c and c or {})
			config.restore_alpha = c and c.a or DEFAULT_ALPHA
		else
			config.restore_alpha = DEFAULT_ALPHA
		end
	end

	local intensity = config.intensity * 255
	if intensity < 255 then
		change_ui_alpha(config.fx_ui, intensity)
	end
	-- signal successful execution of start functor
	return true
end

function on_stop_flickering(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	if not config.fx_ui then return end
	Printer:Debug(LOG.STOP, CAT.UI_ACTION," stopping caller_flickering loop for %s", runner_name)

	-- ending the flickering effect by restoring default alpha and visibility, also setting cooldown for a flickering manager if used
	if config.intensity ~= 1 then
		-- restore original alpha
		if config.max_intensity and config.intensity < config.max_intensity then
			-- if max intensity is set, restore to that value
			change_ui_alpha(config.fx_ui, config.max_intensity * 255)
		else
			change_ui_alpha(config.fx_ui, config.restore_alpha < 255 and config.restore_alpha or 255)
		end
	end
	config.fx_ui:Show(true)
	config.flickering_duration = nil

	-- used when flickering is managed by a flickering manager
	config.cooldown_value = config.flickering_cooldown or (time_global() + math.random(10, 50) * 100)
	if config.random_cooldown then
		-- execute custom random cooldown functor
		local cooldown = execute_func(unpack(config.random_cooldown))
		if cooldown and type(cooldown) == "number" then
			Printer:Debug(LOG.INFO, CAT.UI_ACTION," flickering cooldown for %s set to %s", runner_name, cooldown)
			config.cooldown_value = time_global() + cooldown
		end
	end
	-- signal successful execution of stop functor
	return true
end

function flickering_duration_ended(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config

	-- called by the npe execution to check if the flickering duration has ended
	if time_global() > config.flickering_duration then
		return true
	else
		return false
	end
end

-- FX HANDLERS: FLICKERING MANAGER

local current_level = 0

local function get_flicker_chance()
	local chance = math.random(1, 100)
	if current_level < 7 then
		chance = chance + (7 - current_level) * 10
	elseif current_level == 9 then
		chance = chance - 50
		current_level = 0
	end
	return chance
end

function run_flickering_manager(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	Printer:Debug(LOG.RUN, CAT.UI_ACTION," running flickering manager %s", runner_name)
	for _, managed_id in pairs(	Managed[FX.FLICKERING]) do
		local managed = FX_JOBS[managed_id] and FX_JOBS[managed_id]
		if not managed then return false end
		-- Printer:DebugTable("Flickering Manager checking managed fx:", managed)
		
		-- cannot run if scanline loop is active or it has a cooldown
		if managed.config.force then
			-- forced flickering start
			npe_execution.Resume(managed.runner_name)
			Printer:Debug(LOG.START, CAT.UI_ACTION," forced start of flickering loop for %s", managed.runner_name)
		elseif managed.config.cooldown_value == 0 and not npe_execution.IsRunnerRunning(managed.runner_name) then
			-- start caller scanlines loop by chance			
			local flicker_chance = get_flicker_chance()
			if flicker_chance > 70 then
				Printer:Debug(LOG.START, CAT.UI_ACTION," starting flickering loop for %s with chance %s", managed.runner_name, flicker_chance)
				npe_execution.Resume(managed.runner_name)
				current_level = current_level + 1
			end
		else
			if time_global() > managed.config.cooldown_value then
				managed.config.cooldown_value = 0
			end
			Printer:Debug(LOG.INFO, CAT.UI_ACTION," flickering cooldown active for %s %s", managed.runner_name, managed.config.cooldown_value)
		end
	end
end

function on_stop_flickering_manager(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	if not config.dialog then return end
	for _, managed_id in pairs(	Managed[FX.FLICKERING]) do
		local managed = FX_JOBS[managed_id]
		if not managed then return false end
		-- stop caller flickering loop
		npe_execution.Stop(managed.runner_name)
	end
	return true
end

function on_start_flickering_manager(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	Printer:Debug(LOG.START, CAT.UI_ACTION," starting flickering manager %s", runner_name)
	for _, managed_id in pairs(	Managed[FX.FLICKERING]) do
		local managed = FX_JOBS[managed_id]
		Printer:TraceTable("Initializing managed flickering fx:", managed)
		if not managed then return false end
		-- initialize flickering cooldown
		managed.config.cooldown_value = 0
	end
	return true
end

-- FX: SHOWING

function run_show(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	if not config.fx_ui then return end

	config.cursor = config.cursor + 6
	local new_y = config.y - config.cursor
	local new_height = config.cursor * 2
	config.fx_ui:SetWndPos(vector2():set(config.fx_ui:GetWndPos().x, new_y))
	config.fx_ui:SetWndSize(vector2():set(config.fx_ui:GetWidth(), new_height))
	Printer:Debug(LOG.INFO, CAT.UI_ACTION," showing dialog %s at y:%s height:%s", runner_name, new_y, new_height)
end

function on_start_show(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	if not config.dialog then return end
	config.fx_ui = config.dialog
	Printer:Debug(LOG.START, CAT.UI_ACTION," starting show_dialog")
	config.original = {}
	-- save original y position
	config.original_y = config.fx_ui:GetWndPos().y
	-- save original height
	config.height = config.fx_ui:GetHeight()
	-- reset cursor
	config.cursor = 0
	-- set y postion to middle
	config.y = config.fx_ui:GetWndPos().y + config.fx_ui:GetHeight() / 2
	config.fx_ui:SetWndPos(vector2():set(config.fx_ui:GetWndPos().x, config.y))
	-- initial height 0
	config.fx_ui:SetWndSize(vector2():set(config.fx_ui:GetWidth(), 0))
	config.fx_ui:Show(true)
	return true
end

function on_stop_show(runner_name)
	Printer:Debug(LOG.STOP, CAT.UI_ACTION," stopping show_dialog %s", runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	if not config.fx_ui then return end
	-- restore original position and size
	config.fx_ui:SetWndPos(vector2():set(config.fx_ui:GetWndPos().x, config.original_y))
	config.fx_ui:SetWndSize(vector2():set(config.fx_ui:GetWidth(), config.height))
	if config.on_showing_complete then
		local ex_funtor = npcdu.copy(config.on_showing_complete)
		-- table.insert(ex_funtor, runner_name)
		-- Printer:DebugTable("Executing on_showing_complete:", ex_funtor)
		execute_func(unpack(ex_funtor))
	end
end

function showing_completed(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	if not config.fx_ui then return end
	if config.fx_ui:GetHeight() >= config.height then
		return true
	else
		return false
	end
end

-- FX: TRANSLATE

function translate_completed(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	if not config.fx_ui then return end
	if config.orientation == 0 then
		if (config.direction == 1 and config.fx_ui:GetWndPos().x >= config.end_x) or
		   (config.direction == -1 and config.fx_ui:GetWndPos().x <= config.end_x) then
			return true
		end
	else
		if (config.direction == 1 and config.fx_ui:GetWndPos().y >= config.end_y) or
		   (config.direction == -1 and config.fx_ui:GetWndPos().y <= config.end_y) then
			return true
		end
	end
	return false
end

function run_translate(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	if not config.fx_ui then return end
	config.fx_ui:Show(false)
	Printer:Debug(LOG.INFO, CAT.UI_ACTION," updating translate dialog %s", runner_name)
	-- update translation
	local x, y = config.fx_ui:GetWndPos().x, config.fx_ui:GetWndPos().y
	if config.orientation == 0 then
		config.cursor = config.cursor + 1 * config.direction
		Printer:Debug(LOG.INFO, CAT.UI_ACTION," cursor x:%s", config.cursor)
		x = config.cursor
	else
		config.cursor = config.cursor + 1 * config.direction
		y = config.cursor
	end
	config.fx_ui:SetWndPos(vector2():set(x, y))
	config.fx_ui:Show(true)
	Printer:Debug(LOG.INFO, CAT.UI_ACTION," translating dialog %s to x:%s y:%s length:%s", runner_name, x, y, config.length)
end

function on_start_translate(runner_name)
	local fx_job = FX_JOBS[runner_name]
	if not fx_job then return false end
	local config = fx_job.config
	if not config.dialog then return end
	config.fx_ui = config.dialog
	Printer:Debug(LOG.START, CAT.UI_ACTION," starting translate_dialog %s", runner_name)

	if config.orientation == 0 then
		config.start_x = config.fx_ui:GetWndPos().x
		config.end_x = config.start_x + (config.direction * config.length)
		Printer:Debug(LOG.INFO, CAT.UI_ACTION," translate_dialog %s from x:%s to x:%s", runner_name, config.start_x, config.end_x)
		config.cursor = config.start_x
	else
		config.start_y = config.fx_ui:GetWndPos().y
		config.end_y = config.start_y + (config.direction * config.length)
		config.cursor = config.start_y
	end
	return true
end

function on_stop_translate(runner_name)
	Printer:Debug(LOG.STOP, CAT.UI_ACTION," stopping translate_dialog %s", runner_name)
end

-- SFX: VIDEO TERMINAL

SFX = {
	VIDEO_TERMINAL = "video_terminal",
}

local SFX_CONFIG = {
	[SFX.VIDEO_TERMINAL] = {
		type = SFX.VIDEO_TERMINAL,
		group = nil,
		xml_init = nil,
		parent = nil,
		display = nil,
		content = nil,
		glass = nil,
		dirt = nil,
		fx = nil,
	},
}

local SFX_INSTANCES = {
}

function get_sfx_config(sfx_name, group)
	Printer:Debug(LOG.INFO, CAT.UI_ACTION," getting SFX config for %s", sfx_name)
	-- Printer:DebugTable("SFX Config:", SFX_CONFIG)
	local config = npcdu.copy(SFX_CONFIG[sfx_name])
	if group then
		config.group = group
	end
	return config
end

class "SFXVideoTerminal"
function SFXVideoTerminal:__init(sfx_config)
	Printer:Debug(LOG.START, CAT.UI," SFXVideoTerminal: initializing")
	Printer:DebugTable("SFXVideoTerminal Config:", sfx_config)

	self.dialog = sfx_config.parent
	self.parent_dialog = sfx_config.parent_dialog
	self.fx = {}

	self.xml = CScriptXmlInit()
	self.xml:ParseFile(sfx_config.xml_init)

	-- display area
	self.display = self.xml:InitStatic(sfx_config.display, self.dialog)
	self.display:Show(false)

	-- optional header to display
	self.header = sfx_config.header

	self.content = sfx_config.content
	self.display:AttachChild(self.content)

	-- FX: showing display
	local showing = get_fx_config(FX.SHOWING, sfx_config.group)
	showing.dialog = self.display
	showing.speed = 0.005
	showing.on_showing_complete = {"npcd_ui_fx", "sfx_video_terminal_on_started", sfx_config.id}
	npcd_ui_fx.add_fx(showing)
	self.fx.showing_display = showing

	-- FX: showing content
	showing = get_fx_config(FX.SHOWING, sfx_config.group)
	showing.dialog = self.content
	showing.speed = 0.005
	showing.on_showing_complete = {"npcd_ui_fx", "sfx_video_terminal_on_content_displayed", sfx_config.id}
	npcd_ui_fx.add_fx(showing, "showing_content")
	self.fx.showing_content = showing

-- FX: Flickering on content
    local flickering = npcd_ui_fx.get_fx_config(npcd_ui_fx.FX.FLICKERING, sfx_config.group)
    flickering.dialog = self.content
    flickering.speed = 0.02
    flickering.flickering_duration = 40
    npcd_ui_fx.add_fx(flickering, "flickering")
    self.fx.flickering = flickering

	-- tabs
	if sfx_config.tabs then
		-- initialize tabs
		self.tabs = {}
		self.tabs.dialog = self.xml:InitStatic(sfx_config.tabs.frame, self.dialog)
		self.tabs.button = {}

		for index, tab_config in ipairs(sfx_config.tabs.tab) do

			-- tabs = {
			-- 	tab = {
			-- 		<tab_name> = {
			-- 			... tab_config ...}
			-- 		},
			-- 	},
			-- 	auto_orient = <bool>,
			-- 	orient = <int>, -- 0 - horizontal, 1 - vertical
			--  button = <xml_button_config>,
			--  frame = <xml_frame_config>,
			--  spacing = <int>,
			-- },

			-- tab_config = {
			--  pos = {x = <int>, y = <int>},
			-- 	default = <bool>,
			--  label = <string>,
			--  (internally) active = <bool>,
			-- 	on_click = {<functor>},
			--  update = {<functor>},
			-- }

			-- create tab button

			self.tabs.button[index] = self.xml:Init3tButton(sfx_config.tabs.button or tab_config.button, self.tabs.dialog)
			self.tabs.button[index]:SetWndPos(vector2():set(
				sfx_config.tabs.auto_orient and (sfx_config.tabs.orient == 0 and ((index - 1) * (self.tabs.button[index]:GetWidth() + (sfx_config.tabs.spacing or 5))) or 0) + (index - 1) or tab_config.pos.x,
				sfx_config.tabs.auto_orient and (sfx_config.tabs.orient == 1 and ((index - 1) * (self.tabs.button[index]:GetHeight() + (sfx_config.tabs.spacing or 5))) or 0) or tab_config.pos.y
			))

			-- set default active tab
			if tab_config.default then
				self.tabs.button[index]:Enable(false)
				self.tabs.button[index].active = true
			else
				self.tabs.button[index]:Enable(true)
				self.tabs.button[index].active = false
			end
			-- set tab label
			self.tabs.button[index]:TextControl():SetFont(GetFontSmall())
			self.tabs.button[index]:TextControl():SetText(gc(tab_config.label))
			-- register tab click event
			self.parent_dialog:Register(self.tabs.button[index], sfx_config.id .. "_terminal_tab_" .. index)
			self.parent_dialog:AddCallback(sfx_config.id .. "_terminal_tab_" .. index, ui_events.BUTTON_CLICKED, function ()
				Printer:Debug(LOG.RUN, CAT.UI," SFXVideoTerminal: tab %s clicked", index)
				if tab_config.on_click_callback then
					Printer:Debug(LOG.INFO, CAT.UI," SFXVideoTerminal: executing tab callback impl for tab %s", tab_config.name)
					if (type(tab_config.on_click_callback.functor) == "function") then 
						tab_config.on_click_callback.functor(tab_config.on_click_callback.self, index, tab_config.name)
					end
				end
				-- set active/inactive states
				for i, tab_button in ipairs(self.tabs.button) do
					if i == index then
						tab_button:Enable(false)
						tab_button.active = true
					else
						tab_button:Enable(true)
						tab_button.active = false
					end
				end
			end, self.dialog)

		end
	end

	Printer:Debug(LOG.ADD, CAT.UI," SFXVideoTerminal: initialized")
	self.config = sfx_config
end

function SFXVideoTerminal:SetActiveTab(index)
	for i, tab_button in ipairs(self.tabs.button) do
		if i == index then
			tab_button:Enable(false)
			tab_button.active = true
		else
			tab_button:Enable(true)
			tab_button.active = false
		end
	end
end

function SFXVideoTerminal:__on_started()
	Printer:Debug(LOG.RUN, CAT.UI," SFXVideoTerminal: started")
	self.display:Show(true)
	-- add glass overlay
	self.glass = self.xml:InitStatic(self.config.glass, self.display)
	-- FX: scanlines on glass
	local scanlines = get_fx_config(FX.SCANLINES, self.config.group)
	scanlines.dialog = self.glass
    scanlines.speed = 0.04
	scanlines.start = 1
    scanlines.random_accel = false
    scanlines.accel_length = 5
    scanlines.margin_v = 3
    scanlines.margin_h = 0
    scanlines.scale = 15
    scanlines.intensity = 0.07
    scanlines.orientation = 1
	scanlines.init_on_start = true
	npcd_ui_fx.add_fx(scanlines)
	self.fx.scanlines = scanlines
	-- add dirt overlay
	if self.config.dirt then
		self.dirt = self.xml:InitStatic(self.config.dirt, self.glass)
	end
	npcd_ui_fx.resume_fx(self.fx.showing_content.id)
end

function SFXVideoTerminal:__on_content_displayed()
	Printer:Debug(LOG.RUN, CAT.UI," SFXVideoTerminal: content displayed")
	npcd_ui_fx.resume_fx(self.fx.scanlines.id)
	self.fx.flickering.flickering_duration = 40
	npcd_ui_fx.resume_fx(self.fx.flickering.id)
	if self.header then
		self.display:AttachChild(self.header)
		self.header:Show(true)
		Printer:Debug(LOG.INFO, CAT.UI," SFXVideoTerminal: header shown")
	end
	if self.config.on_content_displayed_callback then
		Printer:Debug(LOG.INFO, CAT.UI," SFXVideoTerminal: executing on_content_displayed_callback")
		if (type(self.config.on_content_displayed_callback.functor) == "function") then 
			self.config.on_content_displayed_callback.functor(self.config.on_content_displayed_callback.self)
		end
	end
end

function SFXVideoTerminal:__destroy()
	npcd_ui_fx.remove_fx(self.fx.scanlines.id)
	npcd_ui_fx.remove_fx(self.fx.showing_content.id)
	npcd_ui_fx.remove_fx(self.fx.showing_display.id)
	self.display = nil
	self.content = nil
	self.glass = nil
	self.dirt = nil
end


--- UpdateHeader
--- Updates the terminal header UI element.
--- @param header CUIWindow The new header UI element to set.
--- Only use if you want to change to a new header
--- To update the content of the existing header use direct manipulation of the header element.
function SFXVideoTerminal:UpdateHeader(header)
	Printer:Debug(LOG.STOP, CAT.UI," SFXVideoTerminal: update header")
	if self.header then
		self.header:Show(false)
		self.display:AttachChild(header)
		self.header:Show(true)
		self.header = header
	end
end

